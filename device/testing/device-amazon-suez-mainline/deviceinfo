# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.

deviceinfo_format_version="0"
deviceinfo_name="Amazon Fire HD 10 (mainline)"
deviceinfo_manufacturer="Amazon"
deviceinfo_codename="amazon-suez-mainline"
deviceinfo_year="2017"
deviceinfo_arch="aarch64"
deviceinfo_dtb="mediatek/mt8173-amazon-suez"
deviceinfo_append_dtb="true"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_external_storage="true"
deviceinfo_screen_width="1200"
deviceinfo_screen_height="1920"

# The initramfs waits 10 s for /dev/fb0, twice (stage 1 and stage 2), and it
# never appears: DRM_SIMPLEDRM is a module, so fb0 only shows up once systemd
# loads it, long after the initramfs is done. There is therefore no splash to
# lose here -- just 19 s of the boot. Revisit if simpledrm is ever built in.
deviceinfo_no_framebuffer="true"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_create_initfs_extra="true"
deviceinfo_flash_offset_base="0x40078000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x05f88000"
deviceinfo_flash_offset_second="0x00e88000"
deviceinfo_flash_offset_tags="0x07f88000"
deviceinfo_flash_pagesize="2048"
# The hacked bootloader maps "boot" to the amonet payload partition, the real
# Android boot partition is "boot_x". Flashing "boot" would break amonet.
deviceinfo_flash_fastboot_partition_kernel="boot_x"
