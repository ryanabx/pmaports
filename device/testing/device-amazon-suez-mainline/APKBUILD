maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=device-amazon-suez-mainline
pkgdesc="Amazon Fire HD 10 (2017) (mainline)"
pkgver=1
pkgrel=31
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-mediatek-mt6630
	firmware-powervr-gx6250
	linux-firmware-mediatek
	linux-postmarketos-mediatek-mt8173-suez
	mkbootimg
	postmarketos-base
	postmarketos-base-ui-audio-backend-pipewire
"
makedepends="devicepkg-dev"
source="
	61-powervr-mutter-ignore.rules
	amazon-suez-gpu.service
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	pipewire-pulse.service
	suez-bcb-arm.sh
	suez-bcb-disarm
	suez-bcb-disarm.service
	suez-hardlockup.service
	suez-lid.conf
	suez-pstore-blk
	suez-pstore-blk.service
	suez-stability.conf
	suez-watchdog.conf
	ucm-HiFi.conf
	ucm-mt8173-mt6391.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Mask nftables. This kernel is deliberately built without IPv6, so
	# NF_TABLES_INET -- which selects NF_TABLES_IPV6 -- does not exist, and
	# the shipped rule set cannot load its "table inet" rules:
	#   nft add table inet t  ->  Error: Could not process rule: Not supported
	# A firewall buys little on a USB-only link, so the unit is masked here
	# rather than spending the image budget on IPv6. The mask lives in /etc
	# on purpose: /usr/lib/systemd/system/nftables.service belongs to the
	# nftables package and putting a symlink there would be a file conflict.
	install -d "$pkgdir"/etc/systemd/system
	ln -s /dev/null "$pkgdir"/etc/systemd/system/nftables.service

	# Recovery fallback: the initramfs hook arms LK's bootloader control
	# block, and the service clears it once the boot has succeeded. See the
	# comments in those files.
	install -Dm755 "$srcdir"/suez-bcb-arm.sh \
		"$pkgdir"/usr/share/mkinitfs/hooks/00-suez-bcb-arm.sh
	install -Dm755 "$srcdir"/suez-bcb-disarm \
		"$pkgdir"/usr/sbin/suez-bcb-disarm
	install -Dm644 "$srcdir"/suez-bcb-disarm.service \
		"$pkgdir"/usr/lib/systemd/system/suez-bcb-disarm.service
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../suez-bcb-disarm.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/suez-bcb-disarm.service

	# Keep mutter away from the render-only PowerVR card node; see the
	# comments in the rule file.
	install -Dm644 "$srcdir"/61-powervr-mutter-ignore.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-powervr-mutter-ignore.rules

	# Bind the GPU once boot has settled -- the unit's comments explain why
	# the late timing is load-bearing (early binding wedges the SoC).
	install -Dm644 "$srcdir"/amazon-suez-gpu.service \
		"$pkgdir"/usr/lib/systemd/system/amazon-suez-gpu.service
	install -d "$pkgdir"/usr/lib/systemd/system/graphical.target.wants
	ln -s ../amazon-suez-gpu.service \
		"$pkgdir"/usr/lib/systemd/system/graphical.target.wants/amazon-suez-gpu.service

	# ALSA UCM for the mt8173-mt6391 card. The card is DPCM and everything
	# powers up muted; without this profile the front-end PCMs cannot even
	# be opened and the desktop only sees dummy outputs. See the comments
	# in ucm-HiFi.conf. PipeWire is the audio backend on purpose: its ALSA
	# probing copes with the capture path's 48 kHz-only constraint, while
	# PulseAudio's profile prober rejects the whole card over it.
	install -Dm644 "$srcdir"/ucm-mt8173-mt6391.conf 		"$pkgdir"/usr/share/alsa/ucm2/conf.d/mt8173-mt6391/mt8173-mt6391.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf 		"$pkgdir"/usr/share/alsa/ucm2/conf.d/mt8173-mt6391/HiFi.conf

	# Keep systemd-logind from suspending when the folio cover closes; see
	# the comments in the file.
	install -Dm644 "$srcdir"/suez-lid.conf \
		"$pkgdir"/usr/lib/systemd/logind.conf.d/99-suez-lid.conf

	# The board's only persistent kernel log. ramoops cannot work here --
	# no reset preserves DRAM -- so crash records go to the eMMC instead.
	# The script explains the partition choice and why best_effort is not
	# optional.
	install -Dm755 "$srcdir"/suez-pstore-blk \
		"$pkgdir"/usr/sbin/suez-pstore-blk
	install -Dm644 "$srcdir"/suez-pstore-blk.service \
		"$pkgdir"/usr/lib/systemd/system/suez-pstore-blk.service
	install -d "$pkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../suez-pstore-blk.service \
		"$pkgdir"/usr/lib/systemd/system/sysinit.target.wants/suez-pstore-blk.service

	# Let PID 1 own the hardware watchdog; see the comments in the file.
	install -Dm644 "$srcdir"/suez-watchdog.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/99-suez-watchdog.conf

	# Panic timeout. The hard-lockup detector deliberately is NOT set here;
	# the file and suez-hardlockup.service explain why sysctl cannot arm it.
	install -Dm644 "$srcdir"/suez-stability.conf \
		"$pkgdir"/usr/lib/sysctl.d/99-suez-stability.conf

	# Arms the buddy hard-lockup detector, which sysctl silently cannot do.
	install -Dm644 "$srcdir"/suez-hardlockup.service \
		"$pkgdir"/usr/lib/systemd/system/suez-hardlockup.service
	ln -s ../suez-hardlockup.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/suez-hardlockup.service

	# Alpine's pipewire-systemd ships pipewire-pulse.socket without the
	# service it triggers, which leaves every libpulse client -- including
	# GNOME Shell and the Settings sound panel -- with "Connection refused"
	# and no audio devices at all, even though PipeWire itself is fine.
	# Installed under /etc on purpose; see the comments in the file.
	install -Dm644 "$srcdir"/pipewire-pulse.service \
		"$pkgdir"/etc/systemd/user/pipewire-pulse.service
}

