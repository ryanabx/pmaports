[Unit]
Description=Bind the PowerVR GX6250 GPU
# TIMING IS LOAD-BEARING. Binding the GPU during early boot (e.g. via
# modules-load.d at sysinit) hard-wedges the SoC within seconds, before
# the journal can flush -- verified on hardware 2026-08-30. Binding after
# the display stack is up works reliably (verified across several boots).
# Hence: anchored after graphical.target plus a settle delay.
After=graphical.target

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 30
# powervr may already be loaded by udev coldplug (its probe then failed on
# the BVNC allowlist and the deferred-probe timeout), so a modprobe with a
# parameter would be a silent no-op; set exp_hw_support via sysfs and
# re-trigger the probe explicitly instead. GX6250 (BVNC 4.40.2.51) is not
# in the driver's allowlist -- Mesa rates Series6XT partially supported.
ExecStart=/bin/sh -c 'modprobe clk-mt8173-mfgtop; modprobe powervr; echo Y > /sys/module/powervr/parameters/exp_hw_support; echo 13000000.gpu > /sys/bus/platform/drivers_probe'

[Install]
WantedBy=graphical.target
