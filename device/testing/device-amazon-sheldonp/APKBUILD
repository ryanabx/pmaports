# Reference: <https://postmarketos.org/devicepkg>
maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=device-amazon-sheldonp
pkgdesc="Amazon Fire TV Stick 3rd Gen (mainline)"
pkgver=1
pkgrel=11
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-amazon-sheldonp
	mkbootimg
	postmarketos-base
	kconfig
	py3-gobject3
	python3
"
makedepends="devicepkg-dev"
source="deviceinfo kernel-cmdline.conf unudhcpd.conf unudhcpd.confd
	usb-signaller-developer-mode.conf 61-amazon-fire-tv-remote.hwdb
	osk-on-demand.py osk-on-demand.service plasma-keyboard-lowmem.desktop
	plasmashell-lowmem.conf qtwebengine-lowend.conf rt-uclamp.conf
	powervr-bind.service powervr.conf watchdog.conf"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# The USB network on a subnet of its own, 172.16.44.x; see unudhcpd.conf.
	install -Dm644 "$srcdir"/unudhcpd.conf "$pkgdir"/etc/unudhcpd.conf
	install -Dm644 "$srcdir"/unudhcpd.confd "$pkgdir"/etc/conf.d/unudhcpd
	# The same under systemd, where usb-signaller sets the address
	install -Dm644 "$srcdir"/usb-signaller-developer-mode.conf \
		"$pkgdir"/usr/lib/systemd/system/usb-signaller-developer-mode.service.d/sheldon-address.conf
	# The Fire TV remote's Select key as Return
	install -Dm644 "$srcdir"/61-amazon-fire-tv-remote.hwdb \
		"$pkgdir"/usr/lib/udev/hwdb.d/61-amazon-fire-tv-remote.hwdb

	# GPU memory is pinned and scarce (844 MiB in all): run the on-screen
	# keyboard only while a text field wants it, with a small Qt atlas.
	install -Dm755 "$srcdir"/osk-on-demand.py "$pkgdir"/usr/bin/osk-on-demand
	install -Dm644 "$srcdir"/osk-on-demand.service \
		"$pkgdir"/usr/lib/systemd/user/osk-on-demand.service
	mkdir -p "$pkgdir"/usr/lib/systemd/user/plasma-workspace.target.wants
	ln -s ../osk-on-demand.service \
		"$pkgdir"/usr/lib/systemd/user/plasma-workspace.target.wants/osk-on-demand.service
	install -Dm644 "$srcdir"/plasma-keyboard-lowmem.desktop \
		"$pkgdir"/usr/share/applications/plasma-keyboard-lowmem.desktop
	# plasmashell without a depth/stencil buffer and with a 1024x1024
	# atlas: 103 -> 78 MiB of GPU memory (see the file).
	install -Dm644 "$srcdir"/plasmashell-lowmem.conf \
		"$pkgdir"/usr/lib/systemd/user/plasma-plasmashell.service.d/lowmem.conf
	# QtWebEngine apps in Chromium's low-end mode (see the file).
	install -Dm644 "$srcdir"/qtwebengine-lowend.conf \
		"$pkgdir"/usr/lib/environment.d/60-qtwebengine-lowend.conf
	# RT tasks without the top-OPP boost (see the file).
	install -Dm644 "$srcdir"/rt-uclamp.conf \
		"$pkgdir"/usr/lib/sysctl.d/60-sheldonp-rt-uclamp.conf
	# The GPU: exp_hw_support for powervr, as a module option and, for
	# kernels with the driver built in, a oneshot that sets it and probes.
	install -Dm644 "$srcdir"/powervr.conf \
		"$pkgdir"/usr/lib/modprobe.d/powervr-sheldonp.conf
	install -Dm644 "$srcdir"/powervr-bind.service \
		"$pkgdir"/usr/lib/systemd/system/powervr-bind.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../powervr-bind.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/powervr-bind.service
	# systemd feeds the hardware watchdog (see the file).
	install -Dm644 "$srcdir"/watchdog.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/60-sheldonp-watchdog.conf
	# xwaylandvideobridge (screen sharing for X11 apps; there are none here)
	# kept Xwayland running at ~120 MiB of GPU memory plus its own 51 MiB:
	# mask its autostart unit. Undo: rm this link.
	mkdir -p "$pkgdir"/etc/systemd/user
	ln -s /dev/null \
		"$pkgdir"/etc/systemd/user/app-org.kde.xwaylandvideobridge@autostart.service
}
