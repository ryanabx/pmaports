# Reference: <https://postmarketos.org/devicepkg>
maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=device-amazon-sheldonp
pkgdesc="Amazon Fire TV Stick 3rd Gen (mainline)"
pkgver=1
pkgrel=5
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-amazon-sheldonp
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
source="deviceinfo kernel-cmdline.conf unudhcpd.conf unudhcpd.confd
	usb-signaller-developer-mode.conf 61-amazon-fire-tv-remote.hwdb"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# The USB network on a subnet of its own, 172.16.44.x; see unudhcpd.conf.
	install -Dm644 "$srcdir"/unudhcpd.conf "$pkgdir"/etc/unudhcpd.conf
	install -Dm644 "$srcdir"/unudhcpd.confd "$pkgdir"/etc/conf.d/unudhcpd
	# The same under systemd, where usb-signaller sets the address
	install -Dm644 "$srcdir"/usb-signaller-developer-mode.conf \
		"$pkgdir"/usr/lib/systemd/system/usb-signaller-developer-mode.service.d/sheldon-address.conf
	# The Fire TV remote's Select and Back keys
	install -Dm644 "$srcdir"/61-amazon-fire-tv-remote.hwdb \
		"$pkgdir"/usr/lib/udev/hwdb.d/61-amazon-fire-tv-remote.hwdb
}
