# Amazon Fire TV remote (Bluetooth LE HID, advertises as "AR"; Amazon's
# vendor ID 0x0171, product 0x0421). Select sends keypad Enter and Back the
# keyboard page's Back usage (0xf1); Plasma Bigscreen activates on Return
# and goes back on Escape, as its own HDMI-CEC mapping does.
evdev:input:b0005v0171p0421*
 KEYBOARD_KEY_70058=enter
 KEYBOARD_KEY_700f1=esc
