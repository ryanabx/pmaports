# Amazon Fire TV remote (Bluetooth LE HID, advertises as "AR"; Amazon's
# vendor ID 0x0171, product 0x0421). Select sends keypad Enter; Plasma
# Bigscreen's buttons and settings controls only take Return until its
# Enter fix is released, so map it to Return here. Back (the keyboard
# page's 0xf1, KEY_BACK) is left alone: Bigscreen handles KEY_BACK.
evdev:input:b0005v0171p0421*
 KEYBOARD_KEY_70058=enter
