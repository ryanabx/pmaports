# Kernel config based on: arm64 defconfig with the bring-up fragments of
# the sheldonp work repo (configs/mainline-arm{32,64}-bringup.config)
maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=linux-amazon-sheldonp
pkgver=7.3
pkgrel=0
pkgdesc="Amazon Fire TV Stick 3rd Gen mainline kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="${pkgname#linux-}"
url="https://kernel.org"
license="GPL-2.0-only AND 0BSD"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bison
	clang
	dtc
	elfutils-dev
	findutils
	flex
	linux-firmware-mediatek
	linux-headers
	lld
	llvm
	openssl-dev
	perl
	python3
	wireless-regdb
	xz
	zstd
"

# There is no release tarball: build from the device branch with
# pmbootstrap build --src (ryanabx/devices/amazon-sheldon, on v7.3).
_config="config-$_flavor.$arch"
_tramp="
	trampoline64xz.S
	trampoline64xz.lds
	xzboot.c
	dtbfix.c
	xz_config.h
	xz_crc32.c
	xz_dec_bcj.c
	xz_dec_lzma2.c
	xz_dec_stream.c
	xz.h
	xz_lzma2.h
	xz_private.h
	xz_stream.h
	shim-stdlib.h
	shim-string.h
"
source="$_config $_tramp"
builddir="$srcdir/linux-$pkgver"

# The Wi-Fi/Bluetooth drivers are built in and load their firmware at
# probe time, before any root file system: CONFIG_EXTRA_FIRMWARE embeds it.
_firmware="
	mediatek/mt7663pr2h.bin
	mediatek/mt7663_n9_v3.bin
	mediatek/mt7663pr2h_rebb.bin
	mediatek/mt7663_n9_rebb.bin
	regulatory.db
	regulatory.db.p7s
"

# LK keeps only about the first 120 characters of the boot image's command
# line, which cuts pmos_root_uuid short. The trampoline appends these from
# the DTB, after LK's: the empty UUIDs make the initramfs find the
# partitions by label instead. The watchdog stays armed (the trampoline
# arms it, the kernel feeds it), and stalls panic, so failed boots reset.
_bootargs="console=ttyS0,921600n8 console=tty0 ignore_loglevel panic=5
	watchdog.handle_boot_enabled=1 oops=panic
	sysctl.kernel.panic_on_rcu_stall=1
	pmos_boot_uuid= pmos_root_uuid= pmos_rootfsopts=defaults"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
	make ARCH="$_carch" LLVM=1 olddefconfig

	local f dir
	for f in $_firmware; do
		mkdir -p "firmware-embed/$(dirname "$f")"
		for dir in /usr/lib/firmware /lib/firmware; do
			if [ -f "$dir/$f.zst" ]; then
				zstd -dcq "$dir/$f.zst" > "firmware-embed/$f"
			elif [ -f "$dir/$f.xz" ]; then
				xz -dc "$dir/$f.xz" > "firmware-embed/$f"
			elif [ -f "$dir/$f" ]; then
				cp "$dir/$f" "firmware-embed/$f"
			else
				continue
			fi
			break
		done
		[ -s "firmware-embed/$f" ] || die "firmware $f not found"
	done

	mkdir -p "$srcdir"/tramp/shim
	cp "$srcdir"/shim-stdlib.h "$srcdir"/tramp/shim/stdlib.h
	cp "$srcdir"/shim-string.h "$srcdir"/tramp/shim/string.h
}

# LK starts the kernel as a 32-bit zImage at 0x40008000. The trampoline
# (from the sheldonp work repo, tools/kexec-probe) switches to AArch64
# through ATF and starts the Image, which it carries XZ-compressed so that
# it fits the 16 MiB boot partition with the initramfs.
_build_trampoline() {
	local t="$srcdir"/tramp
	local libfdt="$builddir"/scripts/dtc/libfdt
	local cflags="--target=armv7a-none-eabi -marm -march=armv7-a
		-mfloat-abi=soft -mfpu=none -ffreestanding -fno-builtin -nostdinc
		-isystem $(clang -print-resource-dir)/include -Os -fno-pic
		-fno-stack-protector -fno-unwind-tables
		-fno-asynchronous-unwind-tables -DXZ_DEC_SINGLE -DXZ_DEC_ARM64
		-I $t/shim -I $srcdir -I $libfdt"
	local src objs=""

	xz -c -T0 --check=crc32 --arm64 --lzma2=preset=9e,dict=32MiB \
		arch/arm64/boot/Image > "$t"/Image.xz
	for src in "$srcdir"/xzboot.c "$srcdir"/dtbfix.c \
		"$srcdir"/xz_crc32.c "$srcdir"/xz_dec_stream.c \
		"$srcdir"/xz_dec_lzma2.c "$srcdir"/xz_dec_bcj.c \
		"$libfdt"/fdt.c "$libfdt"/fdt_ro.c "$libfdt"/fdt_rw.c \
		"$libfdt"/fdt_wip.c; do
		# shellcheck disable=SC2086
		clang $cflags -c "$src" -o "$t/$(basename "$src" .c).o"
		objs="$objs $t/$(basename "$src" .c).o"
	done
	clang --target=armv7a-none-eabi -marm -DPAYLOAD="\"$t/Image.xz\"" \
		-c "$srcdir"/trampoline64xz.S -o "$t"/trampxz.o
	# shellcheck disable=SC2086
	ld.lld -T "$srcdir"/trampoline64xz.lds "$t"/trampxz.o $objs \
		-o "$t"/trampxz.elf
	llvm-objcopy -O binary "$t"/trampxz.elf "$t"/zImage
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
	_build_trampoline
}

package() {
	mkdir -p "$pkgdir"/boot
	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$srcdir"/tramp/zImage "$pkgdir"/boot/vmlinuz
	# shellcheck disable=SC2086
	fdtput -t s "$pkgdir"/boot/dtbs/mediatek/mt8695-amazon-sheldonp.dtb \
		/chosen sheldon,bootargs-append "$(echo $_bootargs)"

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}
