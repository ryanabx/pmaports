# Reference: <https://postmarketos.org/devicepkg>
maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=device-amazon-suez
pkgdesc="Amazon Fire HD 10 (2017)"
pkgver=5
pkgrel=10
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	bluez-btmgmt
	firmware-mediatek-mt6630
	firmware-powervr-gx6250
	linux-firmware-mediatek
	linux-postmarketos-mediatek-mt8173-suez
	postmarketos-base
	postmarketos-base-ui-audio-backend-pipewire
"
makedepends="devicepkg-dev"
# Mesa's PowerVR Vulkan driver, as a separate package pulled in automatically
# when this device package and vulkan-loader are both installed -- the same
# shape device-qcom-qcs6490 and friends use. It is not in depends= because a
# device package should not force a Vulkan stack onto an image that has no
# use for one; install_if means an image that already has vulkan-loader (any
# of the UIs do) gets the driver, and a minimal one does not.
subpackages="
	$pkgname-vulkan
"
install="
	$pkgname.post-install
	$pkgname.post-upgrade
	"
source="
	50-powervr-vulkan.conf
	51-gtk-renderer.conf
	61-powervr-drm-ignore.rules
	90-suez-gauge-capacity.rules
	90-suez-mt6630-addr.rules
	99-suez-charge-voltage.rules
	amazon-suez-gpu.service
	deviceinfo
	modules-initfs
	pipewire-pulse.service
	suez-boot-deadline.conf
	suez-boot-ok
	suez-boot-ok.service
	suez-charger-limit
	suez-charger-limit.service
	suez-gauge-capacity
	suez-hardlockup.service
	suez-mt6630-addr
	suez-mt6630-bdaddr@.service
	suez-gtk-renderer.conf
	suez-powervr-vulkan.conf
	suez-pstore-keep
	suez-pstore-keep.conf
	suez-stability.conf
	suez-usb-developer-mode
	suez-usb-developer-mode.conf
	suez-watchdog.conf
	ucm-HiFi.conf
	ucm-mt8173-mt6391.conf
	unudhcpd.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Mask nftables. This kernel is deliberately built without IPv6, so
	# NF_TABLES_INET -- which selects NF_TABLES_IPV6 -- does not exist, and
	# the shipped rule set cannot load its "table inet" rules:
	#   nft add table inet t  ->  Error: Could not process rule: Not supported
	# A firewall buys little on a USB-only link, so the unit is masked here
	# rather than spending the image budget on IPv6. The mask lives in /etc
	# on purpose: /usr/lib/systemd/system/nftables.service belongs to the
	# nftables package and putting a symlink there would be a file conflict.
	install -d "$pkgdir"/etc/systemd/system
	ln -s /dev/null "$pkgdir"/etc/systemd/system/nftables.service

	# ALSA UCM for the mt8173-mt6391 card. The card is DPCM and everything
	# powers up muted; without this profile the front-end PCMs cannot even
	# be opened and the desktop only sees dummy outputs. See the comments
	# in ucm-HiFi.conf. PipeWire is the audio backend on purpose: its ALSA
	# probing copes with the capture path's 48 kHz-only constraint, while
	# PulseAudio's profile prober rejects the whole card over it.
	install -Dm644 "$srcdir"/ucm-mt8173-mt6391.conf 		"$pkgdir"/usr/share/alsa/ucm2/conf.d/mt8173-mt6391/mt8173-mt6391.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf 		"$pkgdir"/usr/share/alsa/ucm2/conf.d/mt8173-mt6391/HiFi.conf

	# Set the charger's input current limit from the USB gadget state --
	# nothing else on this board can classify the supply. See the script.
	install -Dm755 "$srcdir"/suez-charger-limit \
		"$pkgdir"/usr/sbin/suez-charger-limit
	install -Dm644 "$srcdir"/suez-charger-limit.service \
		"$pkgdir"/usr/lib/systemd/system/suez-charger-limit.service
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../suez-charger-limit.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/suez-charger-limit.service

	# Charge the battery to its rated voltage rather than the charger
	# chip's default; the rule file explains why this is not done in DT.
	install -Dm644 "$srcdir"/99-suez-charge-voltage.rules \
		"$pkgdir"/usr/lib/udev/rules.d/99-suez-charge-voltage.rules

	# The fuel gauge's learned capacity, which the PMIC cannot keep across a
	# reboot; see the script.
	install -Dm755 "$srcdir"/suez-gauge-capacity \
		"$pkgdir"/usr/sbin/suez-gauge-capacity
	install -Dm644 "$srcdir"/90-suez-gauge-capacity.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-suez-gauge-capacity.rules

	# The MT6630's factory Wi-Fi and Bluetooth addresses, which the mainline
	# drivers leave to userspace; see the script.
	install -Dm755 "$srcdir"/suez-mt6630-addr \
		"$pkgdir"/usr/sbin/suez-mt6630-addr
	install -Dm644 "$srcdir"/90-suez-mt6630-addr.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-suez-mt6630-addr.rules
	install -Dm644 "$srcdir"/suez-mt6630-bdaddr@.service \
		"$pkgdir"/usr/lib/systemd/system/suez-mt6630-bdaddr@.service

	# Keep compositors away from the render-only PowerVR card node; see the
	# comments in the rule file, including what it does not cover.
	install -Dm644 "$srcdir"/61-powervr-drm-ignore.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-powervr-drm-ignore.rules

	# Bind the GPU after multi-user.target and before the display manager,
	# so the compositor finds the render node and composites on it. The
	# unit's comments explain why the timing is load-bearing in both
	# directions (sysinit wedges the SoC; after the shell means llvmpipe).
	install -Dm644 "$srcdir"/amazon-suez-gpu.service \
		"$pkgdir"/usr/lib/systemd/system/amazon-suez-gpu.service
	install -d "$pkgdir"/usr/lib/systemd/system/graphical.target.wants
	ln -s ../amazon-suez-gpu.service \
		"$pkgdir"/usr/lib/systemd/system/graphical.target.wants/amazon-suez-gpu.service

	# Let Mesa's PowerVR Vulkan driver accept the GX6250; without it the
	# desktop is on llvmpipe. THREE placements, because a compositor can be
	# started three ways and each takes its environment from somewhere
	# different: a systemd user unit (GNOME; Plasma under
	# plasma-workspace-wayland.target) reads environment.d, a systemd system
	# service (plasma-mobile.service, gdm, sddm) reads DefaultEnvironment=,
	# and greetd -- which is how phosh starts -- reads neither, because it
	# rebuilds the session environment from PAM. The third one is appended
	# to /etc/environment by $pkgname.post-install; see that script for the
	# measurement. Keep the value in sync across all three.
	install -Dm644 "$srcdir"/50-powervr-vulkan.conf \
		"$pkgdir"/usr/lib/environment.d/50-powervr-vulkan.conf
	install -Dm644 "$srcdir"/suez-powervr-vulkan.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/50-powervr-vulkan.conf

	# GTK 4 apps render with cairo: they start 4-6x faster than on GSK's GPU
	# renderers here. The same three placements as the variable above, for
	# the same reasons; 51-gtk-renderer.conf has the measurement.
	install -Dm644 "$srcdir"/51-gtk-renderer.conf \
		"$pkgdir"/usr/lib/environment.d/51-gtk-renderer.conf
	install -Dm644 "$srcdir"/suez-gtk-renderer.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/51-gtk-renderer.conf

	# SUSPEND POLICY
	#
	# Suspend-to-RAM works on this board and every known blocker is fixed and
	# measured, so nothing here blocks it any more. The history matters,
	# because for a long time three files in this package existed only to
	# prevent suspend, and they were removed one condition at a time:
	#
	#   * no suspend state at all -- the firmware is PSCI 0.2 and
	#     SYSTEM_SUSPEND is PSCI 1.0. Fixed by the SPM suspend driver in
	#     kernel 7.2.2; /sys/power/mem_sleep now reads "s2idle [deep]".
	#   * mtk_vpu aborted every attempt with -EIO. Fixed by disabling the VPU
	#     and its four consumers in the board dts (7.2.2-r12).
	#   * a successful suspend killed the MT6630 until reboot, for want of PM
	#     ops on its two SDIO functions. Fixed in 7.2.2-r14
	#     (MMC_PM_KEEP_POWER + keep-power-in-suspend).
	#   * the GPU wedged after a resume, and could hang the suspend outright.
	#     Fixed in 7.2.2-r20 -- mfgtop's genpd power_on was calling the clk
	#     API on a gate its own device provides, which is -EACCES at _noirq.
	#
	# Verified on hardware after all of that: the power key wakes the board
	# from a real suspend ("woke by EINT, raw_sta = 0x40" after 11.2 s, with
	# the RTC backstop at 90 s and the SPM timer at 200 s, so nothing else
	# could have done it), the panel comes back, and Wi-Fi, Bluetooth and the
	# GPU all survive.
	#
	# So the lid, the power key and the idle timeout are all left at their
	# upstream defaults now -- suspend on close, suspend on tap, and the
	# session's own idle handling -- which is why 99-suez-lid.conf and
	# 99-suez-no-idle-suspend.conf are gone, and why the power-button-action
	# override is gone (GNOME and Plasma both default it to 'suspend', as
	# does logind's own HandlePowerKey=, so the behaviour does not depend on
	# which desktop is installed).
	#
	# HIBERNATION STAYS MASKED, and that is not a matter of taste. The only
	# swap on this device is 2.6 GB of zram, and there is no resume= on the
	# kernel cmdline, so there is nowhere to write a hibernation image and no
	# way to find it again. /sys/power/disk offers only "[shutdown] reboot
	# suspend test_resume". An unmasked hibernate.target would hand users an
	# action that cannot work.
	#
	# Masking belongs in /etc/systemd/system, NOT /usr/lib/systemd/system,
	# because systemd's own package owns the unit files there and shipping
	# symlinks over them is a file conflict. Same idiom as the
	# nftables.service mask below.
	#
	# If you ever need to block system sleep again, mask the targets -- do not
	# reach for logind's SleepOperation=. It looks like exactly the right knob
	# and it is a real key, but on systemd 261.2 an empty SleepOperation= does
	# NOT gate suspend: r35 shipped that and CanSuspend still answered "yes".
	# Verify any change with, and only with:
	#   busctl call org.freedesktop.login1 /org/freedesktop/login1 \
	#          org.freedesktop.login1.Manager CanSuspend
	# Running systemctl suspend over SSH proves nothing, because sshd holds
	# a block inhibitor ("Active PAM session") and the call is refused for that
	# reason instead.
	install -d "$pkgdir"/etc/systemd/system
	for _t in hibernate.target hybrid-sleep.target suspend-then-hibernate.target; do
		ln -sf /dev/null "$pkgdir"/etc/systemd/system/"$_t"
	done

	# Count a boot as good once it reaches multi-user.target, for U-Boot,
	# which stays in fastboot after three that were not; and reboot one that
	# does not get there in five minutes, so that it is counted. See the
	# script and the drop-in.
	install -Dm755 "$srcdir"/suez-boot-ok \
		"$pkgdir"/usr/sbin/suez-boot-ok
	install -Dm644 "$srcdir"/suez-boot-ok.service \
		"$pkgdir"/usr/lib/systemd/system/suez-boot-ok.service
	ln -s ../suez-boot-ok.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/suez-boot-ok.service
	install -Dm644 "$srcdir"/suez-boot-deadline.conf \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.d/50-suez-boot-deadline.conf

	# Keep every boot's ramoops records, not just the last; see the script.
	install -Dm755 "$srcdir"/suez-pstore-keep \
		"$pkgdir"/usr/sbin/suez-pstore-keep
	install -Dm644 "$srcdir"/suez-pstore-keep.conf \
		"$pkgdir"/usr/lib/systemd/system/systemd-pstore.service.d/50-suez-pstore-keep.conf

	# The USB network on a subnet of its own, 172.16.43.x, so that suez and
	# other postmarketOS devices can share a host; see unudhcpd.conf. The
	# initramfs and unudhcpd read the file, and usb-signaller's developer
	# mode is run through suez-usb-developer-mode until it does too.
	install -Dm644 "$srcdir"/unudhcpd.conf "$pkgdir"/etc/unudhcpd.conf
	install -Dm755 "$srcdir"/suez-usb-developer-mode \
		"$pkgdir"/usr/sbin/suez-usb-developer-mode
	install -Dm644 "$srcdir"/suez-usb-developer-mode.conf \
		"$pkgdir"/usr/lib/systemd/system/usb-signaller-developer-mode.service.d/50-suez-address.conf

	# Let PID 1 own the hardware watchdog; see the comments in the file.
	install -Dm644 "$srcdir"/suez-watchdog.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/99-suez-watchdog.conf

	# Panic timeout. The hard-lockup detector deliberately is NOT set here;
	# the file and suez-hardlockup.service explain why sysctl cannot arm it.
	install -Dm644 "$srcdir"/suez-stability.conf \
		"$pkgdir"/usr/lib/sysctl.d/99-suez-stability.conf

	# Arms the buddy hard-lockup detector, which sysctl silently cannot do.
	install -Dm644 "$srcdir"/suez-hardlockup.service \
		"$pkgdir"/usr/lib/systemd/system/suez-hardlockup.service
	ln -s ../suez-hardlockup.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/suez-hardlockup.service

	# Alpine's pipewire-systemd ships pipewire-pulse.socket without the
	# service it triggers, which leaves every libpulse client -- the
	# desktop's own sound panel included -- with "Connection refused" and no
	# audio devices at all, even though PipeWire itself is fine.
	# Installed under /etc on purpose; see the comments in the file.
	install -Dm644 "$srcdir"/pipewire-pulse.service \
		"$pkgdir"/etc/systemd/user/pipewire-pulse.service
}

vulkan() {
	pkgdesc="Vulkan support for the PowerVR GX6250"
	install_if="$pkgname=$pkgver-r$pkgrel vulkan-loader"
	depends="mesa-vulkan-imagination"

	mkdir "$subpkgdir"
}

