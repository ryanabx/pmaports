#!/bin/sh
# Bring up pstore/blk, the only persistent kernel log this board has.
#
# ramoops was tried first and does not work here: no reset the SoC can
# perform preserves DRAM. That was settled by experiment on 2026-08-31 -- a
# deliberate sysrq-c panic, rescued 76 s later by the 31 s hardware watchdog,
# came back with /sys/fs/pstore completely empty even though the ramoops
# region was registered and carrying the console. So a crash log has to land
# on the eMMC, which is what pstore/blk does.
#
# Backing store is an 8 MiB window, 1 MiB into the "metadata" partition,
# behind a loop device. It used to be the whole of "reserved", which looked
# unused and is not: a boot chain can load LK from it. "metadata" was
# all-zero in the 2026-09-15 eMMC dump. Three things here are load-bearing:
#
#   * pstore/blk claims the WHOLE block device and kvzalloc()s a RAM buffer
#     for every zone it carves out of it, so the device size IS the
#     driver's permanent memory cost. The loop's --sizelimit is what keeps
#     that at 8 MiB; "metadata" itself is 39.5 MiB.
#   * best_effort=1 is mandatory, not a tuning knob. Without it pstore/blk
#     refuses to register unless the block driver exports a panic_write hook,
#     and mtk-msdc does not.
#   * The window is only ever written if it is ours: either the first sector
#     of the partition carries $MAGIC, or the whole of [0, OFF + SIZE) is
#     zero, in which case the marker is written first. Anything else means
#     someone else is using the partition, and this refuses.
#
# The partition is resolved by PARTLABEL and never by a hardcoded mmcblkNpM:
# enabling an mmc controller renumbers the eMMC (that already broke flashing
# once on this device), and a stale node number here would mean writing the
# crash log over somebody else's data.
set -e

LABEL=metadata
OFF=1048576
SIZE=8388608
MAGIC="suez-pstore-blk v1"

part=
for node in /dev/mmcblk*p*; do
	[ -b "$node" ] || continue
	[ "$(blkid -s PARTLABEL -o value "$node" 2>/dev/null)" = "$LABEL" ] || continue
	part="$node"
	break
done

if [ -z "$part" ]; then
	echo "suez-pstore-blk: no PARTLABEL=$LABEL partition found" >&2
	exit 1
fi

# Refuse to scribble on anything that is in use. A mounted filesystem would
# fail pstore/blk's O_EXCL open on the partition, but not on a loop over it.
if grep -q "^$part " /proc/mounts; then
	echo "suez-pstore-blk: $part is mounted, refusing" >&2
	exit 1
fi

if [ "$(head -c ${#MAGIC} "$part")" != "$MAGIC" ]; then
	if ! cmp -s -n $((OFF + SIZE)) "$part" /dev/zero; then
		echo "suez-pstore-blk: $part has no marker and is not empty, refusing" >&2
		exit 1
	fi
	printf '%s' "$MAGIC" | dd of="$part" bs=512 count=1 conv=sync,notrunc 2>/dev/null
	sync
	if [ "$(head -c ${#MAGIC} "$part")" != "$MAGIC" ]; then
		echo "suez-pstore-blk: marker did not read back on $part" >&2
		exit 1
	fi
	echo "suez-pstore-blk: claimed an empty $part"
fi

# Direct I/O, so a record does not wait in the partition's page cache as
# well as the loop's.
loop=$(losetup --find --show --direct-io=on \
	--offset "$OFF" --sizelimit "$SIZE" "$part")

modprobe pstore_blk \
	best_effort=1 \
	blkdev="$loop" \
	kmsg_size=256 \
	console_size=1024 \
	pmsg_size=64 \
	ftrace_size=64 \
	max_reason=4
