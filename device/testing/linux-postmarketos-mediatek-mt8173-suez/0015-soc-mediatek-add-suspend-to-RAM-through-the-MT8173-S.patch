From d8714bf6545a5cccee238782f896e975fcf2bc6a Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Thu, 3 Sep 2026 14:09:45 -0500
Subject: [PATCH] soc: mediatek: add suspend-to-RAM through the MT8173 SPM

MT8173 boards that ship ARM Trusted Firmware suspend through PSCI: BL31
implements SYSTEM_SUSPEND and programs the System Power Manager at EL3.
Amazon's Fire HD 10 (2017) firmware is PSCI 0.2, which predates
SYSTEM_SUSPEND, so psci_init_system_suspend() never installs
platform_suspend_ops and /sys/power/mem_sleep offers only s2idle. The
firmware on a shipped consumer device cannot be replaced, and there is
nothing to fix in the PSCI code.

The vendor kernel does not use PSCI for suspend either; it drives the SPM
from the kernel (drivers/misc/mediatek/base/power/mt8173/{mt_sleep,mt_spm,
mt_spm_internal,mt_spm_sleep}.c). This driver is that path, reduced to the
one scenario it needs and rewritten against mainline infrastructure: the
SPM is a small sequencer ("PCM") with its own instruction memory; the kernel
points it at a firmware image in DRAM, kicks its instruction fetcher,
programs the wake-source mask and the idle conditions, and parks the CPU in
WFI. The PCM firmware waits for every CPU's STANDBYWFI, puts DRAM into
self-refresh, drops VCORE, gates the 26 MHz clock, and reverses all of it
on a wake event. The image carried here is the vendor's
pcm_suspend_20150805_V1 (suspend_binary_ca7[] in its GPL-2.0
mt_spm_sleep.c), byte for byte; it is sequencer microcode for which no
assembler source exists.

What this driver deliberately does not do is power the CPU down. The
vendor's default path needs its cpu_dormant.S, MTCMOS cluster teardown and
a firmware re-entry path, none of which mainline has for this SoC. But the
vendor's spm_trigger_wfi_for_sleep() has a second branch, taken when
SPM_CPU_PDN_DIS is set, that is only ACINACTM plus a plain WFI: the CPU
keeps its state and its rail, and everything outside the CPU still
suspends. That branch is what this implements, so SPM_CPU_PDN_DIS and
SPM_INFRA_PDN_DIS (which the vendor requires whenever the CPU stays on) are
added to the vendor's suspend flags. Three consequences follow and are all
measured on hardware:

 - Both clusters must report STANDBYWFIL2 before the SPM starts, and a
   powered cluster only does so with ACINACTM asserted. The vendor asserts
   it for the A53 cluster only (MP0_AXI_CONFIG bit 4) because its A72
   cluster is already powered down; here the A72's bit, CA15L_MISCDBG bit 0,
   is asserted too. Without it the SPM never sees its sleep condition and
   "suspend" returns immediately with nothing powered down, which looks
   exactly like a working suspend from userspace, so the wake path warns
   when the PCM did not complete the sequence.

 - The PCM timer cannot wake the board: its expiry sets the wake flag but a
   CPU parked in WFI is only woken by a GIC interrupt, and the vendor's
   periodic wake relies on the CPU re-entering through its reset vector.
   The timer is therefore pinned at PCM_TIMER_MAX, as the vendor does when
   it is unused, and the PCM watchdog armed behind it can never fire first.
   Wake sources are the EINT-routed ones (power key, RTC, charger) plus the
   keypad block, so the volume keys wake a tablet too.

 - The MT6397 hold bits for VCA15, VSRMCA15 and VCORE are cleared before
   the sleep, as the vendor does on this branch, so those rails do not
   follow SRCLKEN down while the CPU stays powered; they are restored on
   wake.

Everything else (register offsets, PCM_CON0/1 sequences, event vectors,
AP_STANBY_CON, WFI enables, wake-source mask, ISR handling, the fscp_ck
reparent to the crystal) follows the vendor register for register.

Tested on the Amazon Fire HD 10 (2017): repeated suspend-to-RAM cycles of
60 s and longer, woken by the RTC and by the power key, with the display,
GPU, Wi-Fi and Bluetooth all surviving; the board draws about 35 mA asleep.

Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 drivers/soc/mediatek/Kconfig           |   15 +
 drivers/soc/mediatek/Makefile          |    1 +
 drivers/soc/mediatek/mtk-spm-suspend.c | 1012 ++++++++++++++++++++++++
 3 files changed, 1028 insertions(+)
 create mode 100644 drivers/soc/mediatek/mtk-spm-suspend.c

diff --git a/drivers/soc/mediatek/Kconfig b/drivers/soc/mediatek/Kconfig
index d7293977f..f4dfe7956 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -79,6 +79,21 @@ config MTK_SVS
 	  chip process corner, temperatures and other factors. Then DVFS
 	  driver could apply SVS bank voltage to PMIC/Buck.
 
+config MTK_SPM_SUSPEND
+	tristate "MediaTek MT8173 SPM suspend-to-RAM"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on SUSPEND && MFD_SYSCON
+	help
+	  Suspend-to-RAM driven by the MT8173 System Power Manager, for boards
+	  whose firmware is older than PSCI 1.0 and therefore cannot offer
+	  SYSTEM_SUSPEND. On those the kernel has no platform_suspend_ops and
+	  /sys/power/mem_sleep offers only s2idle.
+
+	  Boards that ship ARM Trusted Firmware do not need this -- BL31 does
+	  the same work at EL3 -- and should not enable it.
+
+	  If unsure, say N.
+
 config MTK_SOCINFO
 	tristate "MediaTek SoC Information"
 	default y
diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
index ed3810388..3bddd67d8 100644
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -10,3 +10,4 @@ obj-$(CONFIG_MTK_MMSYS) += mt8173-disp-handover.o
 obj-$(CONFIG_MTK_MMSYS) += mtk-mutex.o
 obj-$(CONFIG_MTK_SVS) += mtk-svs.o
 obj-$(CONFIG_MTK_SOCINFO) += mtk-socinfo.o
+obj-$(CONFIG_MTK_SPM_SUSPEND) += mtk-spm-suspend.o
diff --git a/drivers/soc/mediatek/mtk-spm-suspend.c b/drivers/soc/mediatek/mtk-spm-suspend.c
new file mode 100644
index 000000000..b089fea98
--- /dev/null
+++ b/drivers/soc/mediatek/mtk-spm-suspend.c
@@ -0,0 +1,1012 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT8173 System Power Manager -- suspend to RAM.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2026 Ryan Brue
+ *
+ * MT8173 boards that ship ARM Trusted Firmware suspend through PSCI: BL31
+ * implements SYSTEM_SUSPEND and does the SPM programming at EL3. Amazon's
+ * firmware is PSCI 0.2, which predates SYSTEM_SUSPEND, so
+ * psci_init_system_suspend() never calls suspend_set_ops() and
+ * /sys/power/mem_sleep offers only [s2idle]. There is nothing to fix in PSCI
+ * from here, and the firmware is not replaceable on a locked device.
+ *
+ * The vendor kernel does not use PSCI for suspend either. It drives the SPM
+ * itself, from drivers/misc/mediatek/base/power/mt8173/{mt_sleep,mt_spm,
+ * mt_spm_internal,mt_spm_sleep}.c. This driver is that path, reduced to the
+ * single scenario it needs and rewritten against mainline infrastructure.
+ *
+ * How the SPM works: it is a small sequencer ("PCM") with its own instruction
+ * memory. The kernel points it at a firmware image in DRAM, kicks its
+ * instruction fetcher, programs the wakeup mask and the conditions under which
+ * the SoC may go down, and then parks the CPU. The PCM firmware -- the 847
+ * words of spm_suspend_pcm[] below, carried from the vendor kernel under its
+ * GPL-2.0 licence -- does the rest in hardware: it waits for every CPU's
+ * STANDBYWFI, puts DRAM into self-refresh, drops VCORE, gates the 26 MHz
+ * clock, and reverses all of it on a wakeup event before releasing the
+ * CPU. The CPU sees an ordinary WFI that took a long time to return.
+ *
+ * WHAT THIS DRIVER DOES NOT DO
+ *
+ * The vendor's default is to power the CPU down across suspend, which needs
+ * its cpu_dormant.S and mt_cpuidle.c -- context save/restore, MTCMOS cluster
+ * teardown and a firmware re-entry path, none of which mainline has for this
+ * SoC. But spm_trigger_wfi_for_sleep() has a second branch, taken when
+ * SPM_CPU_PDN_DIS is set, that is only ACINACTM plus a plain WFI. The CPU
+ * keeps its state and its rail; everything outside the CPU still suspends.
+ * That branch is what this driver implements. It saves less power than the
+ * vendor's default and needs roughly a tenth of the code.
+ *
+ * SPM_INFRA_PDN_DIS comes along for the ride: slp_suspend_ops_enter() refuses
+ * outright to power infra down while the CPU stays on, so keeping the CPU
+ * means keeping infra, which in turn means the UART save/restore dance in the
+ * vendor code is unnecessary here.
+ */
+
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/mfd/mt6397/core.h>
+#include <linux/mfd/mt6397/registers.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/suspend.h>
+
+/* SPM registers, offsets within the scpsys block at 0x10006000. */
+#define SPM_POWERON_CONFIG_SET		0x000
+#define SPM_POWER_ON_VAL0		0x010
+#define SPM_POWER_ON_VAL1		0x014
+#define SPM_CLK_SETTLE			0x100
+#define SPM_PCM_CON0			0x310
+#define SPM_PCM_CON1			0x314
+#define SPM_PCM_IM_PTR			0x318
+#define SPM_PCM_IM_LEN			0x31c
+#define SPM_PCM_REG_DATA_INI		0x320
+/* Vectors 0-3 and 4-7 are not contiguous: 0x340-0x34c, then 0x3d0-0x3dc. */
+#define SPM_PCM_EVENT_VECTOR(n)		((n) < 4 ? 0x340 + 4 * (n) : 0x3d0 + 4 * ((n) - 4))
+#define SPM_PCM_MAS_PAUSE_MASK		0x354
+#define SPM_PCM_PWR_IO_EN		0x358
+#define SPM_PCM_TIMER_VAL		0x35c
+#define SPM_PCM_TIMER_OUT		0x360
+#define SPM_PCM_REG12_DATA		0x3b0
+#define SPM_PCM_REG13_DATA		0x3b4
+#define SPM_PCM_EVENT_REG_STA		0x3c0
+#define SPM_PCM_FSM_STA			0x3c4
+#define SPM_PCM_SW_INT_CLEAR		0x3e4
+#define SPM_CLK_CON			0x400
+#define SPM_AP_STANBY_CON		0x608
+#define SPM_SLEEP_WAKEUP_EVENT_MASK	0x810
+#define SPM_SLEEP_CPU_WAKEUP_EVENT	0x814
+#define SPM_PCM_WDT_TIMER_VAL		0x824
+#define SPM_SLEEP_ISR_MASK		0x900
+#define SPM_SLEEP_ISR_STATUS		0x904
+#define SPM_SLEEP_ISR_RAW_STA		0x910
+#define SPM_SLEEP_WAKEUP_MISC		0x918
+#define SPM_SLEEP_SUBSYS_IDLE_STA	0x920
+#define SPM_PCM_RESERVE			0xb00
+#define SPM_PCM_FLAGS			0xb08
+#define SPM_PCM_SRC_REQ			0xb0c
+#define SPM_PCM_PASR_DPD_0		0xb60
+#define SPM_PCM_PASR_DPD_2		0xb68
+#define SPM_PCM_PASR_DPD_3		0xb6c
+#define SPM_SLEEP_CA7_WFI_EN(n)		(0xf00 + 4 * (n))
+#define SPM_SLEEP_CA15_WFI_EN(n)	(0xf10 + 4 * (n))
+
+/* Writes to the block are ignored unless this key is presented first. */
+#define SPM_PROJECT_CODE		0xb16
+#define SPM_REGWR_CFG_KEY		(SPM_PROJECT_CODE << 16)
+#define SPM_REGWR_EN			BIT(0)
+
+#define CON0_CFG_KEY			(SPM_PROJECT_CODE << 16)
+#define CON0_PCM_KICK			BIT(0)
+#define CON0_IM_KICK			BIT(1)
+#define CON0_IM_SLEEP_DVS		BIT(3)
+#define CON0_PCM_SW_RESET		BIT(15)
+
+#define CON1_CFG_KEY			(SPM_PROJECT_CODE << 16)
+#define CON1_IM_SLAVE			BIT(0)
+#define CON1_MIF_APBEN			BIT(3)
+#define CON1_PCM_TIMER_EN		BIT(5)
+#define CON1_IM_NONRP_EN		BIT(6)
+#define CON1_PCM_WDT_EN			BIT(8)
+#define CON1_PCM_WDT_WAKE_MODE		BIT(9)
+#define CON1_SPM_SRAM_SLP_B		BIT(10)
+#define CON1_SPM_SRAM_ISO_B		BIT(11)
+#define CON1_EVENT_LOCK_EN		BIT(12)
+
+#define PCM_PWRIO_EN_R0			BIT(0)
+#define PCM_PWRIO_EN_R7			BIT(7)
+#define PCM_RF_SYNC_R0			BIT(16)
+#define PCM_RF_SYNC_R7			BIT(23)
+
+#define PCM_SW_INT_ALL			0xff
+
+#define CC_LOCK_INFRA_DCM		BIT(5)
+#define CC_SRCLKENA_MASK_0		BIT(6)
+#define CC_DISABLE_DORM_PWR		BIT(14)
+
+#define ISRM_TWAM			BIT(2)
+#define ISRM_PCM_RETURN			BIT(3)
+#define ISRM_RET_IRQ_AUX		(0x7f << 9)	/* IRQ1..7, not IRQ0 */
+#define ISRM_ALL_EXC_TWAM		(ISRM_RET_IRQ_AUX | ISRM_PCM_RETURN)
+#define ISRC_ALL_EXC_TWAM		ISRM_PCM_RETURN
+
+#define WAKE_MISC_PCM_TIMER		BIT(19)
+#define WAKE_MISC_CPU_WAKE		BIT(20)
+
+/* SPM_PCM_FSM_STA immediately after a PCM software reset. */
+#define PCM_FSM_STA_DEF			0x48490
+#define POWER_ON_VAL1_DEF		0x01011820
+
+/*
+ * SPM_CLK_CON as spm_register_init() leaves it on the vendor kernel. The PCM
+ * firmware assumes these: the three SYSCLK request enables, the clock-square
+ * select, and the two 32 kHz removal enables. A bootloader may leave a quite
+ * different value behind, so the driver installs this one for the duration of
+ * a suspend and restores what it found afterwards.
+ */
+#define CC_SYSCLK0_EN_0			BIT(0)
+#define CC_SYSCLK0_EN_1			BIT(1)
+#define CC_SYSCLK1_EN_0			BIT(2)
+#define CC_CXO32K_RM_EN_MD1		BIT(9)
+#define CC_CXO32K_RM_EN_MD2		BIT(10)
+#define CC_CLKSQ1_SEL			BIT(12)
+#define CC_MD32_DCM_EN			BIT(18)
+#define SPM_CLK_CON_DEF \
+	(CC_SYSCLK0_EN_0 | CC_SYSCLK0_EN_1 | CC_SYSCLK1_EN_0 | \
+	 CC_SRCLKENA_MASK_0 | CC_CXO32K_RM_EN_MD1 | CC_CXO32K_RM_EN_MD2 | \
+	 CC_CLKSQ1_SEL | CC_MD32_DCM_EN)
+
+#define PCM_WDT_TIMEOUT			(30 * 32768)		/* 30 s */
+#define PCM_TIMER_MAX			(0xffffffff - PCM_WDT_TIMEOUT)
+
+/* VTCXO settle time, 128 ticks of 32 kHz -- 3.9 ms. */
+#define SPM_SYSCLK_SETTLE		128
+
+/*
+ * pcm_flags, as passed to the PCM firmware in SPM_PCM_FLAGS. Each _DIS bit
+ * tells the firmware to skip one part of the sequence.
+ */
+#define SPM_CPU_PDN_DIS			BIT(0)
+#define SPM_INFRA_PDN_DIS		BIT(1)
+#define SPM_DDRPHY_PDN_DIS		BIT(2)
+#define SPM_DUALVCORE_PDN_DIS		BIT(3)
+#define SPM_PASR_DIS			BIT(4)
+#define SPM_DPD_DIS			BIT(5)
+#define SPM_CPU_DVS_DIS			BIT(9)
+#define SPM_SCREEN_OFF			BIT(13)
+
+/* Bit positions in SPM_PCM_REG12_DATA, the "why did we wake" register. */
+#define WAKE_SRC_SPM_MERGE		BIT(0)
+#define WAKE_SRC_KP			BIT(2)
+#define WAKE_SRC_EINT			BIT(6)
+#define WAKE_SRC_HDMI_CEC		BIT(8)
+#define WAKE_SRC_MD32			BIT(10)
+#define WAKE_SRC_USB_CD			BIT(14)
+#define WAKE_SRC_USB_PDN		BIT(15)
+#define WAKE_SRC_IRRX			BIT(17)
+#define WAKE_SRC_THERM			BIT(21)
+#define WAKE_SRC_SYSPWREQ		BIT(24)
+#define WAKE_SRC_SEJ			BIT(27)
+#define WAKE_SRC_ALL_MD32		BIT(28)
+
+#define WAKE_SRC_FOR_SUSPEND \
+	(WAKE_SRC_KP | WAKE_SRC_EINT | WAKE_SRC_MD32 | WAKE_SRC_USB_CD | \
+	 WAKE_SRC_USB_PDN | WAKE_SRC_THERM | WAKE_SRC_SYSPWREQ | \
+	 WAKE_SRC_SEJ | WAKE_SRC_ALL_MD32 | WAKE_SRC_HDMI_CEC | WAKE_SRC_IRRX)
+
+static const char *const wakesrc_name[32] = {
+	[0] = "SPM_MERGE",	[2] = "KP",		[3] = "WDT",
+	[4] = "GPT",		[5] = "GPT_MD32",	[6] = "EINT",
+	[7] = "EINT_MD32",	[8] = "HDMI_CEC",	[9] = "LOW_BAT",
+	[10] = "MD32",		[11] = "F26M_WAKE",	[12] = "F26M_SLEEP",
+	[13] = "PCM_WDT",	[14] = "USB_CD",	[15] = "USB_PDN",
+	[16] = "PMIC_EINT_0",	[17] = "IRRX",		[18] = "PMIC_MD32",
+	[19] = "UART0",		[20] = "AFE",		[21] = "THERM",
+	[22] = "CIRQ",		[23] = "AUD_MD32",	[24] = "SYSPWREQ",
+	[25] = "MD_WDT",	[26] = "CLDMA_MD",	[27] = "SEJ",
+	[28] = "ALL_MD32",	[29] = "CPU_IRQ",	[30] = "APSRC_WAKE",
+	[31] = "APSRC_SLEEP",
+};
+
+/*
+ * mcucfg: the two snoop-inactive bits asserted around the WFI. Both clusters
+ * need one, and they are not the same register: the A53 cluster's is
+ * MP0_AXI_CONFIG bit 4, as in the vendor's spm_trigger_wfi_for_sleep(); the
+ * A72 cluster's is CA15L_MISCDBG bit 0, the bit spm_mtcmos_ctrl_cpusys1() sets
+ * when it powers that cluster down. MP1_AXI_CONFIG (0x22c) is inert on this
+ * SoC. The SPM will not start the sleep sequence until both clusters report
+ * STANDBYWFIL2, and a powered cluster only does so with ACINACTM asserted.
+ */
+#define MP0_AXI_CONFIG			0x02c
+#define ACINACTM			BIT(4)
+#define CA15L_MISCDBG			0x20c
+#define CA15L_ACINACTM			BIT(0)
+
