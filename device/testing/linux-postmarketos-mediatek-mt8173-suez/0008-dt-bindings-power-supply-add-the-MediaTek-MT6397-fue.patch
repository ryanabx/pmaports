From 529bd5c678e3f0c0621e3a6735ee495d56397b5d Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Thu, 3 Sep 2026 14:08:02 -0500
Subject: [PATCH] dt-bindings: power: supply: add the MediaTek MT6397 fuel
 gauge

The MT6397 PMIC contains a fuel gauge (FGADC) that measures the battery
current across a board-provided sense resistor and integrates it in
hardware. Describe it as a child of the PMIC node.

Beyond the generic monitored-battery and power-supplies links and the two
AUXADC channels it consumes, the node carries the per-battery
characterisation MediaTek's battery meter runs on: open-circuit-voltage and
internal-resistance profiles at up to five temperatures, capacity at each
temperature for low and high current, the thermistor network and table,
and a handful of algorithm tunables. These come straight from the battery
vendor's characterisation as shipped in the device's own device tree, and
they use MediaTek's format (resistance as a function of open-circuit
voltage, depth of discharge rather than capacity), which is why they are
not expressed with the generic ocv-capacity tables in battery.yaml. A board
ported from a MediaTek kernel can carry its values over verbatim and get
the same state-of-charge readings it had before.

Also hook the new schema into the MT6397 MFD binding as a "battery" child,
next to the existing "adc" one.

Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 .../bindings/mfd/mediatek,mt6397.yaml         |   8 +
 .../power/supply/mediatek,mt6397-battery.yaml | 180 ++++++++++++++++++
 2 files changed, 188 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/mediatek,mt6397-battery.yaml

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
index 3cbc0dc12..45f7902ec 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
@@ -117,6 +117,14 @@ properties:
     $ref: /schemas/iio/adc/mediatek,mt6359-auxadc.yaml#
     unevaluatedProperties: false
 
+  battery:
+    type: object
+    $ref: /schemas/power/supply/mediatek,mt6397-battery.yaml#
+    unevaluatedProperties: false
+    description:
+      The MT6397 fuel gauge (FGADC), for boards that route the battery
+      current through the PMIC's sense input.
+
   audio-codec:
     type: object
     description:
diff --git a/Documentation/devicetree/bindings/power/supply/mediatek,mt6397-battery.yaml b/Documentation/devicetree/bindings/power/supply/mediatek,mt6397-battery.yaml
new file mode 100644
index 000000000..fb8844044
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/mediatek,mt6397-battery.yaml
@@ -0,0 +1,180 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/mediatek,mt6397-battery.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6397 PMIC fuel gauge
+
+maintainers:
+  - Ryan Brue <ryanbrue.dev@gmail.com>
+
+description:
+  The MT6397 PMIC contains a fuel gauge (FGADC) that measures the battery
+  current across a board-provided sense resistor and integrates it in
+  hardware. The driver runs MediaTek's battery-meter algorithm on top of it,
+  seeded from the open-circuit voltage the PMIC latches at power-on and
+  corrected with per-temperature open-circuit-voltage, internal-resistance
+  and capacity tables that come from the battery vendor's characterisation.
+  The tables use MediaTek's own format, which is why they are not expressed
+  with the generic battery properties. The gauge is a child of the PMIC node.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6397-battery
+
+  io-channels:
+    items:
+      - description: battery voltage, from the PMIC AUXADC
+      - description: battery thermistor voltage, from the PMIC AUXADC
+
+  io-channel-names:
+    items:
+      - const: voltage
+      - const: temperature
+
+  monitored-battery: true
+
+  power-supplies:
+    description: The charger, whose status re-anchors the gauge at full.
+
+  mediatek,sense-resistor-milli-ohms:
+    description: Value of the current sense resistor fitted on the board.
+    enum: [10, 20]
+
+  mediatek,car-tune-value:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Per-board correction of the charge accumulator, in percent. 100 means
+      no correction.
+    default: 100
+
+  mediatek,ocv2cv-transform:
+    type: boolean
+    description:
+      Convert the coulomb-counted state of charge with the charger's
+      constant-voltage current profile once the pack is near full.
+
+  mediatek,step-of-qmax-milliamp-hours:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Step used when searching the maximum capacity for a load.
+
+  mediatek,cv-current-microamp:
+    description: The charger's constant-voltage termination current.
+
+  mediatek,poweron-low-capacity-tolerance:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      State of charge in percent below which the value remembered from the
+      previous boot is not trusted unless a charger is present.
+    default: 0
+
+  mediatek,ntc-pull-up-ohms:
+    description: Pull-up resistor from the bias voltage to the thermistor.
+
+  mediatek,ntc-pull-up-millivolt:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Bias voltage feeding the thermistor pull-up.
+
+  mediatek,ntc-pull-down-ohms:
+    description: Resistor in parallel with the thermistor, if any.
+
+  mediatek,ntc-table:
+    $ref: /schemas/types.yaml#/definitions/int32-matrix
+    description:
+      Thermistor characterisation, pairs of temperature in degrees Celsius
+      and resistance in ohms, in ascending temperature order.
+    items:
+      items:
+        - description: temperature in degrees Celsius
+        - description: resistance in ohms
+
+  mediatek,profile-temperatures:
+    $ref: /schemas/types.yaml#/definitions/int32-array
+    description:
+      The temperatures, in degrees Celsius and ascending, at which the
+      battery was characterised. One OCV profile, one resistance profile and
+      one entry in each capacity list exists per temperature.
+    minItems: 1
+    maxItems: 5
+
+  mediatek,qmax-milliamp-hours:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Battery capacity at each profile temperature, low current.
+    minItems: 1
+    maxItems: 5
+
+  mediatek,qmax-high-current-milliamp-hours:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Battery capacity at each profile temperature, high current.
+    minItems: 1
+    maxItems: 5
+
+patternProperties:
+  "^mediatek,ocv-profile-[0-4]$":
+    $ref: /schemas/types.yaml#/definitions/uint32-matrix
+    description:
+      Open-circuit voltage profile at the corresponding profile temperature,
+      pairs of depth of discharge in percent and voltage in millivolts, in
+      ascending depth-of-discharge order.
+    items:
+      items:
+        - description: depth of discharge in percent
+        - description: open-circuit voltage in millivolts
+
+  "^mediatek,resistance-profile-[0-4]$":
+    $ref: /schemas/types.yaml#/definitions/uint32-matrix
+    description:
+      Internal resistance profile at the corresponding profile temperature,
+      pairs of resistance in milliohms and the open-circuit voltage at which
+      it applies, in the same order as the OCV profile.
+    items:
+      items:
+        - description: internal resistance in milliohms
+        - description: open-circuit voltage in millivolts
+
+required:
+  - compatible
+  - io-channels
+  - io-channel-names
+  - monitored-battery
+  - mediatek,sense-resistor-milli-ohms
+  - mediatek,ntc-pull-up-ohms
+  - mediatek,ntc-pull-up-millivolt
+  - mediatek,ntc-table
+  - mediatek,profile-temperatures
+  - mediatek,qmax-milliamp-hours
+  - mediatek,qmax-high-current-milliamp-hours
+  - mediatek,ocv-profile-0
+  - mediatek,resistance-profile-0
+
+additionalProperties: false
+
+examples:
+  - |
+    pmic {
+        fuel-gauge {
+            compatible = "mediatek,mt6397-battery";
+            io-channels = <&pmic_auxadc 0>, <&pmic_auxadc 1>;
+            io-channel-names = "voltage", "temperature";
+            monitored-battery = <&battery>;
+            power-supplies = <&charger>;
+            mediatek,sense-resistor-milli-ohms = <10>;
+            mediatek,car-tune-value = <101>;
+            mediatek,ocv2cv-transform;
+            mediatek,step-of-qmax-milliamp-hours = <54>;
+            mediatek,cv-current-microamp = <600000>;
+            mediatek,ntc-pull-up-ohms = <24000>;
+            mediatek,ntc-pull-up-millivolt = <1200>;
+            mediatek,ntc-pull-down-ohms = <100000000>;
+            mediatek,ntc-table = <(-20) 499900>, <25 47000>, <70 7897>;
+            mediatek,profile-temperatures = <25>;
+            mediatek,qmax-milliamp-hours = <6348>;
+            mediatek,qmax-high-current-milliamp-hours = <6130>;
+            mediatek,ocv-profile-0 = <0 4275>, <50 3831>, <100 3352>;
+            mediatek,resistance-profile-0 = <130 4275>, <110 3831>, <170 3352>;
+        };
+    };
