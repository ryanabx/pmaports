+/*
+ * mcucfg: the two snoop-inactive bits asserted around the WFI. Both clusters
+ * need one, and they are not the same register -- MP1_AXI_CONFIG (0x22c) reads
+ * 0xffffffff on this SoC and setting its bit 4 changes nothing, while
+ * CA15L_MISCDBG bit 0 is what spm_mtcmos_ctrl_cpusys1() uses and what actually
+ * works. Measured: with both A72 cores offline, setting CA15L_ACINACTM flips
+ * CA15_CPUTOP's STANDBYWFI in SPM_SLEEP_TIMER_STA from 0 to 1, and clearing it
+ * flips it back.
+ */
+#define MP0_AXI_CONFIG			0x02c
+#define ACINACTM			BIT(4)
+#define CA15L_MISCDBG			0x20c
+#define CA15L_ACINACTM			BIT(0)
+
