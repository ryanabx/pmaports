+/*
+ * Event vectors: (pc << 16) | (imme << 6) | (resume << 5) | event. These four
+ * come from suspend_pcm_ca7 in the vendor's mt_spm_sleep.c and are specific to
+ * the firmware image above -- the pc fields are entry points into it.
+ */
+#define EVENT_VEC(event, resume, imme, pc) \
+	(((pc) << 16) | (!!(imme) << 6) | (!!(resume) << 5) | ((event) & 0x1f))
+
+static const u32 spm_suspend_vec[4] = {
+	EVENT_VEC(11, 1, 0, 0),
+	EVENT_VEC(12, 1, 0, 54),
+	EVENT_VEC(30, 1, 0, 143),
+	EVENT_VEC(31, 1, 0, 277),
+};
+
+/*
+ * The default pcm_flags, matching the vendor's slp_spm_flags exactly.
+ * SPM_CPU_PDN_DIS is the whole design of this driver and is not negotiable;
+ * SPM_INFRA_PDN_DIS follows from it.
+ *
+ * SPM_DDRPHY_PDN_DIS is deliberately *not* set. Setting it keeps the DDR PHY
+ * powered through the sleep, which gives up most of the saving; it was set
+ * while the resume path was still unproven, on the theory that bringing DRAM
+ * back out of self-refresh was the riskiest step. It is no longer unproven:
+ * five round trips with the PHY powered down have all resumed cleanly, each
+ * sleeping the requested time to within 5 ms by the SPM's own tick count
+ * (12.005 s, 8.005 s, and three more), and a sixth was cut short at 38 ms by a
+ * genuine EINT. The parameter stays writable so the old behaviour is one echo
+ * away if a board ever needs it.
+ */
+#define SPM_FLAGS_DEFAULT \
+	(SPM_CPU_PDN_DIS | SPM_INFRA_PDN_DIS | \
+	 SPM_DUALVCORE_PDN_DIS | SPM_PASR_DIS | SPM_DPD_DIS | \
+	 SPM_CPU_DVS_DIS | SPM_SCREEN_OFF)
+
+static unsigned int spm_flags = SPM_FLAGS_DEFAULT;
+module_param(spm_flags, uint, 0644);
+MODULE_PARM_DESC(spm_flags, "SPM PCM flags; SPM_CPU_PDN_DIS|SPM_INFRA_PDN_DIS are forced on");
+
+struct mtk_spm {
+	struct device *dev;
+	struct regmap *spm;
+	struct regmap *mcucfg;
+	struct regmap *pmic;
+	struct clk *scp_sel;
+	struct clk *clk26m;
+	struct clk *syspll1_d2;
+	u32 *pcm;		/* PCM firmware, DMA-visible */
+	dma_addr_t pcm_dma;
+	/* saved across suspend, see spm_save_state() */
+	u32 save_pwr_on_val0;
+	u32 save_pwr_on_val1;
+	u32 save_clk_con;
+	u32 save_pmic[3];
+};
+
+static struct mtk_spm *spm_ctx;
+
+static u32 spm_read(struct mtk_spm *s, u32 off)
+{
+	u32 val = 0;
+
+	regmap_read(s->spm, off, &val);
+	return val;
+}
+
+static void spm_write(struct mtk_spm *s, u32 off, u32 val)
+{
+	regmap_write(s->spm, off, val);
+}
+
+/* The block ignores writes until this is presented. Cheap; do it every time. */
+static void spm_unlock(struct mtk_spm *s)
+{
+	spm_write(s, SPM_POWERON_CONFIG_SET, SPM_REGWR_CFG_KEY | SPM_REGWR_EN);
+}
+
+/*
+ * Bring the SPM to the state the PCM firmware expects. The vendor does this
+ * once at boot from spm_register_init(); doing it in .enter instead keeps a
+ * wrong value from affecting a machine that is merely running, and the values
+ * are restored on the way out.
+ */
+static int spm_reset_and_init_pcm(struct mtk_spm *s)
+{
+	u32 con1, sta;
+
+	spm_write(s, SPM_PCM_CON0, CON0_CFG_KEY | CON0_PCM_SW_RESET);
+	spm_write(s, SPM_PCM_CON0, CON0_CFG_KEY);
+
+	sta = spm_read(s, SPM_PCM_FSM_STA);
+	if (sta != PCM_FSM_STA_DEF) {
+		dev_err(s->dev, "PCM reset failed, FSM_STA = 0x%x\n", sta);
+		return -EIO;
+	}
+
+	/* disable the event vectors until the PCM enables them itself */
+	spm_write(s, SPM_PCM_CON0, CON0_CFG_KEY | CON0_IM_SLEEP_DVS);
+
+	/* keep the WDT setting, drop everything else */
+	con1 = spm_read(s, SPM_PCM_CON1) &
+	       (CON1_PCM_WDT_WAKE_MODE | CON1_PCM_WDT_EN);
+	spm_write(s, SPM_PCM_CON1, con1 | CON1_CFG_KEY | CON1_EVENT_LOCK_EN |
+		  CON1_SPM_SRAM_ISO_B | CON1_SPM_SRAM_SLP_B |
+		  CON1_IM_NONRP_EN | CON1_MIF_APBEN);
+
+	return 0;
+}
+
+/* Point the instruction fetcher at the firmware in DRAM and start the fetch. */
+static void spm_kick_im_to_fetch(struct mtk_spm *s)
+{
+	u32 con0;
+
+	/*
+	 * The vendor skips the fetch and runs from SPM SRAM (CON1_IM_SLAVE)
+	 * when IM_PTR and IM_LEN already describe this image. That is only an
+	 * optimisation, and it reads registers the bootloader left behind to
+	 * decide -- so always re-fetch instead. A fetch is a few microseconds
+	 * once per suspend.
+	 */
+	spm_write(s, SPM_PCM_IM_PTR, (u32)s->pcm_dma);
+	spm_write(s, SPM_PCM_IM_LEN, ARRAY_SIZE(spm_suspend_pcm) - 1);
+
+	con0 = spm_read(s, SPM_PCM_CON0) & ~(CON0_IM_KICK | CON0_PCM_KICK);
+	spm_write(s, SPM_PCM_CON0, con0 | CON0_CFG_KEY | CON0_IM_KICK);
+	spm_write(s, SPM_PCM_CON0, con0 | CON0_CFG_KEY);
+}
+
+/* r0 and r7 are the PCM's power-control outputs; seed them from the defaults. */
+static void spm_init_pcm_register(struct mtk_spm *s)
+{
+	spm_write(s, SPM_PCM_REG_DATA_INI, spm_read(s, SPM_POWER_ON_VAL0));
+	spm_write(s, SPM_PCM_PWR_IO_EN, PCM_RF_SYNC_R0);
+	spm_write(s, SPM_PCM_PWR_IO_EN, 0);
+
+	spm_write(s, SPM_PCM_REG_DATA_INI, spm_read(s, SPM_POWER_ON_VAL1));
+	spm_write(s, SPM_PCM_PWR_IO_EN, PCM_RF_SYNC_R7);
+	spm_write(s, SPM_PCM_PWR_IO_EN, 0);
+}
+
+/*
+ * Tell the SPM what must be true before it may take the SoC down. The vendor
+ * builds these words from a struct pwr_ctrl; there is only one scenario here,
+ * so the values are folded in with the field that produced each one named.
+ */
+static void spm_set_power_control(struct mtk_spm *s)
+{
+	/*
+	 * disp_req_mask = 0 and mfg_req_mask = 0 -> honour the display and GPU
+	 * requests (bits 16 and 17 are "unmasked"); md32_req_mask = 1 -> ignore
+	 * the MD32 coprocessor, which mainline does not run; wfi_op = AND ->
+	 * every enabled CPU must be in WFI, not just one.
+	 */
+	spm_write(s, SPM_AP_STANBY_CON, BIT(17) | BIT(16) | BIT(4));
+
+	/* pcm_apsrc_req = 0: do not hold the DRAM source request across sleep */
+	spm_write(s, SPM_PCM_SRC_REQ, 0);
+
+	/* every dsi/dpi/isp "keep DDR alive" request masked off */
+	spm_write(s, SPM_PCM_PASR_DPD_2, 0);
+
+	/* srclkenai_mask = 1 */
+	spm_write(s, SPM_CLK_CON, spm_read(s, SPM_CLK_CON) | CC_SRCLKENA_MASK_0);
+
+	/*
+	 * Require WFI from all eight possible cores. MT8173 fits two per
+	 * cluster, and the SPM reports the four that do not exist as
+	 * permanently in WFI, so an AND over all eight is the same condition as
+	 * an AND over the four that are real -- measured on this unit.
+	 */
+	spm_write(s, SPM_SLEEP_CA7_WFI_EN(0), 1);
+	spm_write(s, SPM_SLEEP_CA7_WFI_EN(1), 1);
+	spm_write(s, SPM_SLEEP_CA7_WFI_EN(2), 1);
+	spm_write(s, SPM_SLEEP_CA7_WFI_EN(3), 1);
+	spm_write(s, SPM_SLEEP_CA15_WFI_EN(0), 1);
+	spm_write(s, SPM_SLEEP_CA15_WFI_EN(1), 1);
+	spm_write(s, SPM_SLEEP_CA15_WFI_EN(2), 1);
+	spm_write(s, SPM_SLEEP_CA15_WFI_EN(3), 1);
+}
+
+static void spm_set_wakeup_event(struct mtk_spm *s)
+{
+	u32 isr;
+
+	/*
+	 * The PCM timer is set to its maximum (~36 h), as the vendor does when
+	 * its periodic wake is disabled. It is not a usable backstop here, see
+	 * the comment above spm_report_wakeup(); the PCM watchdog is armed at
+	 * this value + 30 s in spm_kick_pcm_to_run(), which is what makes a
+	 * shorter value dangerous rather than merely useless.
+	 */
+	spm_write(s, SPM_PCM_TIMER_VAL, PCM_TIMER_MAX);
+	spm_write(s, SPM_PCM_CON1,
+		  spm_read(s, SPM_PCM_CON1) | CON1_CFG_KEY | CON1_PCM_TIMER_EN);
+
+	/* the mask register is active-low: a clear bit is an enabled source */
+	spm_write(s, SPM_SLEEP_WAKEUP_EVENT_MASK, (u32)~WAKE_SRC_FOR_SUSPEND);
+
+	/* unmask the SPM ISR, keeping whatever TWAM setting is there */
+	isr = spm_read(s, SPM_SLEEP_ISR_MASK) & ISRM_TWAM;
+	spm_write(s, SPM_SLEEP_ISR_MASK, isr | ISRM_RET_IRQ_AUX);
+}
+
+static void spm_kick_pcm_to_run(struct mtk_spm *s)
+{
+	u32 con1, con0;
+
+	/* the PCM watchdog is the backstop for a firmware that never returns */
+	con1 = spm_read(s, SPM_PCM_CON1) &
+	       ~(CON1_PCM_WDT_WAKE_MODE | CON1_PCM_WDT_EN);
+	spm_write(s, SPM_PCM_CON1, CON1_CFG_KEY | con1);
+	spm_write(s, SPM_PCM_WDT_TIMER_VAL,
+		  spm_read(s, SPM_PCM_TIMER_VAL) + PCM_WDT_TIMEOUT);
+	spm_write(s, SPM_PCM_CON1, con1 | CON1_CFG_KEY | CON1_PCM_WDT_EN);
+
+	spm_write(s, SPM_PCM_PASR_DPD_0, 0);
+
+	spm_write(s, SPM_PCM_MAS_PAUSE_MASK, 0xffffffff);
+	spm_write(s, SPM_PCM_REG_DATA_INI, 0);
+	spm_write(s, SPM_CLK_CON, spm_read(s, SPM_CLK_CON) & ~CC_DISABLE_DORM_PWR);
+
+	spm_write(s, SPM_PCM_FLAGS, spm_flags | SPM_CPU_PDN_DIS | SPM_INFRA_PDN_DIS);
+	spm_write(s, SPM_PCM_RESERVE, 0);
+
+	/* infra_dcm_lock = 1 */
+	spm_write(s, SPM_CLK_CON, spm_read(s, SPM_CLK_CON) | CC_LOCK_INFRA_DCM);
+
+	/* r0_ctrl_en = 1, r7_ctrl_en = 1 */
+	spm_write(s, SPM_PCM_PWR_IO_EN, PCM_PWRIO_EN_R0 | PCM_PWRIO_EN_R7);
+
+	con0 = spm_read(s, SPM_PCM_CON0) & ~(CON0_IM_KICK | CON0_PCM_KICK);
+	spm_write(s, SPM_PCM_CON0, con0 | CON0_CFG_KEY | CON0_PCM_KICK);
+	spm_write(s, SPM_PCM_CON0, con0 | CON0_CFG_KEY);
+}
+
+static void spm_clean_after_wakeup(struct mtk_spm *s)
+{
+	spm_write(s, SPM_PCM_CON1,
+		  CON1_CFG_KEY | (spm_read(s, SPM_PCM_CON1) & ~CON1_PCM_WDT_EN));
+
+	spm_write(s, SPM_PCM_PWR_IO_EN, 0);
+	spm_write(s, SPM_SLEEP_CPU_WAKEUP_EVENT, 0);
+	spm_write(s, SPM_PCM_CON1,
+		  CON1_CFG_KEY | (spm_read(s, SPM_PCM_CON1) & ~CON1_PCM_TIMER_EN));
+	spm_write(s, SPM_SLEEP_WAKEUP_EVENT_MASK, ~0);
+	spm_write(s, SPM_SLEEP_ISR_MASK,
+		  spm_read(s, SPM_SLEEP_ISR_MASK) | ISRM_ALL_EXC_TWAM);
+	spm_write(s, SPM_SLEEP_ISR_STATUS, ISRC_ALL_EXC_TWAM);
+	spm_write(s, SPM_PCM_SW_INT_CLEAR, PCM_SW_INT_ALL);
+}
+
+/*
+ * On the PCM timer, and why there is no module parameter for it any more.
+ *
+ * The CPU stays powered on this path (SPM_CPU_PDN_DIS) and waits in WFI with
+ * interrupts masked, so only a pending GIC interrupt can bring it back. The
+ * EINT-routed wake sources (power key, RTC alarm, charger) have their own GIC
+ * lines and work. The PCM timer does not: its expiry stops PCM_TIMER_OUT at the
+ * programmed value and sets WAKE_MISC_PCM_TIMER in the firmware's r12, and the
+ * CPU stays in WFI. Measured 2026-09-02 on amazon-suez with the timer at 30 s
+ * and an RTC alarm at 45 s: the board returned at 44 s, every time, and this
+ * function then reported "woke by PCM_TIMER, slept 30.005 s" for a wake the
+ * RTC had done. Neither requesting the SPM's own interrupt (GIC SPI 155, which
+ * is still requested because the vendor does and it costs nothing) nor
+ * unmasking WAKE_SRC_SPM_MERGE changed that. The vendor's periodic timer wake
+ * relies on the CPU being powered down and re-entering through its reset
+ * vector, which is the dormant path this driver deliberately does not take.
+ *
+ * Worse than useless: the PCM watchdog is armed at timer + 30 s in reset mode,
+ * and a suspend whose only real wake source (the RTC) was later than that never
+ * returned -- power-button recovery. So the timer is pinned at PCM_TIMER_MAX
+ * and tests must arm an RTC alarm. The PCM_TIMER line below is kept only so a
+ * future firmware that does deliver the event is recognisable.
+ */
+static void spm_report_wakeup(struct mtk_spm *s)
+{
+	u32 r12 = spm_read(s, SPM_PCM_REG12_DATA);
+	u32 misc = spm_read(s, SPM_SLEEP_WAKEUP_MISC);
+	u32 assert_pc = spm_read(s, SPM_PCM_REG_DATA_INI);
+	u32 event_reg = spm_read(s, SPM_PCM_EVENT_REG_STA);
+	char buf[160];
+	int n = 0, i;
+
+	if (assert_pc) {
+		dev_err(s->dev, "PCM asserted at %u, r13 = 0x%x, debug = 0x%x\n",
+			assert_pc, spm_read(s, SPM_PCM_REG13_DATA),
+			spm_read(s, SPM_PCM_PASR_DPD_3));
+		return;
+	}
+
+	buf[0] = '\0';
+	if (r12 & WAKE_SRC_SPM_MERGE) {
+		if (misc & WAKE_MISC_PCM_TIMER)
+			n += scnprintf(buf + n, sizeof(buf) - n, " PCM_TIMER");
+		if (misc & WAKE_MISC_CPU_WAKE)
+			n += scnprintf(buf + n, sizeof(buf) - n, " CPU");
+	}
+	for (i = 1; i < 32; i++) {
+		if ((r12 & BIT(i)) && wakesrc_name[i])
+			n += scnprintf(buf + n, sizeof(buf) - n, " %s",
+				       wakesrc_name[i]);
+	}
+
+	/*
+	 * Bit 20 of PCM_EVENT_REG_STA is the firmware's "I completed the sleep
+	 * sequence" flag. Without it the PCM turned around early and nothing
+	 * was actually powered down, which looks exactly like a working suspend
+	 * from userspace -- so say so.
+	 */
+	if (!(event_reg & 0x100000))
+		dev_warn(s->dev, "PCM aborted the sleep sequence (event_reg = 0x%x)\n",
+			 event_reg);
+
+	dev_info(s->dev, "woke by%s, slept %u ticks, idle_sta = 0x%x, raw_sta = 0x%x\n",
+		 buf[0] ? buf : " (nothing)", spm_read(s, SPM_PCM_TIMER_OUT),
+		 spm_read(s, SPM_SLEEP_SUBSYS_IDLE_STA),
+		 spm_read(s, SPM_SLEEP_ISR_RAW_STA));
+}
+
+/*
+ * With the CPU staying powered, the three rails that feed it must not be
+ * dropped by the PMIC's SRCLKEN-driven hardware voltage control while the SoC
+ * is down. This is the same trio of writes spm_go_to_sleep() makes on its
+ * !is_cpu_pdn() path -- VCA15, VSRMCA15 and VCORE, bits [1:0], [1:0] and [1].
+ * The vendor never puts them back; we do, so that resume leaves the PMIC as it
+ * was found.
+ */
+static const struct {
+	u32 reg;
+	u32 mask;
+} spm_pmic_hold[3] = {
+	{ MT6397_VCA15_CON5,   GENMASK(1, 0) },
+	{ MT6397_VSRMCA15_CON5, GENMASK(1, 0) },
+	{ MT6397_VCORE_CON5,   BIT(1) },
+};
+
+static void spm_pmic_prepare(struct mtk_spm *s)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(spm_pmic_hold); i++) {
+		regmap_read(s->pmic, spm_pmic_hold[i].reg, &s->save_pmic[i]);
+		regmap_update_bits(s->pmic, spm_pmic_hold[i].reg,
+				   spm_pmic_hold[i].mask, 0);
+	}
+}
+
+static void spm_pmic_restore(struct mtk_spm *s)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(spm_pmic_hold); i++)
+		regmap_update_bits(s->pmic, spm_pmic_hold[i].reg,
+				   spm_pmic_hold[i].mask, s->save_pmic[i]);
+}
+
+/*
+ * The SoC's SPM outputs are driven from POWER_ON_VAL0/1 and CLK_CON whenever
+ * the PCM is not in control. The firmware expects the vendor's values; the
+ * bootloader leaves different ones. Save what is there, install the vendor's,
+ * and put the originals back on resume, so a machine that never suspends is
+ * left exactly as mainline had it.
+ */
+static void spm_save_state(struct mtk_spm *s)
+{
+	s->save_pwr_on_val0 = spm_read(s, SPM_POWER_ON_VAL0);
+	s->save_pwr_on_val1 = spm_read(s, SPM_POWER_ON_VAL1);
+	s->save_clk_con = spm_read(s, SPM_CLK_CON);
+}
+
+static void spm_restore_state(struct mtk_spm *s)
+{
+	spm_write(s, SPM_POWER_ON_VAL0, s->save_pwr_on_val0);
+	spm_write(s, SPM_POWER_ON_VAL1, s->save_pwr_on_val1);
+	spm_write(s, SPM_CLK_CON, s->save_clk_con);
+}
+
+static int mtk_spm_suspend_enter(suspend_state_t state)
+{
+	struct mtk_spm *s = spm_ctx;
+	int ret;
+
+	spm_unlock(s);
+	spm_save_state(s);
+
+	spm_write(s, SPM_POWER_ON_VAL0, 0);
+	spm_write(s, SPM_POWER_ON_VAL1, POWER_ON_VAL1_DEF);
+	spm_write(s, SPM_CLK_CON, SPM_CLK_CON_DEF);
+	spm_write(s, SPM_PCM_PWR_IO_EN, 0);
+
+	ret = spm_reset_and_init_pcm(s);
+	if (ret)
+		goto restore;
+
+	/* VTCXO settle time, in 32 kHz ticks */
+	spm_write(s, SPM_CLK_SETTLE, SPM_SYSCLK_SETTLE);
+
+	spm_kick_im_to_fetch(s);
+	spm_init_pcm_register(s);
+
+	spm_write(s, SPM_PCM_EVENT_VECTOR(0), spm_suspend_vec[0]);
+	spm_write(s, SPM_PCM_EVENT_VECTOR(1), spm_suspend_vec[1]);
+	spm_write(s, SPM_PCM_EVENT_VECTOR(2), spm_suspend_vec[2]);
+	spm_write(s, SPM_PCM_EVENT_VECTOR(3), spm_suspend_vec[3]);
+	spm_write(s, SPM_PCM_EVENT_VECTOR(4), 0);
+	spm_write(s, SPM_PCM_EVENT_VECTOR(5), 0);
+	spm_write(s, SPM_PCM_EVENT_VECTOR(6), 0);
+	spm_write(s, SPM_PCM_EVENT_VECTOR(7), 0);
+
+	spm_set_power_control(s);
+	spm_set_wakeup_event(s);
+	spm_kick_pcm_to_run(s);
+
+	/*
+	 * Everything past here runs with the SPM armed and waiting for the CPU
+	 * standby signals. ACINACTM tells a cluster's bus interface that its
+	 * snoop traffic has stopped, which is what lets the cluster assert
+	 * STANDBYWFIL2 -- and suspend_ctrl leaves ca7top_idle_mask,
+	 * ca15top_idle_mask and mcusys_idle_mask all at 0, which means "require"
+	 * (mt_spm_sodi.c sets them to 1 for the shallowest state, so 1 is
+	 * "ignore"). So both clusters need it, not just the one this CPU is in:
+	 * without the A72's, CA15_CPUTOP never reports idle and the SPM never
+	 * enters sleep at all.
+	 *
+	 * Touching the A72's is safe here only because suspend_enter() has
+	 * already offlined every secondary CPU, so nothing is executing in that
+	 * cluster. No coherent access may happen between setting these and the
+	 * WFI, which is why there is nothing between them but the barrier.
+	 */
+	regmap_update_bits(s->mcucfg, CA15L_MISCDBG, CA15L_ACINACTM,
+			   CA15L_ACINACTM);
+	regmap_update_bits(s->mcucfg, MP0_AXI_CONFIG, ACINACTM, ACINACTM);
+
+	/* isb, then dsb, then wfi -- the order the vendor's wfi_with_sync uses */
+	asm volatile("isb\n\tdsb sy\n\twfi" : : : "memory");
+
+	regmap_update_bits(s->mcucfg, MP0_AXI_CONFIG, ACINACTM, 0);
+	regmap_update_bits(s->mcucfg, CA15L_MISCDBG, CA15L_ACINACTM, 0);
+
+	spm_report_wakeup(s);
+	spm_clean_after_wakeup(s);
+
+restore:
+	spm_restore_state(s);
+
+	return ret;
+}
+
+/*
+ * Everything that can sleep lives here rather than in .enter, which runs with
+ * interrupts disabled: the PMIC is reached over pmic-wrap, whose regmap takes a
+ * mutex, and clk_set_parent takes the clk prepare lock. The SPM and mcucfg
+ * regmaps are regmap-mmio, which is fast_io and therefore spinlock-based, so
+ * those are the only ones .enter is allowed to touch.
+ *
+ * .prepare_late and .wake are an exact pair: suspend_enter() reaches .wake on
+ * every path on which it called .prepare_late, including the failure ones.
+ */
+static int mtk_spm_suspend_prepare_late(void)
+{
+	struct mtk_spm *s = spm_ctx;
+
+	spm_pmic_prepare(s);
+
+	/*
+	 * fscp_ck must not be parented to a PLL that the SPM is about to stop.
+	 * The vendor reparents it to the 26 MHz crystal for the duration.
+	 */
+	if (s->scp_sel && s->clk26m)
+		clk_set_parent(s->scp_sel, s->clk26m);
+
+	return 0;
+}
+
+static void mtk_spm_suspend_wake(void)
+{
+	struct mtk_spm *s = spm_ctx;
+
+	if (s->scp_sel && s->syspll1_d2)
+		clk_set_parent(s->scp_sel, s->syspll1_d2);
+
+	spm_pmic_restore(s);
+}
+
+/*
+ * PM_SUSPEND_MEM only. Offering PM_SUSPEND_STANDBY as well would advertise a
+ * state the SPM firmware has no sequence for.
+ */
+static int mtk_spm_suspend_valid(suspend_state_t state)
+{
+	return state == PM_SUSPEND_MEM;
+}
+
+static const struct platform_suspend_ops mtk_spm_suspend_ops = {
+	.valid = mtk_spm_suspend_valid,
+	.prepare_late = mtk_spm_suspend_prepare_late,
+	.enter = mtk_spm_suspend_enter,
+	.wake = mtk_spm_suspend_wake,
+};
+
+
+static int mtk_spm_get_pmic_regmap(struct mtk_spm *s)
+{
+	struct platform_device *pmic_pdev;
+	struct device_node *np;
+
+	np = of_parse_phandle(s->dev->of_node, "mediatek,pmic", 0);
+	if (!np)
+		return -EINVAL;
+
+	pmic_pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pmic_pdev)
+		return -EPROBE_DEFER;
+
+	s->pmic = pmic_pdev->dev.parent ?
+		  dev_get_regmap(pmic_pdev->dev.parent, NULL) : NULL;
+	put_device(&pmic_pdev->dev);
+
+	return s->pmic ? 0 : -EPROBE_DEFER;
+}
+
+/*
+ * Normally never runs: the wake path acks the SPM's status and software
+ * interrupt in spm_clean_after_wakeup() before interrupts are re-enabled. The
+ * line is requested because the vendor does (all six, IRQF_NO_SUSPEND) and so
+ * that a firmware-raised SPM interrupt has an owner; it acks defensively.
+ */
+static irqreturn_t mtk_spm_irq(int irq, void *data)
+{
+	struct mtk_spm *s = data;
+	u32 isr = spm_read(s, SPM_SLEEP_ISR_STATUS);
+
+	spm_write(s, SPM_SLEEP_ISR_MASK,
+		  spm_read(s, SPM_SLEEP_ISR_MASK) | ISRM_ALL_EXC_TWAM);
+	spm_write(s, SPM_SLEEP_ISR_STATUS, isr);
+	spm_write(s, SPM_PCM_SW_INT_CLEAR, PCM_SW_INT_ALL);
+
+	dev_dbg(s->dev, "SPM irq outside the wake path, isr = 0x%x\n", isr);
+	return IRQ_HANDLED;
+}
+
+static int mtk_spm_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mtk_spm *s;
+	int ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+
+	s->dev = dev;
+
+	/*
+	 * No reg of our own: the SPM registers are the scpsys syscon, which
+	 * mtk-pm-domains also uses for the peripheral power domains. Taking a
+	 * regmap on the shared parent is what keeps the two from fighting over
+	 * an ioremap, and is the same thing mtk-pm-domains does.
+	 */
+	if (!dev->parent)
+		return dev_err_probe(dev, -ENODEV, "no syscon parent\n");
+
+	s->spm = syscon_node_to_regmap(dev->parent->of_node);
+	if (IS_ERR(s->spm))
+		return dev_err_probe(dev, PTR_ERR(s->spm),
+				     "no regmap for the scpsys syscon\n");
+
+	s->mcucfg = syscon_regmap_lookup_by_phandle(dev->of_node, "mediatek,mcucfg");
+	if (IS_ERR(s->mcucfg))
+		return dev_err_probe(dev, PTR_ERR(s->mcucfg),
+				     "no mediatek,mcucfg phandle\n");
+
+	/*
+	 * The MT6397 is not a syscon -- it has no registers of its own on the
+	 * SoC bus, and its regmap is created by mtk-pmic-wrap and registered
+	 * against the pwrap device. mt6397-core.c reaches it the same way, with
+	 * dev_get_regmap() on its parent. Only three registers are touched, all
+	 * on the CPU-stays-powered path.
+	 */
+	ret = mtk_spm_get_pmic_regmap(s);
+	if (ret)
+		return dev_err_probe(dev, ret, "no PMIC regmap\n");
+
+	/* Optional: without them fscp_ck simply is not reparented. */
+	s->scp_sel = devm_clk_get_optional(dev, "scp_sel");
+	s->clk26m = devm_clk_get_optional(dev, "clk26m");
+	s->syspll1_d2 = devm_clk_get_optional(dev, "syspll1_d2");
+	if (IS_ERR(s->scp_sel) || IS_ERR(s->clk26m) || IS_ERR(s->syspll1_d2)) {
+		dev_warn(dev, "SCP clocks unavailable; not reparenting fscp_ck\n");
+		s->scp_sel = NULL;
+	}
+
+	/*
+	 * The SPM's instruction fetcher is a bus master reading DRAM, and
+	 * SPM_PCM_IM_PTR is 32 bits wide. Coherent memory, so the firmware is
+	 * visible to it without any cache maintenance of our own.
+	 */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret, "no 32-bit DMA\n");
+
+	s->pcm = dmam_alloc_coherent(dev, sizeof(spm_suspend_pcm), &s->pcm_dma,
+				     GFP_KERNEL);
+	if (!s->pcm)
+		return -ENOMEM;
+
+	/* Optional: SPM IRQ0, trigger type from the DT. */
+	ret = platform_get_irq_optional(pdev, 0);
+	if (ret > 0) {
+		ret = devm_request_irq(dev, ret, mtk_spm_irq, IRQF_NO_SUSPEND,
+				       "mtk-spm-suspend", s);
+		if (ret)
+			return dev_err_probe(dev, ret, "cannot request the SPM irq\n");
+	}
+	memcpy(s->pcm, spm_suspend_pcm, sizeof(spm_suspend_pcm));
+
+	spm_ctx = s;
+	suspend_set_ops(&mtk_spm_suspend_ops);
+
+	dev_info(dev, "suspend-to-RAM via the SPM, PCM firmware at %pad (%zu words)\n",
+		 &s->pcm_dma, ARRAY_SIZE(spm_suspend_pcm));
+
+	return 0;
+}
+
+static void mtk_spm_remove(struct platform_device *pdev)
+{
+	suspend_set_ops(NULL);
+	spm_ctx = NULL;
+}
+
+static const struct of_device_id mtk_spm_of_match[] = {
+	{ .compatible = "mediatek,mt8173-spm-suspend" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_spm_of_match);
+
+static struct platform_driver mtk_spm_driver = {
+	.probe = mtk_spm_probe,
+	.remove = mtk_spm_remove,
+	.driver = {
+		.name = "mtk-spm-suspend",
+		.of_match_table = mtk_spm_of_match,
+	},
+};
+module_platform_driver(mtk_spm_driver);
+
+MODULE_DESCRIPTION("MediaTek MT8173 SPM suspend-to-RAM");
+MODULE_LICENSE("GPL");
