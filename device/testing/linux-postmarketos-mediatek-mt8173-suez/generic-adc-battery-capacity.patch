 static struct gab *to_generic_bat(struct power_supply *psy)
@@ -115,6 +116,58 @@
 		return gab_read_channel(adc_bat, GAB_POWER, &val->intval);
 	case POWER_SUPPLY_PROP_TEMP:
 		return gab_read_channel(adc_bat, GAB_TEMP, &val->intval);
+	case POWER_SUPPLY_PROP_CAPACITY: {
+		int uv, temp, ret;
+
+		ret = gab_read_channel(adc_bat, GAB_VOLTAGE, &uv);
+		if (ret < 0)
+			return ret;
+
+		/*
+		 * Look up the RESTED voltage, not the loaded one. Charge or
+		 * load current across the pack's internal resistance offsets
+		 * the terminal voltage by tens of millivolts, and on a curve
+		 * as flat as a lithium cell's -- about 1.5 mV per percent
+		 * through the middle of the range -- that is a ten-point step
+		 * in reported charge every time the charger is plugged or
+		 * unplugged, plus a running wobble as the load varies.
+		 * Measured on amazon-suez: 83 mV across a 966 mA swing.
+		 *
+		 * Current is positive into the battery, so one subtraction is
+		 * correct in both directions.
+		 */
+		if (adc_bat->channel[GAB_CURRENT] && adc_bat->info &&
+		    adc_bat->info->factory_internal_resistance_uohm > 0) {
+			int ua;
+
+			if (!gab_read_channel(adc_bat, GAB_CURRENT, &ua))
+				uv -= div_s64((s64)ua *
+					      adc_bat->info->factory_internal_resistance_uohm,
+					      1000000);
+		}
+
+		/*
+		 * The OCV tables are indexed by temperature in degrees
+		 * Celsius. Use the measured one where the board has a
+		 * temperature channel, otherwise assume room temperature --
+		 * power_supply_batinfo_ocv2cap() picks the nearest table.
+		 */
+		if (adc_bat->channel[GAB_TEMP]) {
+			ret = gab_read_channel(adc_bat, GAB_TEMP, &temp);
+			if (ret < 0)
+				return ret;
+			temp /= 1000;
+		} else {
+			temp = 25;
+		}
+
+		ret = power_supply_batinfo_ocv2cap(adc_bat->info, uv, temp);
+		if (ret < 0)
+			return ret;
+
+		val->intval = ret;
+		return 0;
+	}
 	default:
 		return -EINVAL;
 	}
