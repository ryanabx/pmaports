+config MEDIATEK_MT6397_AUXADC
+	tristate "MediaTek MT6397 PMIC AUXADC driver"
+	depends on MFD_MT6397
+	help
+	  Say yes here to enable support for the auxiliary ADC inside the
+	  MediaTek MT6397 PMIC. On boards using this PMIC it is the only way
+	  to read the battery voltage, since the SoC AUXADC is wired to board
+	  thermistors instead.
+
+	  This driver can also be built as a module. If so, the module will be
+	  called mt6397-auxadc.
+
 config MEDIATEK_MT6577_AUXADC
 	tristate "MediaTek AUXADC driver"
 	depends on ARCH_MEDIATEK || COMPILE_TEST
