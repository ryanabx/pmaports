From 79ea6b1c61a4f4d584a7d62ab4d711cbb21061fa Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Sun, 6 Sep 2026 22:45:57 -0500
Subject: [PATCH] dt-bindings: display: mediatek: ovl: describe the MMSYS reset

The OVL block has a reset line in MMSYS, the same way DSI0 does, but
mediatek,ovl.yaml does not describe it and the schema is
additionalProperties: false -- so a node that wires the reset up fails
dtbs_check even though the hardware has it.

Allow a single unnamed reset, mirroring what mediatek,dsi.yaml already
does for MT8173_MMSYS_SW0_RST_B_DISP_DSI0, and show it in the example.

This rides with the local MT8173 OVL reset work rather than going
upstream on its own: the reset bit that uses it was established by
sweeping SW0_RST_B against a wedged overlay rather than from a datasheet,
and a binding addition with no in-tree user is not much use to anyone
else.

Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 .../devicetree/bindings/display/mediatek/mediatek,ovl.yaml   | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl.yaml b/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl.yaml
index 4df5c7b41..2a2ec28b7 100644
--- a/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl.yaml
+++ b/Documentation/devicetree/bindings/display/mediatek/mediatek,ovl.yaml
@@ -69,6 +69,9 @@ properties:
     minItems: 1
     maxItems: 2
 
+  resets:
+    maxItems: 1
+
   mediatek,gce-client-reg:
     description: The register of client driver can be configured by gce with
       4 arguments defined in this property, such as phandle of gce, subsys id,
@@ -116,6 +119,7 @@ examples:
     #include <dt-bindings/power/mt8173-power.h>
     #include <dt-bindings/gce/mt8173-gce.h>
     #include <dt-bindings/memory/mt8173-larb-port.h>
+    #include <dt-bindings/reset/mt8173-resets.h>
 
     soc {
         #address-cells = <2>;
@@ -128,6 +132,7 @@ examples:
             power-domains = <&scpsys MT8173_POWER_DOMAIN_MM>;
             clocks = <&mmsys CLK_MM_DISP_OVL0>;
             iommus = <&iommu M4U_PORT_DISP_OVL0>;
+            resets = <&mmsys MT8173_MMSYS_SW0_RST_B_DISP_OVL0>;
             mediatek,gce-client-reg = <&gce SUBSYS_1400XXXX 0xc000 0x1000>;
         };
     };
