+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include "mt8173.dtsi"
+
+/ {
+	model = "Amazon Fire HD 10 (2017)";
+	compatible = "mediatek,suez", "mediatek,mt8173";
+
+	/*
+	 * The vendor bootloader (LK) chooses which appended DTB to hand to the
+	 * kernel by board revision: shipping only the vendor "hvt" DTB does not
+	 * boot, shipping only the vendor "dvt" one does, and this unit reports
+	 * version = "dvt". A DTB LK does not select is silently ignored and the
+	 * kernel is never entered at all - which is why a mainline DTB carrying
+	 * neither property never got control.
+	 *
+	 * Setting both of these together is what LK accepts; which one alone is
+	 * sufficient has not been tested. Both are vendor-isms needed only to
+	 * get past LK - nothing in mainline binds to them - so they belong in
+	 * the boot-image packaging rather than here before any upstreaming.
+	 */
+	version = "dvt";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		stdout-path = "serial0:921600n8";
+
+		/*
+		 * The bootloader initialises the DSI panel to draw its logo and
+		 * leaves it running. Describing that framebuffer gives a working
+		 * console long before there is a display driver, which is the
+		 * only way to see anything on a device with no exposed UART.
+		 *
+		 * Base address and size were read back from the running vendor
+		 * kernel: the bootloader passes them in the ATAG_VIDEOLFB it
+		 * hands over. NOTE: System RAM stopping at 0xb4bbffff is true
+		 * of the *downstream* kernel, whose vendor DT reserves this
+		 * window; LK's rewritten /memory node does not, so we reserve
+		 * it ourselves in reserved-memory below.
+		 */
+		framebuffer@b4bc0000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0xb4bc0000 0 (1216 * 1920 * 4)>;
+			width = <1200>;
+			height = <1920>;
+			/*
+			 * Scanlines are padded to 1216 px (64-byte aligned):
+			 * the vendor mtkfb reports stride 4864, not 1200*4.
+			 * Getting this wrong shears the image 16 px per row.
+			 */
+			stride = <(1216 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 0 0x80000000>;
+	};
+
+	/*
+	 * Hall effect sensor, for the magnetic folio cover.
+	 *
+	 * The vendor describes it as a bare "hall,hall-sensor" node on pio 124
+	 * with IRQ_TYPE_LEVEL_LOW, which has no mainline driver; gpio-keys
+	 * reporting SW_LID is the mainline idiom, and mt8173-elm.dtsi does
+	 * exactly this for its own lid.
+	 *
+	 * Confirmed present on this unit before being described, because the
+	 * vendor DTS also lists parts that are not fitted (the STK3x1x and the
+	 * camera both fail to answer). Sampling the pin's input level through
+	 * the pinctrl register file while the folio was closed and reopened
+	 * gave 1 -> 0 on close and 0 -> 1 on open, so the sensor is real and
+	 * active low as the vendor says.
+	 *
+	 * Note pio 124 is KPCOL2, the keypad's third column. This board reuses
+	 * it for the hall sensor and only fits two keys, which is why the
+	 * keypad node above sees nothing on column 2.
+	 *
+	 * Deliberately NOT a wakeup-source, unlike elm: suspend has never been
+	 * exercised on this board and the reboot path already hangs, so arming
+	 * a wakeup here would be untested at best. systemd-logind would also
+	 * suspend on SW_LID by default, which is why
+	 * device-amazon-suez-mainline ships a HandleLidSwitch=ignore drop-in.
+	 * Revisit both together if suspend is ever made to work.
+	 */
+	lid-switch {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&hall_pins>;
+
+		switch-lid {
+			label = "Hall Effect Sensor";
+			gpios = <&pio 124 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			debounce-interval = <20>;
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * Deliberately NOT at 0x44400000. That window is the vendor
+		 * "ram_console", and TWRP's kernel re-initialises it on every
+		 * boot - which destroys the log in the very act of booting the
+		 * recovery you need in order to read it.
+		 *
+		 * Address chosen by measurement, not assumption. Dumped /dev/mem
+		 * from a booted downstream kernel: 0x90000000 (and 0x80000000)
+		 * read back readable and entirely zero, while 0x70000000,
+		 * 0xa0000000, 0xb0000000 and 0xb4000000 all held live data.
+		 *
+		 * Rejected candidates, all of which lose the log:
+		 *   0x44400000 - vendor "ram_console"; TWRP re-initialises it on
+		 *                boot, so booting the recovery you need in order to
+		 *                read the log is what destroys it.
+		 *   0x4bd00000 - vendor "mdump"; the vendor kernel puts its
+		 *                crash-dump handler *code* at the head, and the
+		 *                tail comes back zeroed.
+		 *   0xb4bc0000 - framebuffer carve-out; outside the vendor kernel's
+		 *                memory map, so /dev/mem cannot read it back.
+		 *
+		 * This is ordinary RAM rather than a vendor-reserved window, so
+		 * reserving it here keeps our kernel off it; the bet is that an
+		 * initramfs-only reader never allocates that high.
+		 */
+		ramoops@90000000 {
+			compatible = "ramoops";
+			reg = <0 0x90000000 0 0x80000>;
+			console-size = <0x40000>;
+			record-size = <0x8000>;
+			/*
+			 * The freezes on this board are completely silent: the
+			 * kernel stops with no oops and no warning, and the
+			 * softlockup detector never fires, so interrupts are
+			 * not being serviced either. pstore-ftrace records
+			 * function entries into this persistent region, so
+			 * after the reset the tail of the trace shows what the
+			 * CPU was executing when it died. Needs
+			 * CONFIG_PSTORE_FTRACE and CONFIG_FUNCTION_TRACER, and
+			 * must be enabled at runtime via
+			 * /sys/kernel/debug/pstore/record_ftrace.
+			 * Region budget: 0x80000 = console 0x40000 +
+			 * ftrace 0x20000 + dmesg records 0x8000 each.
+			 */
+			ftrace-size = <0x20000>;
+		};
+
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&pwrap {
+	pmic: pmic {
+		compatible = "mediatek,mt6397";
+		/*
+		 * EINT 5, not the 11 that mt8173-elm and mt8173-evb use. All three
+		 * suez board revisions (hvt/evt/dvt) route the PMIC interrupt to
+		 * EINT 5 in the vendor DTB. With 11 the parent line never fires --
+		 * /proc/interrupts shows mt6397-pmic on mt-eint 11 stuck at 0 -- so
+		 * no PMIC child interrupt is ever delivered, which costs the power
+		 * key and the RTC alarm.
+		 */
+		interrupts-extended = <&pio 5 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+
+		mt6397rtc: rtc {
+			compatible = "mediatek,mt6397-rtc";
+		};
+
+		mt6397clk: mt6397clock {
+			compatible = "mediatek,mt6397-clk";
+			#clock-cells = <1>;
+		};
+
+		mt6397pin: pinctrl {
+			compatible = "mediatek,mt6397-pinctrl";
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		mt6397keys: mt6397keys {
+			compatible = "mediatek,mt6397-keys";
+			mediatek,long-press-mode = <1>;
+			power-off-time-sec = <0>;
+
+			power {
+				linux,keycodes = <KEY_POWER>;
+				wakeup-source;
+			};
+		};
+
+		regulators {
+			compatible = "mediatek,mt6397-regulator";
+
+			mt6397_vpca15_reg: buck_vpca15 {
+				regulator-name = "vpca15";
+				regulator-min-microvolt = < 700000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12500>;
+				regulator-always-on;
+			};
+
+			mt6397_vpca7_reg: buck_vpca7 {
+				regulator-name = "vpca7";
+				regulator-min-microvolt = < 700000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12500>;
+				regulator-enable-ramp-delay = <115>;
+			};
+
+			mt6397_vsramca15_reg: buck_vsramca15 {
+				regulator-name = "vsramca15";
+				regulator-min-microvolt = < 700000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12500>;
+				regulator-always-on;
+			};
+
+			mt6397_vsramca7_reg: buck_vsramca7 {
+				regulator-name = "vsramca7";
+				regulator-min-microvolt = < 700000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12500>;
+				regulator-always-on;
+			};
+
+			mt6397_vcore_reg: buck_vcore {
+				regulator-name = "vcore";
+				regulator-min-microvolt = < 700000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12500>;
+				regulator-always-on;
+			};
+
+			mt6397_vgpu_reg: buck_vgpu {
+				regulator-name = "vgpu";
+				regulator-min-microvolt = < 700000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12500>;
+				regulator-enable-ramp-delay = <115>;
+			};
+
+			mt6397_vdrm_reg: buck_vdrm {
+				regulator-name = "vdrm";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1400000>;
+				regulator-ramp-delay = <12500>;
+				regulator-always-on;
+			};
+
+			mt6397_vio18_reg: buck_vio18 {
+				regulator-name = "vio18";
+				regulator-min-microvolt = <1620000>;
+				regulator-max-microvolt = <1980000>;
+				regulator-ramp-delay = <12500>;
