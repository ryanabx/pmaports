From b987686ad913440d06d465b2de9c117b6c191443 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Fri, 11 Sep 2026 10:47:48 -0500
Subject: [PATCH] drm/imagination: restart the watchdog if disabling the
 firmware fails

pvr_power_fw_disable() cancels the firmware watchdog before it does
anything that can fail, then returns early on three error paths without
putting it back. Nothing else restarts it: the only other
queue_delayed_work() for this work is in pvr_power_fw_enable(), which
those paths never reach, and the worker's own requeue only runs if the
worker ran.

The firmware is still going at that point. Neither a failed
pvr_power_request_idle() nor a failed pvr_power_request_pwr_off() stops
it, and a failed pvr_fw_stop() leaves it running by definition. So the
GPU carries on executing with no stall detection until something else
happens to take it through a successful resume, and a firmware stall in
that window is never noticed rather than triggering the hard reset it
should.

Requeue the watchdog on the way out of those paths.

Fixes: 727538a4bbff ("drm/imagination: Implement power management")
Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 drivers/gpu/drm/imagination/pvr_power.c | 23 +++++++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_power.c b/drivers/gpu/drm/imagination/pvr_power.c
index a71d5b356..bff08eee8 100644
--- a/drivers/gpu/drm/imagination/pvr_power.c
+++ b/drivers/gpu/drm/imagination/pvr_power.c
@@ -99,11 +99,11 @@ pvr_power_fw_disable(struct pvr_device *pvr_dev, bool hard_reset, bool rpm_suspe
 
 		err = pvr_power_request_idle(pvr_dev);
 		if (err)
-			return err;
+			goto err_requeue_watchdog;
 
 		err = pvr_power_request_pwr_off(pvr_dev);
 		if (err)
-			return err;
+			goto err_requeue_watchdog;
 	}
 
 	if (rpm_suspend) {
@@ -112,8 +112,23 @@ pvr_power_fw_disable(struct pvr_device *pvr_dev, bool hard_reset, bool rpm_suspe
 	}
 
 	err = pvr_fw_stop(pvr_dev);
-	if (err && rpm_suspend)
-		enable_irq(pvr_dev->irq);
+	if (err) {
+		if (rpm_suspend)
+			enable_irq(pvr_dev->irq);
+		if (!hard_reset)
+			goto err_requeue_watchdog;
+	}
+
+	return err;
+
+err_requeue_watchdog:
+	/*
+	 * The watchdog was cancelled above and nothing else restarts it until
+	 * pvr_power_fw_enable() runs, which on this path it never will. Put it
+	 * back, or the firmware is left running with no stall detection.
+	 */
+	queue_delayed_work(pvr_dev->sched_wq, &pvr_dev->watchdog.work,
+			   msecs_to_jiffies(WATCHDOG_TIME_MS));
 
 	return err;
 }
