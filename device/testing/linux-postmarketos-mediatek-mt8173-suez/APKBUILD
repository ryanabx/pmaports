# SIZE BUDGET (measured, do not exceed):
#   r27 without ftrace  = 27.71 MiB decompressed -> BOOTS
#   r28 with ftrace     = 28.84 MiB decompressed -> DOES NOT BOOT
#     (LK runs, shows the Amazon logo, never starts the kernel)
# So the real ceiling is between 27.71 and 28.84 MiB, NOT "28 to 32" as the
# comment below claims -- that older figure came from synthetic payloads.
# FUNCTION_TRACER costs +1.13 MiB, so built-in code had to be trimmed to pay
# for it. Note trimming sound/media/vcodec/mediatek-DRM saves NOTHING: they
# are all =m, and modules are not part of the Image.
# Kernel config based on: device/community/linux-postmarketos-mediatek-mt8173
maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=linux-postmarketos-mediatek-mt8173-suez
pkgver=7.1.8
pkgrel=20
pkgdesc="Mainline kernel fork for the Amazon Fire HD 10 (2017)"
arch="aarch64"
_carch="arm64"
_flavor="${pkgname#linux-}"
url="https://kernel.org"
license="GPL-2.0-only"
# This is a copy of linux-postmarketos-mediatek-mt8173 with a device tree for
# amazon-suez and a heavily trimmed config, for two reasons:
#
#  1. The boot partition (boot_x) is only 16 MiB.
#  2. The vendor bootloader cannot decompress a kernel larger than somewhere
#     between 28 and 32 MiB. This was measured on the device by booting
#     synthetic payloads of known size: 28 MiB runs, 32 MiB does not, at any
#     load address. A stock config decompresses to 35.4 MiB and therefore
#     never starts at all - the bootloader silently gives up and the watchdog
#     reboots, with no output anywhere.
#
# pmb:kconfigcheck-community is intentionally not set: it pulls in
# category:debug, which requires CONFIG_FUNCTION_TRACER, whose instrumentation
# is worth ~1 MiB here. kconfigcheck.toml explicitly allows dropping this
# option for devices in testing.
#
# KNOWN DEVIATION: CONFIG_DEBUG_INFO_BTF is disabled, which category:default
# requires, so "pmbootstrap kconfig check" fails on this package. BTF measures
# 6.00 MiB of the 35.4 MiB image (from __start_BTF/__stop_BTF in System.map),
# and without it the kernel cannot be made to fit under the bootloader's
# ceiling without gutting entire driver classes. This needs resolving before
# the port can be upstreamed - either with an exception for devices whose
# bootloader cannot load a BTF-sized kernel, or by chainloading U-Boot so the
# kernel is no longer loaded by the vendor bootloader at all.
options="!strip !check !tracedeps
	pmb:cross-native
"
makedepends="
	bash
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zstd
"

# Source
_config="config-$_flavor.$arch"
case $pkgver in
	*.*.*)	_kernver=${pkgver%.0};;
	*.*)	_kernver=$pkgver;;
esac
source="
	https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${pkgver//_/-}.tar.xz
	$_config
	0001-resolve_btfids-preserve-parameter-names-when-process.patch
	0003-display-blank.patch
	mtk-dsi-force-cmd-mode.patch
	add-amazon-suez-dts.patch
	mt6397-auxadc.patch
	mt6397-battery.patch
	mt8173-smp-mtcmos.patch
	panel-novatek-nt51021.patch
	mtk-ovl-reset-bootloader-handover.patch
	mt8173-disp-handover.patch
	mt6391-codec.patch
	mt8173-afe-adda.patch
	mt8173-mt6391-machine.patch
	powervr-mt8173-01-mfgtop-clk-binding.patch
	powervr-mt8173-02-mfgtop-clk-driver.patch
	powervr-mt8173-03-rogue-binding.patch
	powervr-mt8173-04-dtsi-mfg-async-clock.patch
	powervr-mt8173-05-dtsi-gpu-nodes.patch
"
builddir="$srcdir/linux-${_kernver//_/-}"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

