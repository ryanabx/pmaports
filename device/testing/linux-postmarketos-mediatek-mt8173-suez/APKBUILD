# Kernel config based on: device/community/linux-postmarketos-mediatek-mt8173
maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=linux-postmarketos-mediatek-mt8173-suez
pkgver=7.3.0_rc3
pkgrel=0
pkgdesc="Mainline kernel fork for the Amazon Fire HD 10 (2017)"
arch="aarch64"
_carch="arm64"
_flavor="${pkgname#linux-}"
url="https://kernel.org"
license="GPL-2.0-only"
# This is a copy of linux-postmarketos-mediatek-mt8173 with a device tree for
# amazon-suez and a heavily trimmed config, for two reasons:
#
#  1. The boot partition (boot_x) is only 16 MiB.
#  2. The vendor bootloader (LK) silently refuses to start a kernel whose
#     decompressed Image is too large: it runs, shows the Amazon logo, never
#     enters the kernel, and the watchdog reboots with no output anywhere.
#
# SIZE BUDGET (measured on the device, do not exceed):
#
#     27.71 MiB decompressed -> BOOTS
#     28.84 MiB decompressed -> DOES NOT BOOT
#
# so the ceiling is somewhere in between. Both figures are real builds of this
# aport differing only in CONFIG_FUNCTION_TRACER, which costs +1.13 MiB; an
# earlier "somewhere between 28 and 32 MiB" figure came from booting synthetic
# payloads and is superseded. A stock config decompresses to 35.4 MiB and
# therefore never starts at all.
#
# Trimming sound, media, vcodec or the MediaTek DRM driver saves NOTHING here:
# they are all =m, and modules are not part of the Image.
#
# pmb:kconfigcheck-community is intentionally not set: it pulls in
# category:debug, which requires CONFIG_FUNCTION_TRACER, whose instrumentation
# is worth ~1 MiB here. kconfigcheck.toml explicitly allows dropping this
# option for devices in testing.
#
# KNOWN DEVIATION: CONFIG_DEBUG_INFO_BTF and CONFIG_DEBUG_INFO_BTF_MODULES are
# disabled, which category:default requires. BTF measures 6.00 MiB of the
# 35.4 MiB image (from __start_BTF/__stop_BTF in System.map), and without it
# the kernel cannot be made to fit under the bootloader's ceiling documented
# above without gutting entire driver classes. That is not a config choice we
# can revisit: the ceiling is in the signed vendor bootloader.
#
# So this package sets !pmb:kconfigcheck, which makes "pmbootstrap kconfig
# check" skip it (with a NOTE) rather than fail. Run it anyway with -f, and
# please do when touching the config, because the flag switches off ALL of
# category:default, not just the two BTF symbols:
#
#   pmbootstrap kconfig check -f linux-postmarketos-mediatek-mt8173-suez
#
# Checked on 2026-09-10: that reports the two BTF errors and nothing else.
# The proper fix is either an upstream exception for devices whose bootloader
# cannot load a BTF-sized kernel, or chainloading U-Boot so the kernel is no
# longer loaded by the vendor bootloader at all; until then the flag is what
# keeps CI honest about the rest of the tree.
options="!strip !check !tracedeps !pmb:kconfigcheck
	pmb:cross-native
"
makedepends="
	bash
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zstd
"

# Source
#
# The kernel is a snapshot of the device branch of Ryan Brue's fork, which is
# the source of truth for the whole series (drivers, bindings, board DTS and
# the never-for-upstream MT6630 bring-up code alike). There are deliberately
# no patch files: the branch IS the series, one commit per patch, and it is
# what gets sent upstream. Bump _commit to move the device to a new snapshot.
#
# For iteration, build straight from the local tree instead of the snapshot:
#
#   pmbootstrap build --force --lax --src ~/repos/linux $pkgname
#
# (or `pmbroker kernel $pkgname`, which is configured to do exactly that).
# With --src, pmbootstrap empties source= and sha512sums= and rsyncs the tree
# into the chroot, honouring its .gitignore, so in-tree host build products
# are not copied. The snapshot below is only fetched for a plain build.
_config="config-$_flavor.$arch"
_author="ryanabx"
_repository="linux"
_branch="ryanabx/devices/amazon-suez"
_commit="2c2d9d39d160dfc63f7436b78581f1322e3eeda7"
source="
	$pkgname-$_commit.tar.gz::https://github.com/$_author/$_repository/archive/$_commit.tar.gz
	$_config
"
builddir="$srcdir/$_repository-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

