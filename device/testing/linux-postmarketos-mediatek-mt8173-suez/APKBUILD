# SIZE BUDGET (measured, do not exceed):
#   r27 without ftrace  = 27.71 MiB decompressed -> BOOTS
#   r28 with ftrace     = 28.84 MiB decompressed -> DOES NOT BOOT
#     (LK runs, shows the Amazon logo, never starts the kernel)
# So the real ceiling is between 27.71 and 28.84 MiB, NOT "28 to 32" as the
# comment below claims -- that older figure came from synthetic payloads.
# FUNCTION_TRACER costs +1.13 MiB, so built-in code had to be trimmed to pay
# for it. Note trimming sound/media/vcodec/mediatek-DRM saves NOTHING: they
# are all =m, and modules are not part of the Image.
# Kernel config based on: device/community/linux-postmarketos-mediatek-mt8173
maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=linux-postmarketos-mediatek-mt8173-suez
pkgver=7.2.2
pkgrel=50
pkgdesc="Mainline kernel fork for the Amazon Fire HD 10 (2017)"
arch="aarch64"
_carch="arm64"
_flavor="${pkgname#linux-}"
url="https://kernel.org"
license="GPL-2.0-only"
# This is a copy of linux-postmarketos-mediatek-mt8173 with a device tree for
# amazon-suez and a heavily trimmed config, for two reasons:
#
#  1. The boot partition (boot_x) is only 16 MiB.
#  2. The vendor bootloader cannot decompress a kernel larger than somewhere
#     between 28 and 32 MiB. This was measured on the device by booting
#     synthetic payloads of known size: 28 MiB runs, 32 MiB does not, at any
#     load address. A stock config decompresses to 35.4 MiB and therefore
#     never starts at all - the bootloader silently gives up and the watchdog
#     reboots, with no output anywhere.
#
# pmb:kconfigcheck-community is intentionally not set: it pulls in
# category:debug, which requires CONFIG_FUNCTION_TRACER, whose instrumentation
# is worth ~1 MiB here. kconfigcheck.toml explicitly allows dropping this
# option for devices in testing.
#
# KNOWN DEVIATION: CONFIG_DEBUG_INFO_BTF and CONFIG_DEBUG_INFO_BTF_MODULES are
# disabled, which category:default requires. BTF measures 6.00 MiB of the
# 35.4 MiB image (from __start_BTF/__stop_BTF in System.map), and without it
# the kernel cannot be made to fit under the bootloader's ceiling documented
# above without gutting entire driver classes. That is not a config choice we
# can revisit: the ceiling is in the signed vendor bootloader.
#
# So this package sets !pmb:kconfigcheck, which makes "pmbootstrap kconfig
# check" skip it (with a NOTE) rather than fail. Run it anyway with -f, and
# please do when touching the config, because the flag switches off ALL of
# category:default, not just the two BTF symbols:
#
#   pmbootstrap kconfig check -f linux-postmarketos-mediatek-mt8173-suez
#
# Checked on 2026-09-04: that reports the two BTF errors and nothing else.
# The proper fix is either an upstream exception for devices whose bootloader
# cannot load a BTF-sized kernel, or chainloading U-Boot so the kernel is no
# longer loaded by the vendor bootloader at all; until then the flag is what
# keeps CI honest about the rest of the tree.
options="!strip !check !tracedeps !pmb:kconfigcheck
	pmb:cross-native
"
makedepends="
	bash
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zstd
"

# Source
_config="config-$_flavor.$arch"
case $pkgver in
	*.*.*)	_kernver=${pkgver%.0};;
	*.*)	_kernver=$pkgver;;
esac
# The patch series is git-format-patch output from a git tree of the pristine
# tarball (one commit per patch, submission order), in three groups:
#   0001-0027      upstream-facing: bindings, drivers, fixes and the board DTS,
#                  one logical system per patch, every binding ahead of the
#                  patch that needs it; 0009 needs 0006 (both add an MFD cell
#                  to mt6397-core.c) and 0024 needs backport-0002.
#                  Regenerate with tools/export-series.py, which derives both
#                  the numbering and the source= order from the commit order
#                  in ~/suez-work/sweep/k722 so the two cannot drift
#   backport-*     Chen-Yu Tsai's mt8173 mfgtop/GPU series, merged in 7.3-rc1;
#                  drop when this aport moves to 7.3
#   local-*        never for upstream: the parent aport's resolve_btfids fix,
#                  the OVL block reset (belt and braces beside 0004), and the
#                  MT6630 bring-up drivers (an mt76 sub-driver rewrite pending)
source="
