	0009-mfd-mt6397-add-the-fuel-gauge-cell-for-the-MT6397.patch
	0010-power-supply-add-a-fuel-gauge-driver-for-the-MediaTe.patch
	0011-power-supply-bq24190_charger-do-not-reset-the-regist.patch
	0012-dt-bindings-arm-cpus-add-the-mediatek-mt8173-smp-ena.patch
	0013-arm64-smp-add-MediaTek-MT8173-CPU-operations-that-po.patch
	0014-dt-bindings-soc-mediatek-add-the-MT8173-SPM-suspend-.patch
	0015-soc-mediatek-add-suspend-to-RAM-through-the-MT8173-S.patch
	0016-ASoC-codecs-add-the-MediaTek-MT6391-PMIC-audio-codec.patch
	0017-ASoC-mediatek-mt8173-add-the-ADDA-DAI-towards-the-PM.patch
	0018-dt-bindings-sound-add-the-MT8173-sound-card-with-the.patch
	0019-ASoC-mediatek-add-the-MT8173-machine-driver-for-the-.patch
	0020-arm64-dts-mediatek-add-the-Amazon-Fire-HD-10-2017.patch
	backport-0001-dt-bindings-clock-mediatek-Add-mt8173-mfgtop.patch
	backport-0002-clk-mediatek-Add-mt8173-mfgtop-driver.patch
	backport-0003-dt-bindings-gpu-powervr-rogue-Add-MediaTek-MT8173-GP.patch
