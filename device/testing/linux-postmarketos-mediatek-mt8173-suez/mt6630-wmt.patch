+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Interface between the MT6630 WMT control-plane driver (SDIO function 2)
+ * and the WLAN driver (function 1).
+ */
+#ifndef _MT6630_WMT_H
+#define _MT6630_WMT_H
+
