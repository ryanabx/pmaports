From c32f5de528a5e2c7287040814462cdbec3742020 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Thu, 3 Sep 2026 14:09:44 -0500
Subject: [PATCH] dt-bindings: soc: mediatek: add the MT8173 SPM suspend-to-RAM
 node

The MT8173 System Power Manager (SPM) is a small sequencer inside the SCPSYS
block that takes the SoC into and out of suspend-to-RAM once every CPU is in
WFI. Boards that ship ARM Trusted Firmware drive it from EL3 through PSCI
SYSTEM_SUSPEND. Boards whose firmware predates PSCI 1.0 (Amazon's LK-based
MT8173 tablets, for one) have no SYSTEM_SUSPEND, so the kernel has to drive
the SPM itself, as the vendor kernel does.

Describe that as a child of the SCPSYS syscon, whose registers it shares
with the power controller. The node names the MCUCFG syscon (for the
ACINACTM bits asserted around the WFI), the MT6397 PMIC (whose CPU and core
rail hold bits are cleared for the duration), optionally the SPM's own
interrupt line, and optionally the SCP clock mux with its two parents, so
that clock can be parked on the crystal while the SPM stops the PLL it
normally runs from.

It is a board-level node on purpose: boards with ARM Trusted Firmware must
not have it, or two suspend implementations would drive the same hardware.

The node is a child of the scpsys syscon, which is already a simple-mfd with
a power-controller child, so mediatek,mt8195-scpsys.yaml -- the schema that
covers mediatek,mt8173-scpsys -- gains a reference to this one. Without that
the parent's additionalProperties: false rejects the child, and a board DTB
using it fails dtbs_check even though the child's own schema is satisfied.

Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 .../bindings/mfd/mediatek,mt8195-scpsys.yaml  |  6 ++
 .../mediatek/mediatek,mt8173-spm-suspend.yaml | 84 +++++++++++++++++++
 2 files changed, 90 insertions(+)
 create mode 100755 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt8173-spm-suspend.yaml

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt8195-scpsys.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt8195-scpsys.yaml
index 4cafa3819..2904d97e1 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt8195-scpsys.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt8195-scpsys.yaml
@@ -38,6 +38,12 @@ properties:
   power-controller:
     $ref: /schemas/power/mediatek,power-controller.yaml#
 
+  spm-suspend:
+    $ref: /schemas/soc/mediatek/mediatek,mt8173-spm-suspend.yaml#
+    description:
+      Suspend-to-RAM driven by the SPM from the kernel, for MT8173 platforms
+      whose firmware does not implement PSCI SYSTEM_SUSPEND.
+
 required:
   - compatible
   - reg
diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt8173-spm-suspend.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt8173-spm-suspend.yaml
new file mode 100755
index 000000000..32f6ac4a5
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt8173-spm-suspend.yaml
@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt8173-spm-suspend.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT8173 System Power Manager suspend-to-RAM
+
+maintainers:
+  - Ryan Brue <ryanbrue.dev@gmail.com>
+
+description:
+  The MT8173 System Power Manager (SPM) is a small sequencer inside the SCPSYS
+  block that takes the SoC into and out of suspend-to-RAM once every CPU is
+  in WFI. On boards that ship ARM Trusted Firmware this is driven from EL3
+  through PSCI SYSTEM_SUSPEND; boards whose firmware predates PSCI 1.0 have
+  to drive the SPM from the kernel. This node describes that case and is a
+  child of the SCPSYS syscon, whose registers it uses. Boards with ARM
+  Trusted Firmware must not have it.
+
+properties:
+  compatible:
+    const: mediatek,mt8173-spm-suspend
+
+  interrupts:
+    maxItems: 1
+    description: SPM IRQ0
+
+  clocks:
+    items:
+      - description: the SCP clock mux (scp_sel)
+      - description: the mux's normal parent (syspll1_d2)
+      - description: the 26 MHz crystal (clk26m)
+    description:
+      The SCP clock is parked on the crystal for the duration of a suspend,
+      because the SPM stops the PLL it normally runs from.
+
+  clock-names:
+    items:
+      - const: scp_sel
+      - const: syspll1_d2
+      - const: clk26m
+
+  mediatek,mcucfg:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The MCUCFG syscon, whose ACINACTM bits are asserted around the WFI so
+      the clusters report themselves idle to the SPM.
+
+  mediatek,pmic:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The MT6397 PMIC. Its CPU and core rail hold bits are cleared for the
+      duration of the suspend so those rails do not follow SRCLKEN down while
+      the CPU stays powered.
+
+required:
+  - compatible
+  - mediatek,mcucfg
+  - mediatek,pmic
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/clock/mt8173-clk.h>
+
+    syscon@10006000 {
+        compatible = "mediatek,mt8173-scpsys", "syscon", "simple-mfd";
+        reg = <0x10006000 0x1000>;
+
+        spm-suspend {
+            compatible = "mediatek,mt8173-spm-suspend";
+            interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_LOW>;
+            mediatek,mcucfg = <&mcucfg>;
+            mediatek,pmic = <&pmic>;
+            clocks = <&topckgen CLK_TOP_SCP_SEL>,
+                     <&topckgen CLK_TOP_SYSPLL1_D2>,
+                     <&clk26m>;
+            clock-names = "scp_sel", "syspll1_d2", "clk26m";
+        };
+    };
