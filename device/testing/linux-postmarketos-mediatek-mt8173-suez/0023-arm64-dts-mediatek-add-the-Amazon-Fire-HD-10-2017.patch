diff --git a/arch/arm64/boot/dts/mediatek/mt8173-amazon-suez.dts b/arch/arm64/boot/dts/mediatek/mt8173-amazon-suez.dts
new file mode 100644
index 000000000..2ada5d36f
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt8173-amazon-suez.dts
@@ -0,0 +1,2651 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright (c) 2026 Ryan Brue <ryanbrue.dev@gmail.com>
+ *
+ * Amazon Fire HD 10 (2017), codename "suez".
+ */
+
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include "mt8173.dtsi"
+
+/ {
+	model = "Amazon Fire HD 10 (2017)";
+	compatible = "amazon,suez", "mediatek,mt8173";
+
+	/*
+	 * The vendor bootloader (LK) chooses which appended DTB to hand to the
+	 * kernel by board revision: shipping only the vendor "hvt" DTB does not
+	 * boot, shipping only the vendor "dvt" one does, and this unit reports
+	 * version = "dvt". A DTB LK does not select is silently ignored and the
+	 * kernel is never entered at all - which is why a mainline DTB carrying
+	 * neither property never got control.
+	 *
+	 * Nothing in mainline binds to this property; it exists only so LK
+	 * selects the DTB. It is kept here because the DTB is appended to the
+	 * kernel image as-is; a packaging step that patched it in would be the
+	 * alternative.
+	 */
+	version = "dvt";
+
+	aliases {
+		/*
+		 * Without these the MMC host indices come from probe order, so
+		 * enabling the SD slot renamed the eMMC from mmcblk0 to
+		 * mmcblk1. That is not cosmetic: every flashing instruction
+		 * for this device addresses boot_x as /dev/mmcblk0p11, and
+		 * with the SD controller holding index 0 that path points at
+		 * the card slot instead. Pin them.
+		 */
+		mmc0 = &mmc0;
+		mmc1 = &mmc1;
+
+		serial0 = &uart0;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		stdout-path = "serial0:921600n8";
+
+		/*
+		 * The bootloader initialises the DSI panel to draw its logo and
+		 * leaves it running. Describing that framebuffer gives a working
+		 * console long before there is a display driver, which is the
+		 * only way to see anything on a device with no exposed UART.
+		 *
+		 * Base address and size were read back from the running vendor
+		 * kernel: the bootloader passes them in the ATAG_VIDEOLFB it
+		 * hands over. NOTE: System RAM stopping at 0xb4bbffff is true
+		 * of the *downstream* kernel, whose vendor DT reserves this
+		 * window; LK's rewritten /memory node does not, so we reserve
+		 * it ourselves in reserved-memory below.
+		 */
+		framebuffer@b4bc0000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0xb4bc0000 0 (1216 * 1920 * 4)>;
+			width = <1200>;
+			height = <1920>;
+			/*
+			 * Scanlines are padded to 1216 px (64-byte aligned):
+			 * the vendor mtkfb reports stride 4864, not 1200*4.
+			 * Getting this wrong shears the image 16 px per row.
+			 */
+			stride = <(1216 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 0 0x80000000>;
+	};
+
+	/*
+	 * The pack. Everything the gauge needs is on the fuel-gauge node below;
+	 * this node carries only what the power-supply core reads for the
+	 * generic properties. The figures are the vendor's for the Desay cell
+	 * this unit is fitted with (IDME productid2 0831 = BATTERY_ID_DSY;
+	 * ATL units read 0841), from suez_bat_setting.dtsi battery_dsy_setting:
+	 * q_max_pos_25 and the 25 C profile's end points. Nothing here is
+	 * measured on this board.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		voltage-min-design-microvolt = <3352000>;
+		voltage-max-design-microvolt = <4321000>;
+		charge-full-design-microamp-hours = <6348000>;
+		constant-charge-voltage-max-microvolt = <4352000>;
+	};
+
+	sound {
+		compatible = "mediatek,mt8173-mt6391";
+		mediatek,audio-codec = <&mt6397codec>;
+		/*
+		 * Capture comes from the RT5514 over I2S2, not from the MT6397.
+		 * The AFE carries that stream to I17/I18 -> O09/O10 -> VUL;
+		 * this adds the back end that lets that leg power up.
+		 */
+		mediatek,capture-codec = <&rt5514>;
+		mediatek,platform = <&afe>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&audio_pins_default>;
+	};
+
+	/*
+	 * Hall effect sensor, for the magnetic folio cover.
+	 *
+	 * The vendor describes it as a bare "hall,hall-sensor" node on pio 124
+	 * with IRQ_TYPE_LEVEL_LOW, which has no mainline driver; gpio-keys
+	 * reporting SW_LID is the mainline idiom, and mt8173-elm.dtsi does
+	 * exactly this for its own lid.
+	 *
+	 * Confirmed present on this unit before being described, because the
+	 * vendor DTS also lists parts that are not fitted (the STK3x1x and the
+	 * camera both fail to answer). Sampling the pin's input level through
+	 * the pinctrl register file while the folio was closed and reopened
+	 * gave 1 -> 0 on close and 0 -> 1 on open, so the sensor is real and
+	 * active low as the vendor says.
+	 *
+	 * Note pio 124 is KPCOL2, the keypad's third column. This board reuses
+	 * it for the hall sensor and only fits two keys, which is why the
+	 * keypad node sees nothing on column 2. The vendor gives the pin no
+	 * pin configuration and relies on the pad default; the pull-up in
+	 * hall_pins states that level explicitly.
+	 *
+	 * Deliberately not a wakeup-source, unlike elm: the power key is the
+	 * wake path on this board, and closing the cover suspends through
+	 * logind's default lid handling.
+	 */
+	lid-switch {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&hall_pins>;
+
+		switch-lid {
+			label = "Hall Effect Sensor";
+			gpios = <&pio 124 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			debounce-interval = <20>;
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * Deliberately NOT at 0x44400000. That window is the vendor
+		 * "ram_console", and TWRP's kernel re-initialises it on every
+		 * boot - which destroys the log in the very act of booting the
+		 * recovery you need in order to read it.
+		 *
+		 * Address chosen by measurement, not assumption. Dumped /dev/mem
+		 * from a booted downstream kernel: 0x90000000 (and 0x80000000)
+		 * read back readable and entirely zero, while 0x70000000,
+		 * 0xa0000000, 0xb0000000 and 0xb4000000 all held live data.
+		 *
+		 * Rejected candidates, all of which lose the log:
+		 *   0x44400000 - vendor "ram_console"; TWRP re-initialises it on
+		 *                boot, so booting the recovery you need in order to
+		 *                read the log is what destroys it.
+		 *   0x4bd00000 - vendor "mdump"; the vendor kernel puts its
+		 *                crash-dump handler *code* at the head, and the
+		 *                tail comes back zeroed.
+		 *   0xb4bc0000 - framebuffer carve-out; outside the vendor kernel's
+		 *                memory map, so /dev/mem cannot read it back.
+		 *
+		 * This is ordinary RAM rather than a vendor-reserved window, so
+		 * reserving it here keeps our kernel off it; the bet is that an
+		 * initramfs-only reader never allocates that high.
+		 */
+		ramoops@90000000 {
+			compatible = "ramoops";
+			reg = <0 0x90000000 0 0x80000>;
+			console-size = <0x40000>;
+			record-size = <0x8000>;
+			/*
+			 * Room for pstore-ftrace (enabled at runtime through
+			 * /sys/kernel/debug/pstore/record_ftrace), so a silent
+			 * hang leaves the tail of the function trace behind.
+			 * Budget: 0x80000 = console 0x40000 + ftrace 0x20000 +
+			 * dmesg records of 0x8000.
+			 */
+			ftrace-size = <0x20000>;
+		};
+
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&scpsys {
+	/*
+	 * Suspend-to-RAM. This board's firmware is PSCI 0.2, which predates
+	 * SYSTEM_SUSPEND, so the kernel is never given platform_suspend_ops
+	 * and /sys/power/mem_sleep offers only s2idle. mtk-spm-suspend drives
+	 * the SPM from the kernel instead, the way the vendor kernel does.
+	 *
+	 * This is deliberately a board property rather than something in
+	 * mt8173.dtsi: mt8173-elm and mt8173-oak ship ARM Trusted Firmware,
+	 * where BL31 does this same work at EL3, and adding the node there
+	 * would put two suspend implementations on the same hardware.
+	 */
+	spm_suspend: spm-suspend {
+		compatible = "mediatek,mt8173-spm-suspend";
+
+		/* SPM IRQ0, as the vendor's scpsys node has it (155..160). */
+		interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_LOW>;
+
+		/* MP0_AXI_CONFIG, for ACINACTM around the WFI */
+		mediatek,mcucfg = <&mcucfg>;
+
+		/*
+		 * The rails feeding the still-powered CPU must not follow
+		 * SRCLKEN down while the SoC is asleep.
+		 */
+		mediatek,pmic = <&pmic>;
+
+		/*
+		 * fscp_ck is parked on the crystal for the duration, because
+		 * the SPM stops the PLL it normally runs from.
+		 */
+		clocks = <&topckgen CLK_TOP_SCP_SEL>,
+			 <&topckgen CLK_TOP_SYSPLL1_D2>,
+			 <&clk26m>;
+		clock-names = "scp_sel", "syspll1_d2", "clk26m";
+	};
+};
+
+&pwrap {
+	pmic: pmic {
+		compatible = "mediatek,mt6397";
+		/*
+		 * EINT 5, not the 11 that mt8173-elm and mt8173-evb use. All three
+		 * suez board revisions (hvt/evt/dvt) route the PMIC interrupt to
+		 * EINT 5 in the vendor DTB. With 11 the parent line never fires --
+		 * /proc/interrupts shows mt6397-pmic on mt-eint 11 stuck at 0 -- so
+		 * no PMIC child interrupt is ever delivered, which costs the power
+		 * key and the RTC alarm.
+		 */
+		interrupts-extended = <&pio 5 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+
+		mt6397rtc: rtc {
+			compatible = "mediatek,mt6397-rtc";
+		};
+
+		mt6397clk: clocks {
+			compatible = "mediatek,mt6397-clk";
+			#clock-cells = <1>;
+		};
+
+		/*
+		 * The MT6391 audio codec, marketing name for the audio block
+		 * of this MT6397-family PMIC. Values from the vendor DTS
+		 * (all three board revisions agree): Class-D speaker mode,
+		 * ADC/DMIC warm-up times.
+		 */
+		mt6397codec: audio-codec {
+			compatible = "mediatek,mt6397-codec";
+			mediatek,speaker-mode = <0>;
+			mediatek,adc-warmup-time-us = <10000>;
+			mediatek,dmic-warmup-time-us = <45000>;
+		};
+
+		/*
+		 * The PMIC's auxiliary ADC. It is the only way to read the
+		 * battery voltage on this board: the SoC AUXADC channels are
+		 * board thermistors (the vendor's cust_adc.dtsi describes only
+		 * temperature0/1 plus an RF channel), and the BQ24297 is a
+		 * charger with no ADC, which is why bq24190-battery reports
+		 * neither voltage_now nor capacity. Channel 0 is the pack voltage
+		 * (through ISENSE, as the vendor measures it with a power-path
+		 * charger) and channel 1 the battery thermistor.
+		 */
+		pmic_auxadc: adc {
+			compatible = "mediatek,mt6397-auxadc";
+			#io-channel-cells = <1>;
+		};
+
+		/*
+		 * The PMIC's fuel gauge, running MediaTek's battery-meter
+		 * algorithm on the hardware coulomb counter, exactly as Fire OS
+		 * did (CONFIG_SOC_BY_HW_FG). Every number below is the vendor's
+		 * own tuning for the Desay pack in this unit, copied from
+		 * suez_bat_setting.dtsi battery_dsy_setting and the suez_1v0
+		 * defaults in mt_bm_data.c; none is measured here. The five
+		 * profiles are at -10, 0, 10, 25 and 50 C (the vendor's t0, t1,
+		 * t1_5, t2, t3); the OCV profiles are <depth-of-discharge %,
+		 * mV> and the resistance profiles <mOhm, mV>, 120 points each.
+		 * The battery NTC is on the PMIC's AUXADC hardware channel 3
+		 * (IIO index 1 of pmic_auxadc) behind a 24 kOhm pull-up to
+		 * 1.2 V (rbat_pull_up_r / rbat_pull_up_volt).
+		 */
+		fuel_gauge: battery {
+			compatible = "mediatek,mt6397-battery";
+			io-channels = <&pmic_auxadc 0>, <&pmic_auxadc 1>;
+			io-channel-names = "voltage", "temperature";
+			monitored-battery = <&battery>;
+			power-supplies = <&bq24297>;
+			mediatek,sense-resistor-milli-ohms = <10>;	/* r_fg_value */
+			mediatek,car-tune-value = <101>;
+			mediatek,ocv2cv-transform;
+			mediatek,step-of-qmax-milliamp-hours = <54>;
+			/* vendor cv_current 6000, in units of 0.1 mA */
+			mediatek,cv-current-microamp = <600000>;
+			mediatek,poweron-low-capacity-tolerance = <0>;
+			mediatek,ntc-pull-up-ohms = <24000>;
+			mediatek,ntc-pull-up-millivolt = <1200>;
+			mediatek,ntc-pull-down-ohms = <100000000>;
+			mediatek,profile-temperatures = <(-10) 0 10 25 50>;
+			mediatek,qmax-milliamp-hours = <5947 6141 6210 6348 6345>;
+			mediatek,qmax-high-current-milliamp-hours = <5739 5568 5936 6130 6133>;
+			mediatek,ntc-table = <(-20) 499900>,
+				<(-15) 371600>,
