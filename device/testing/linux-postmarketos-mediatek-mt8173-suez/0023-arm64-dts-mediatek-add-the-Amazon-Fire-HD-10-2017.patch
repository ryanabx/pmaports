+&i2c0 {
+	/*
+	 * The capacitive touch controller. The vendor DTS (identical across
+	 * suez hvt/evt/dvt) describes it as:
+	 *
+	 *   cap_touch@38 {
+	 *       compatible = "mediatek,cap_touch";
+	 *       reg = <0x38>;
+	 *       interrupt-parent = <&pio>;
+	 *       interrupts = <14 IRQ_TYPE_EDGE_FALLING>;
+	 *       rst-gpio = <&pio6397 12 0>;
+	 *   };
+	 *
+	 * and the vendor kernel builds it with CONFIG_TOUCHSCREEN_MTK_FT5726,
+	 * i.e. a FocalTech FT5726. Mainline's edt-ft5x06 covers that part under
+	 * the "evervision,ev-ft5726" compatible (mapped to edt_ft5506_data).
+	 *
+	 * Reset is active low: the vendor driver drives the line to 0 to assert
+	 * reset and 1 to release it, so the mainline binding -- which requests
+	 * the GPIO as GPIOD_OUT_HIGH meaning "asserted" -- needs
+	 * GPIO_ACTIVE_LOW. It hangs off the PMIC's own pinctrl, which
+	 * registers a gpiochip (41 GPIOs on mt6397-pinctrl).
+	 *
+	 * Supplies come from the vendor's &touch node: vtouch -> vgp3,
+	 * vtouchio -> vgp4.
+	 *
+	 * i2c0 only needs status = "okay"; mt8173.dtsi already supplies
+	 * pinctrl-0 = <&i2c0_pins_a>.
+	 *
+	 * Deliberately no touchscreen-size-x/y: edt-ft5x06 reads the geometry
+	 * from the chip, and the vendor's tpd-resolution = <720 1280> does not
+	 * match this 1200x1920 panel, so it is not a trustworthy source. Add
+	 * size/inversion/swap properties only if the axes actually come out
+	 * wrong.
+	 */
+	status = "okay";
+	/* vendor &i2c0: 400 kHz */
+	clock-frequency = <400000>;
+
+	touchscreen@38 {
+		compatible = "evervision,ev-ft5726";
+		reg = <0x38>;
+		interrupt-parent = <&pio>;
+		interrupts = <14 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&mt6397pin 12 GPIO_ACTIVE_LOW>;
+		vcc-supply = <&mt6397_vgp3_reg>;
+		iovcc-supply = <&mt6397_vgp4_reg>;
+
+		/*
+		 * These are not optional on an Evervision part. edt-ft5x06
+		 * sizes its axes as num_x * 64 - 1, and for EV_FT it sets
+		 * reg_num_x/reg_num_y to NO_REGISTER -- there is no register
+		 * it can read the sensor counts from -- so num_x and num_y
+		 * keep EDT_DEFAULT_NUM_X/Y, which are 1024. That reports
+		 * ABS_MT_POSITION_X/Y as 0..65535 on a 1200x1920 panel, and
+		 * every touch lands in the top-left corner: a press at the
+		 * middle of the screen reports ~600, which against a declared
+		 * 65535 is under 1% across.
+		 *
+		 * The chip itself reports native panel coordinates. Measured
+		 * by tapping the four corners and logging the raw events:
+		 * top-left (33..75, 38..107), top-right (1149..1163, 33..80),
+		 * bottom-left (33..85, 1856..1895), bottom-right
+		 * (1178..1184, 1876..1896). So X spans 0..1200 and Y spans
+		 * 0..1920 exactly as the panel does, with no swap and no
+		 * inversion -- only the declared maximum was wrong.
+		 *
+		 * touchscreen_parse_properties() sets max = size - 1, giving
+		 * 1199 and 1919. It runs before input_mt_init_slots(), so the
+		 * single-touch ABS_X/ABS_Y axes inherit the corrected values.
+		 */
+		touchscreen-size-x = <1200>;
+		touchscreen-size-y = <1920>;
+	};
+
+	/*
+	 * The RT5514 "smart microphone" DSP. The internal microphone is an
+	 * analog part on its AMICL input, not on the MT6397 -- which is why
+	 * capturing through the PMIC's own ADDA returns a constant rather than
+	 * audio -- and the RT5514 hands it to the SoC over I2S2. Its PDM pins
+	 * are unused: both DMIC pairs read as a constant.
+	 *
+	 * From suez_dvt.dts, which gives it two buses:
+	 *
+	 *   rt5514: audio-codec@57 { compatible = "realtek,rt5514";
+	 *                            reg = <0x57>;
+	 *                            interrupts = <0 IRQ_TYPE_LEVEL_HIGH>; }
+	 *   rt5514_spi: audio-codec@0 { spi-max-frequency = <18000000>; }
+	 *
+	 * Only the i2c half is described here. The SPI half exists solely to
+	 * load and drive the on-chip DSP for always-on hotword detection;
+	 * plain I2S capture needs neither, so porting it is a separate job.
+	 * Verified fitted on this unit: 0x57 ACKs on i2c-0.
+	 */
+	rt5514: audio-codec@57 {
+		compatible = "realtek,rt5514";
+		reg = <0x57>;
+		interrupt-parent = <&pio>;
+		interrupts = <0 IRQ_TYPE_LEVEL_HIGH>;
+		#sound-dai-cells = <0>;
+	};
+};
+
+&i2c1 {
+	/*
+	 * MT6311 external PMIC. Upstream mt8173-elm/evb feed the A72 cluster
+	 * from a da9211; this board uses an MT6311 instead, which mainline
+	 * already supports (drivers/regulator/mt6311-regulator.c). Values match
+	 * both the vendor DTS and the mainline binding example.
+	 */
+	status = "okay";
+	/* vendor &i2c1 drives the bus push-pull */
+	mediatek,use-push-pull;
+
+	mt6311: pmic@6b {
+		compatible = "mediatek,mt6311-regulator";
+		reg = <0x6b>;
+
+		regulators {
+			/*
+			 * The A72 cluster supply. The vendor calls it
+			 * reg-ext-vpca57-supply; mainline mt8173-evb feeds the
+			 * same rail from a da9211, which this board does not
+			 * have.
+			 *
+			 * Give it the part's true range and let cpufreq do the
+			 * work. mediatek-cpufreq couples this against the A72's
+			 * Vsram (vsramca7) and must keep
+			 * 100mV < Vsram - Vproc < 200mV; constraining Vproc to a
+			 * single voltage defeats mtk_cpufreq_voltage_tracking()
+			 * and makes the machine hang under sustained four-core
+			 * load within a minute. With the real range it runs at
+			 * 2106000 indefinitely.
+			 *
+			 * Note 1400000 -- from both the vendor DTS and the
+			 * mainline binding example -- is NOT reachable: the
+			 * driver's range is 600000 + 6250 * 127 = 1393750.
+			 */
+			mt6311_vcpu_reg: VDVFS {
+				regulator-name = "VDVFS";
+				regulator-min-microvolt = <600000>;
+				regulator-max-microvolt = <1393750>;
+				regulator-ramp-delay = <10000>;
+				/*
+				 * always-on is ours, not the vendor's: this is
+				 * the A72's Vproc, coupled to vsramca7 above,
+				 * and the pair is kept up for the same reason.
+				 */
+				regulator-always-on;
+			};
+
+			/*
+			 * No VBIASN node. mt6311-regulator describes that LDO
+			 * with no n_voltages, min_uV or vsel_reg -- it is
+			 * enable-only -- so the voltage constraints in the
+			 * binding example make regulator_register() return
+			 * -EINVAL and take the whole chip down with it:
+			 *   mt6311 1-006b: Failed to register MT6311 regulator
+			 *   mt6311 1-006b: probe ... failed with error -22
+			 * The regulator is still registered by the driver; it
+			 * simply gets no constraints from DT.
+			 */
+		};
+	};
+};
+
+&mmc0 {
+	status = "okay";
+	pinctrl-names = "default", "state_uhs";
+	pinctrl-0 = <&mmc0_pins_default>;
+	pinctrl-1 = <&mmc0_pins_uhs>;
+	bus-width = <8>;
+	max-frequency = <200000000>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	/*
+	 * HS400. The vendor DTS for this board enables it with exactly the
+	 * delay values below, and upstream mt8173-elm uses the identical set --
+	 * two independent trees agreeing makes these SoC-level rather than
+	 * board-level numbers. The vendor spells them hs400_cmd_int_delay and
+	 * cmd_resp_sel = <0> (0 meaning rising); mainline's names are used here.
+	 *
+	 * Verified on hardware: the controller reports "mmc0: new HS400 MMC
+	 * card" and cold sequential reads roughly double, to 278 MB/s.
+	 */
+	mmc-hs400-1_8v;
+	hs400-ds-delay = <0x14015>;
+	cap-mmc-hw-reset;
+	mediatek,hs200-cmd-int-delay = <30>;
+	mediatek,hs400-cmd-int-delay = <14>;
+	mediatek,hs400-cmd-resp-sel-rising;
+	vmmc-supply = <&mt6397_vemc_3v3_reg>;
+	vqmmc-supply = <&mt6397_vio18_reg>;
+	/*
+	 * Reparent the MSDC50_0 mux to MSDCPLL_D2. Both the vendor DTB for
+	 * this board and upstream mt8173-elm do this; without it the
+	 * controller runs from the mux's power-on parent and the card fails
+	 * to initialise with -EILSEQ (-84) during HS200 tuning.
+	 */
+	assigned-clocks = <&topckgen CLK_TOP_MSDC50_0_SEL>;
+	assigned-clock-parents = <&topckgen CLK_TOP_MSDCPLL_D2>;
+	non-removable;
+};
+
+/*
+ * The microSD slot. The vendor DTS describes it identically to upstream
+ * mt8173-elm: card detect on pio 1, VMCH/VMC from the PMIC, four bits,
+ * SDR50/SDR104. Two independent trees agreeing is what makes these SoC-level
+ * rather than board-level values -- the same reasoning used for the eMMC's
+ * HS400 tuning.
+ */
+&mmc1 {
+	status = "okay";
+	pinctrl-names = "default", "state_uhs";
+	pinctrl-0 = <&mmc1_pins_default>;
+	pinctrl-1 = <&mmc1_pins_uhs>;
+	bus-width = <4>;
+	max-frequency = <200000000>;
+	cap-sd-highspeed;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+	/*
+	 * Card present is HIGH on this board. upstream mt8173-elm says
+	 * GPIO_ACTIVE_LOW and the vendor DTS says <&pio 1 0>; the vendor is
+	 * right here. Measured by watching the pin through the pinctrl
+	 * register file: removing the card drove pio 1 from 1 to 0 and
+	 * reinserting it drove 0 to 1.
+	 *
+	 * Getting this backwards is not a no-op -- it inverts the meaning of
+	 * every insertion, so the core powers the slot up and runs the whole
+	 * CMD55/CMD1 identification sequence at the instant the card is
+	 * *removed*, times every command out, and powers back down when one
+	 * is actually inserted.
+	 */
+	cd-gpios = <&pio 1 GPIO_ACTIVE_HIGH>;
+	vmmc-supply = <&mt6397_vmch_reg>;
+	vqmmc-supply = <&mt6397_vmc_reg>;
+	/*
+	 * The vendor gives this slot a command internal delay of 4
+	 * (hs200_cmd_int_delay in suez_dvt.dts); upstream mt8173-elm sets none.
+	 * Despite the HS200 name it is the delay used for SDR104 too -- mtk-sd
+	 * says so where it declares the field -- and this slot runs SDR104, so
+	 * the value applies. Taking the vendor's number rather than leaving the
+	 * field at its zero default.
+	 */
+	mediatek,hs200-cmd-int-delay = <4>;
+};
+
+&pio {
+	/*
+	 * I2S2, which is how the RT5514 delivers the internal microphones.
+	 * The pins are the I2S0 group muxed to their I2S2 functions, exactly
+	 * as suez_dvt.dts's audio_pins_default does. MCK is included because
+	 * the RT5514 takes its 12.288 MHz master clock from the SoC.
+	 */
+	audio_pins_default: audio-default-pins {
+		pins-i2s2 {
+			pinmux = <MT8173_PIN_128_I2S0_LRCK__FUNC_I2S2_WS>,
+				 <MT8173_PIN_129_I2S0_BCK__FUNC_I2S2_BCK>,
+				 <MT8173_PIN_130_I2S0_MCK__FUNC_I2S2_MCK>,
+				 <MT8173_PIN_132_I2S0_DATA1__FUNC_I2S2_DI_2>;
+			bias-pull-down;
+		};
+	};
+
+	/*
+	 * microSD pin settings are the vendor's (suez_dvt.dts mmc1 groups):
+	 * pull selects R1R0_01 on cmd/data and R1R0_10 on the clock, and
+	 * 10 mA drive in the UHS state.
+	 */
+	mmc1_pins_default: mmc1-default-pins {
+		pins-cmd-dat {
+			pinmux = <MT8173_PIN_73_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
+				 <MT8173_PIN_74_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
+				 <MT8173_PIN_75_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
+				 <MT8173_PIN_76_MSDC1_DAT3__FUNC_MSDC1_DAT3>,
+				 <MT8173_PIN_78_MSDC1_CMD__FUNC_MSDC1_CMD>;
+			input-enable;
+			drive-strength = <4>;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+
+		pins-clk {
+			pinmux = <MT8173_PIN_77_MSDC1_CLK__FUNC_MSDC1_CLK>;
+			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
+			drive-strength = <4>;
+		};
+
+		pins-insert {
+			pinmux = <MT8173_PIN_1_EINT1__FUNC_GPIO1>;
+			bias-pull-up;
+		};
+	};
+
+	mmc1_pins_uhs: mmc1-uhs-pins {
+		pins-cmd-dat {
+			pinmux = <MT8173_PIN_73_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
+				 <MT8173_PIN_74_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
+				 <MT8173_PIN_75_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
+				 <MT8173_PIN_76_MSDC1_DAT3__FUNC_MSDC1_DAT3>,
+				 <MT8173_PIN_78_MSDC1_CMD__FUNC_MSDC1_CMD>;
+			input-enable;
+			drive-strength = <10>;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+
+		pins-clk {
+			pinmux = <MT8173_PIN_77_MSDC1_CLK__FUNC_MSDC1_CLK>;
+			drive-strength = <10>;
+			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
+		};
+	};
+
+	mmc0_pins_default: mmc0-default-pins {
+		pins-cmd-dat {
+			pinmux = <MT8173_PIN_57_MSDC0_DAT0__FUNC_MSDC0_DAT0>,
+				 <MT8173_PIN_58_MSDC0_DAT1__FUNC_MSDC0_DAT1>,
+				 <MT8173_PIN_59_MSDC0_DAT2__FUNC_MSDC0_DAT2>,
+				 <MT8173_PIN_60_MSDC0_DAT3__FUNC_MSDC0_DAT3>,
+				 <MT8173_PIN_61_MSDC0_DAT4__FUNC_MSDC0_DAT4>,
+				 <MT8173_PIN_62_MSDC0_DAT5__FUNC_MSDC0_DAT5>,
+				 <MT8173_PIN_63_MSDC0_DAT6__FUNC_MSDC0_DAT6>,
+				 <MT8173_PIN_64_MSDC0_DAT7__FUNC_MSDC0_DAT7>,
+				 <MT8173_PIN_66_MSDC0_CMD__FUNC_MSDC0_CMD>;
+			input-enable;
+			bias-pull-up;
+		};
+
+		pins-clk {
+			pinmux = <MT8173_PIN_65_MSDC0_CLK__FUNC_MSDC0_CLK>;
+			bias-pull-down;
+		};
+
+		pins-rst {
+			pinmux = <MT8173_PIN_68_MSDC0_RST___FUNC_MSDC0_RSTB>;
+			bias-pull-up;
+		};
+	};
+
+	hall_pins: hall-pins {
+		pins-hall {
+			pinmux = <MT8173_PIN_124_KPCOL2__FUNC_GPIO124>;
+			input-enable;
+			bias-pull-up;
+		};
+	};
+
+	/* vendor bq24297_int_pin: GPIO9, input, pull-up */
+	charger_pins: charger-pins {
+		pins-int {
+			pinmux = <MT8173_PIN_9_EINT9__FUNC_GPIO9>;
+			input-enable;
+			bias-pull-up;
+		};
+	};
+
+	mmc0_pins_uhs: mmc0-uhs-pins {
+		pins-cmd-dat {
+			pinmux = <MT8173_PIN_57_MSDC0_DAT0__FUNC_MSDC0_DAT0>,
+				 <MT8173_PIN_58_MSDC0_DAT1__FUNC_MSDC0_DAT1>,
+				 <MT8173_PIN_59_MSDC0_DAT2__FUNC_MSDC0_DAT2>,
+				 <MT8173_PIN_60_MSDC0_DAT3__FUNC_MSDC0_DAT3>,
+				 <MT8173_PIN_61_MSDC0_DAT4__FUNC_MSDC0_DAT4>,
+				 <MT8173_PIN_62_MSDC0_DAT5__FUNC_MSDC0_DAT5>,
+				 <MT8173_PIN_63_MSDC0_DAT6__FUNC_MSDC0_DAT6>,
+				 <MT8173_PIN_64_MSDC0_DAT7__FUNC_MSDC0_DAT7>,
+				 <MT8173_PIN_66_MSDC0_CMD__FUNC_MSDC0_CMD>;
+			input-enable;
+			drive-strength = <6>;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+
+		pins-clk {
+			pinmux = <MT8173_PIN_65_MSDC0_CLK__FUNC_MSDC0_CLK>;
+			drive-strength = <6>;
+			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
+		};
+
+		pins-ds {
+			pinmux = <MT8173_PIN_67_MSDC0_DSL__FUNC_MSDC0_DSL>;
+			drive-strength = <8>;
+			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
+		};
+
+		pins-rst {
+			pinmux = <MT8173_PIN_68_MSDC0_RST___FUNC_MSDC0_RSTB>;
+			bias-pull-up;
+		};
+	};
+};
+
+/*
+ * The vendor runs the port dual-role with ID detection on pio 16. Peripheral
+ * only here: the tablet has one micro-B port, which is also its charging
+ * input, and host mode has not been brought up.
+ */
+&ssusb {
+	vusb33-supply = <&mt6397_vusb_reg>;
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	status = "okay";
+};
+
+&{/soc} {
+	/*
+	 * mt8173.dtsi has no MCUCFG node, but powering the A72 cluster needs
+	 * CA15L_MISCDBG to deassert ACINACTM. Naming follows mt2712e.dtsi's
+	 * "mediatek,mt2712-mcucfg", "syscon".
+	 */
+	mcucfg: syscon@10200000 {
+		compatible = "mediatek,mt8173-mcucfg", "syscon";
+		reg = <0 0x10200000 0 0x1000>;
+	};
+
+	/*
+	 * The keypad controller, which carries the volume rocker. mt8173.dtsi
+	 * does not describe it at all, and mainline has no mt8173 keypad
+	 * driver -- but mt6779-keypad drives this block unmodified, so the
+	 * node only needs the fallback compatible. Everything below was
+	 * measured on this unit rather than assumed:
+	 *
+	 *   - The block is register-compatible. LK leaves it enabled and the
+	 *     vendor's hal_kpd.h agrees offset for offset (STA 0x00,
+	 *     MEM1..5 0x04..0x14, DEBOUNCE 0x18, SEL 0x20, EN 0x24), and
+	 *     KP_MEM1..4 read 0x0000ffff / KP_MEM5 0x000000ff -- i.e. 16
+	 *     valid bits per register, 72 keys, exactly what mt6779-keypad
+	 *     already assumes and what the vendor spells KPD_NUM_KEYS.
+	 *
+	 *   - Pressing a key clears its bit in eight places at a stride of
+	 *     nine (key 0,9,18..63 for one, 1,10,19..64 for the other), so
+	 *     mt6779-keypad's single-group mapping -- row = key / 9,
+	 *     col = key % 9 -- is right for this SoC too, and both keys sit
+	 *     on row 0.
+	 *
+	 * num-rows/num-columns describe the *bit layout*, not the two keys
+	 * actually fitted. A press asserts all eight row slots of its column
+	 * even when KP_SEL enables a single row (verified by reprogramming
+	 * KP_SEL and re-measuring), and the interrupt handler maps every
+	 * changed bit through MATRIX_SCAN_CODE before looking it up. Declaring
+	 * one row would therefore index past the end of the keymap; 8x9 keeps
+	 * every possible (row, col) inside it, and the unfitted positions stay
+	 * KEY_RESERVED and are dropped by the input core. Enabling the full
+	 * geometry costs nothing: with KP_SEL at 0xfff0 the idle state is
+	 * still all ones, so no unconnected line reads as pressed.
+	 *
+	 * The keys are the other way round from the vendor's
+	 * mediatek,kpd-hw-init-map, which maps hw key 0 to KEY_VOLUMEUP and
+	 * hw key 1 to KEY_VOLUMEDOWN. On this unit pressing volume up moved
+	 * column 1 and volume down moved column 0. The measurement is used
+	 * here; if it ever feels inverted, swap these two lines and confirm
+	 * with evtest -- that is the whole fix.
+	 *
+	 * debounce-delay-ms is LK's KP_DEBOUNCE of 0x400 expressed in the
+	 * driver's units: it writes debounce * 32, and 32 * 32 = 1024, which
+	 * is also the vendor's mediatek,kpd-key-debounce.
+	 */
+	keypad: keypad@10010000 {
+		compatible = "mediatek,mt8173-keypad",
+			     "mediatek,mt6779-keypad";
+		reg = <0 0x10010000 0 0x1000>;
+		interrupts = <GIC_SPI 154 IRQ_TYPE_EDGE_FALLING>;
+		clocks = <&infracfg CLK_INFRA_KP>;
+		clock-names = "kpd";
+		wakeup-source;
+		debounce-delay-ms = <32>;
+		keypad,num-rows = <8>;
+		keypad,num-columns = <9>;
+		linux,keymap = <MATRIX_KEY(0, 0, KEY_VOLUMEDOWN)
+				MATRIX_KEY(0, 1, KEY_VOLUMEUP)>;
+	};
+};
+
+&cpu0 {
+	proc-supply = <&mt6397_vpca15_reg>;
+};
+
+&cpu1 {
+	proc-supply = <&mt6397_vpca15_reg>;
+
+	/*
+	 * PSCI CPU_ON alone does not start this core. The firmware sets the
+	 * entry point but leaves the core's MTCMOS power domain off, so it
+	 * never runs:
+	 *   CPU1: failed to come online
+	 *   CPU1: failed in unknown state : 0x0
+	 * (plain "spin-table" at the vendor's cpu-release-addr fails the same
+	 * way, because the core is powered down rather than parked.)
+	 *
+	 * The vendor kernel's "mt-boot" is just PSCI CPU_ON followed by
+	 * spm_mtcmos_ctrl_cpu(cpu, STA_POWER_ON, 1); mt8173-smp-mtcmos.patch
+	 * adds that as a mainline enable-method. Boards with real ARM Trusted
+	 * Firmware (mt8173-elm) do not need it because BL31 powers the domain.
+	 *
+	 * The A72s below use the same method; their cluster sequence differs
+	 * (shared SPM_CA15_L1_PWR_CON, CPUTOP and L2 domains) and their supply
+	 * is the MT6311 on i2c1.
+	 */
+	enable-method = "mediatek,mt8173-smp";
+};
+
+/*
+ * The A72s. proc-supply is the MT6311 above, matching what mt8173-evb does with
+ * its da9211; sram-supply is vsramca7, as on evb. The MT6311 is an i2c
+ * regulator whose driver probes long after smp_init(), so the cores first run
+ * at the voltage the bootloader left on the rail; cpufreq takes over once the
+ * regulator is up.
+ */
+&cpu2 {
+	proc-supply = <&mt6311_vcpu_reg>;
+	sram-supply = <&mt6397_vsramca7_reg>;
+	enable-method = "mediatek,mt8173-smp";
+};
+
+&cpu3 {
+	proc-supply = <&mt6311_vcpu_reg>;
+	sram-supply = <&mt6397_vsramca7_reg>;
+	enable-method = "mediatek,mt8173-smp";
+};
+
+/*
+ * Display.
+ *
+ * mt8173.dtsi ships dsi0 and dpi0 as status = "disabled", and mediatek-drm
+ * will not build a CRTC without them:
+ *
+ *   Not creating crtc 0 because component 14 is disabled or missing
+ *   Not creating crtc 0 because component 10 is disabled or missing
+ *   Need at least one OVL device
+ *
+ * Component 14 is DDP_COMPONENT_DSI0 and 10 is DDP_COMPONENT_DPI0; the rest of
+ * mt8173's main path (ovl0, color0, aal0, od0, rdma0, ufoe) is already enabled
+ * by the dtsi and binds. Only dsi0 is enabled here -- dpi0 feeds the HDMI
+ * bridge, which this board does not bring out.
+ *
+ * The simple-framebuffer in /chosen stays alongside this: mediatek-drm is a
+ * module, so the bootloader's framebuffer is the console until it loads, and a
+ * panel that fails to light does not also cost the console.
+ */
+
+/ {
+	/*
+	 * The backlight's enable pin hangs off the PMIC's own GPIO 14 (vendor
+	 * gpio_en = <&pio6397 14 0>). lp855x wants an enable *regulator*
+	 * rather than a GPIO, so wrap the pin in a fixed regulator.
+	 */
+	backlight_enable: regulator-backlight-enable {
+		compatible = "regulator-fixed";
+		regulator-name = "backlight_enable";
+		gpio = <&mt6397pin 14 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+/*
+ * Sensors and charger.
+ *
+ * Every part below was confirmed on the live device by reading its ID register
+ * over /dev/i2c before any of this was written, rather than trusting the vendor
+ * DTS -- which lists parts this board does not fit:
+ *
+ *   BMA253   i2c2 @0x18   CHIP_ID 0xfa
+ *   BQ24297  i2c3 @0x6b   REG0A 0x20; REG08 read 0x6c with the cable in, i.e.
+ *                         "VBUS = USB host, fast charging, power good"
+ *   LTR559   i2c4 @0x23   PART_ID 0x92, MANUFAC_ID 0x05 (Lite-On)
+ *
+ * The vendor also describes an STK3x1x alsps at i2c4 0x48 and a camera at
+ * i2c3 0x3c. Neither answers on this unit, so neither is described here.
+ */
+&i2c2 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	/*
+	 * Bosch BMA253. The vendor calls it "mediatek,gsensor" and selects it
+	 * with CONFIG_MTK_BMA253; mainline's bmc150-accel covers the part.
+	 * No interrupt is described: the vendor node has none, and the driver
+	 * is happy polling.
+	 */
+	accelerometer@18 {
+		compatible = "bosch,bma253";
+		reg = <0x18>;
+		/*
+		 * Derived empirically (guided rotation test, 2026-08-30): the
+		 * chip is mounted rotated 180 degrees about the (1,-1,0) axis
+		 * relative to the panel. Raw readings were +X = g when the
+		 * tablet is upright and -Z = g face-up; with this matrix
+		 * iio-sensor-proxy reports normal/left-up correctly. Consistent
+		 * with the vendor's hwmsen "direction = <5>" (swap X/Y,
+		 * invert Z) once the Android landscape frame is rotated into
+		 * this panel's portrait frame.
+		 */
+		mount-matrix = "0", "-1", "0",
+			       "-1", "0", "0",
+			       "0", "0", "-1";
+	};
+};
+
+&i2c3 {
+	status = "okay";
+
+	/*
+	 * TI BQ24297 charger. The vendor compatible "ti,bq24297" is also
+	 * exactly what mainline's bq24190_charger matches on, so this node is
+	 * the vendor's, minus its MTK-specific properties.
+	 */
+	bq24297: charger@6b {
+		compatible = "ti,bq24297";
+		reg = <0x6b>;
+		interrupt-parent = <&pio>;
+		interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&charger_pins>;
+
+		/*
+		 * Suppress the driver's deprecated "battery" power supply.
+		 * bq24190_charger.c registers it purely for backwards
+		 * compatibility and offers this property to hide it:
+		 *
+		 *     the battery class is deprecated and will be removed;
+		 *     in the interim, this property hides it --
+		 *     if (!device_property_read_bool(dev, "omit-battery-class"))
+		 *
+		 * Hiding it matters here because it is a phantom: this part is
+		 * a charger with no fuel gauge, so bq24190-battery exposes
+		 * status and scope and nothing else -- no present, no capacity,
+		 * no energy_*. upower 1.91 still counts it as a real battery
+		 * ("present: yes, energy-full: 0 Wh"), computes
+		 * energy / energy_full = 0 / 0, and logs
+		 *   value "nan" ... is invalid or out of range for 'percentage'
+		 * twice every five seconds forever. That polling is also what
+		 * generates the endless kernel warning
+		 *   bq24190-charger 3-006b: warning: .../bq24190-battery is deprecated
+		 * -- 120 of them in 890 s, measured.
+		 *
+		 * The real gauge is mt6397-battery, which reports properly.
+		 */
+		omit-battery-class;
+	};
+};
+
+&i2c4 {
+	/*
+	 * TI LP8557 backlight. Every value here is from the vendor's
+	 * &lp8557_bl node: register-based control (mode = <1>), dev-ctrl 0x47
+	 * (LP8557_COMB2_CONFIG | LP8557_PWM_FILTER | LP8557_DISABLE_LEDS), and
+	 * the six EEPROM registers it programs at init.
+	 *
+	 * LK already lights the backlight, so this mostly takes over a running
+	 * part. What it buys is brightness control and a defined state across
+	 * a DPMS cycle.
+	 */
+	status = "okay";
+	clock-frequency = <400000>;
+
+	backlight_lcd: backlight@2c {
+		compatible = "ti,lp8557";
+		reg = <0x2c>;
+		enable-supply = <&backlight_enable>;
+
+		dev-ctrl = /bits/ 8 <0x47>;
+		init-brt = /bits/ 8 <0x64>;
+
+		/* full-scale LED current 23 mA */
+		rom-11h {
+			rom-addr = /bits/ 8 <0x11>;
+			rom-val = /bits/ 8 <0x06>;
+		};
+		/* 4 V OV, 4 output LED strings enabled */
+		rom-14h {
+			rom-addr = /bits/ 8 <0x14>;
+			rom-val = /bits/ 8 <0x0f>;
+		};
+		/* boost frequency 1 MHz */
+		rom-13h {
+			rom-addr = /bits/ 8 <0x13>;
+			rom-val = /bits/ 8 <0x01>;
+		};
+		/* 19.5 kHz */
+		rom-12h {
+			rom-addr = /bits/ 8 <0x12>;
+			rom-val = /bits/ 8 <0x2b>;
+		};
+		/* light smoothing, 100 ms */
+		rom-15h {
+			rom-addr = /bits/ 8 <0x15>;
+			rom-val = /bits/ 8 <0x42>;
+		};
+		/* max boost voltage 28 V, adaptive */
+		rom-16h {
+			rom-addr = /bits/ 8 <0x16>;
+			rom-val = /bits/ 8 <0xe0>;
+		};
+	};
+
+	/*
+	 * Lite-On LTR-559 ambient light + proximity.
+	 *
+	 * The vendor wires its interrupt to pio 6, level low, but that is
+	 * deliberately not described yet: the proximity threshold interrupt is
+	 * optional for this driver, and a level-triggered line with the wrong
+	 * polarity would sit asserted and storm. Add it once it can be watched.
+	 */
+	light-sensor@23 {
+		compatible = "liteon,ltr559";
+		reg = <0x23>;
+	};
+};
+
+/*
+ * The DSI D-PHY. mt8173.dtsi ships it disabled, and it is also the "hs" clock
+ * provider for dsi0:
+ *
+ *   clocks = <&mmsys CLK_MM_DSI0_ENGINE>, <&mmsys CLK_MM_DSI0_DIGITAL>,
+ *            <&mipi_tx0>;
+ *   clock-names = "engine", "digital", "hs";
+ *
+ * so leaving it disabled costs the clock, not just the PHY, and mtk-dsi fails
+ * its probe outright:
+ *
+ *   mtk-dsi 1401b000.dsi: error -ENOENT: Failed to get hs clock
+ *   mtk-dsi 1401b000.dsi: probe with driver mtk-dsi failed with error -2
+ *
+ * mt8173-elm enables it the same way, with nothing but a status.
+ */
+&mipi_tx0 {
+	status = "okay";
+};
+
+/*
+ * The display PWM. Nothing on this board uses it -- the LP8557 backlight is
+ * driven over I2C in register mode, and the vendor left its PWM-based variant
+ * commented out -- but mediatek-drm still needs the node to exist.
+ *
+ * mt8173's main display path is
+ *   OVL0 -> COLOR0 -> AAL0 -> OD0 -> RDMA0 -> UFOE -> DSI0 -> PWM0
+ * and mtk_ddp_path_available() requires a device node for *every* component in
+ * it. With pwm0 disabled the whole path is unavailable, so the DSI is not in
+ * any path mediatek-drm knows about and its bind fails:
+ *
+ *   [drm] Failed to find comp in ddp table, ret = -22
+ *   mediatek-drm: failed to bind 1401b000.dsi: -22
+ *
+ * OD0 and UFOE need no driver, so they never show up in the component match
+ * list; only their nodes matter, and mt8173.dtsi already enables those.
+ */
+&pwm0 {
+	status = "okay";
+};
+
+&dsi0 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	panel@0 {
+		compatible = "novatek,nt51021";
+		reg = <0>;
+
+		/* vendor &lcm: reg-lcm-supply = <&mt6397_vgp6_reg>, 3V3_LCM_VCC33 */
+		power-supply = <&mt6397_vgp6_reg>;
+
+		/*
+		 * Vendor gpio_lcm_rst_en = <&pio 105 0>, driven low to assert
+		 * reset and high to release it, i.e. active low.
+		 */
+		reset-gpios = <&pio 105 GPIO_ACTIVE_LOW>;
+
+		/*
+		 * Panel-vendor ID straps, in the order <id0>, <id1>: vendor
+		 * lcm_id0_gpio = <&pio 102 0>, lcm_id1_gpio = <&pio 103 0>.
+		 * The driver reads them to choose between the Innolux and BOE
+		 * register sets, exactly as the vendor LCM driver does. suez
+		 * shipped with both panels, so this cannot be settled by the
+		 * compatible string.
+		 *
+		 * These are otherwise-unused MSDC2 pads; nothing else in this
+		 * DTS claims pio 102-105. The vendor also watches pio 104 as
+		 * the panel's ESD line; the driver has no ESD recovery, so it
+		 * is not described.
+		 */
+		lcm-id-gpios = <&pio 102 GPIO_ACTIVE_HIGH>,
+			       <&pio 103 GPIO_ACTIVE_HIGH>;
+
+		backlight = <&backlight_lcd>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&dsi0_out>;
+			};
+		};
+	};
+
+	port {
+		dsi0_out: endpoint {
+			remote-endpoint = <&panel_in>;
+		};
+	};
+};
