From 2c41d2cfa9a17d2f03d4888f059ceb623460cf90 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Thu, 3 Sep 2026 09:31:24 -0500
Subject: [PATCH] dt-bindings: display: panel: add Novatek NT51021

The Novatek NT51021 is a DSI panel controller driving 1200x1920 WUXGA
panels over four lanes in video mode. It is found in the Amazon Fire HD 10
(2017), where units ship with either Innolux or BOE glass behind the same
controller and the same board wiring.

The glass vendor cannot be expressed as a compatible string, because the
vendor's own driver reads two ID straps at every initialisation and picks
the register sequence from them; a device tree cannot promise which panel a
given unit has. The binding therefore takes an optional pair of ID GPIOs,
lcm-id-gpios, least significant first, and boards that fit only one panel
may omit them.

The rest is panel-common: a power supply, a reset GPIO, an optional
backlight and the DSI port.

Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 .../display/panel/novatek,nt51021.yaml        | 75 +++++++++++++++++++
 1 file changed, 75 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/novatek,nt51021.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/novatek,nt51021.yaml b/Documentation/devicetree/bindings/display/panel/novatek,nt51021.yaml
new file mode 100644
index 000000000..56d766a4c
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/novatek,nt51021.yaml
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/novatek,nt51021.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Novatek NT51021 based 1200x1920 DSI display panels
+
+maintainers:
+  - Ryan Brue <ryanbrue.dev@gmail.com>
+
+description:
+  The Novatek NT51021 is a DSI panel controller driving 1200x1920 WUXGA
+  panels over four lanes in video mode. Panels using it ship with more than
+  one glass vendor behind the same controller and the same board wiring, so
+  the panel in a given unit is identified at runtime from two ID straps
+  rather than from the compatible string.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: novatek,nt51021
+
+  reg:
+    maxItems: 1
+
+  power-supply: true
+  reset-gpios: true
+  backlight: true
+  port: true
+
+  lcm-id-gpios:
+    minItems: 2
+    maxItems: 2
+    description:
+      The panel-vendor ID straps, least significant first. Their value
+      selects which glass vendor's initialisation sequence to send. Boards
+      that fit only one panel may omit these, in which case the first
+      supported panel is assumed.
+
+required:
+  - compatible
+  - reg
+  - power-supply
+  - reset-gpios
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "novatek,nt51021";
+            reg = <0>;
+            power-supply = <&vgp6>;
+            reset-gpios = <&pio 105 GPIO_ACTIVE_LOW>;
+            lcm-id-gpios = <&pio 102 GPIO_ACTIVE_HIGH>,
+                           <&pio 103 GPIO_ACTIVE_HIGH>;
+            backlight = <&backlight_lcd>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&dsi_out>;
+                };
+            };
+        };
+    };
