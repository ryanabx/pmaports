# Development device only: never install this on a device you rely on.
maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=sheldon-dev-insecure
pkgver=1
pkgrel=0
pkgdesc="Passwordless sudo, an unrestricted kernel log and kexec, for the sheldon(p) dev stick"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
depends="sudo-virt kexec-tools"
install="$pkgname.post-install"
source="sudoers-dev sysctl-90-dev.conf"
options="!check"

package() {
	install -Dm440 "$srcdir"/sudoers-dev "$pkgdir"/etc/sudoers.d/dev
	install -Dm644 "$srcdir"/sysctl-90-dev.conf "$pkgdir"/etc/sysctl.d/90-dev.conf
}

