diff --git a/drivers/watchdog/mtk_wdt.c b/drivers/watchdog/mtk_wdt.c
index 500af54d5905..b5c7d32219f5 100644
--- a/drivers/watchdog/mtk_wdt.c
+++ b/drivers/watchdog/mtk_wdt.c
@@ -40,6 +40,7 @@
 #include <linux/notifier.h>
 #include <linux/reboot.h>
 #include <linux/delay.h>
+#include <linux/kexec.h>
 #include <linux/reset-controller.h>
 #include <linux/reset.h>
 #include <linux/sched.h>
@@ -473,7 +474,11 @@ static void mtk_wdt_shutdown(struct platform_device *pdev)
 {
 	struct mtk_wdt_dev *mtk_wdt = platform_get_drvdata(pdev);
 
-	if (watchdog_active(&mtk_wdt->wdt_dev))
+	/*
+	 * Leave a running watchdog armed across kexec, so a kernel that hangs
+	 * after the handoff resets the board instead of wedging it.
+	 */
+	if (watchdog_active(&mtk_wdt->wdt_dev) && !kexec_in_progress)
 		mtk_wdt_stop(&mtk_wdt->wdt_dev);
 }
 
