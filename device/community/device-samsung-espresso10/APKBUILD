f4239fd72916aafb963b5c4d873ae8c59d6e5dba74c250147000d2403a77fff9f4620bd0bd5f725c4071d72fda8cdc0187c250f1967f2ff3136f6369426b948d  GalaxyTab2.conf
e7210cbe5a5c0e86160bb4f7fb81079f36cf01270c04b3f80d991db8543830f7b4c3870018b48f6f4a844907698c925dd0de2844ed9da9d2538aea385a5b3eb0  HiFi.conf
"
