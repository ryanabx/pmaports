# Reference: <https://postmarketos.org/devicepkg>
maintainer="Mithil Bavishi <bavishimithil@gmail.com>"
pkgname=device-samsung-espresso10
pkgdesc="Samsung Galaxy Tab 2 (10.1 inch)"
pkgver=9
pkgrel=4
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	firmware-samsung-espresso
	linux-postmarketos-omap
	mkbootimg
	postmarketos-base
	"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-kernel-standard:kernel_standard
	$pkgname-kernel-bby:kernel_bby
	"
source="
	deviceinfo
	61-sensor-espresso10.hwdb
	ucm/GalaxyTab2.conf
	ucm/HiFi.conf
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# ALSA UCM configs
	install -Dm644 "$srcdir"/GalaxyTab2.conf "$srcdir"/HiFi.conf \
		-t "$pkgdir"/usr/share/alsa/ucm2/conf.d/GalaxyTab2

	# accelerometer orientation for iio-sensor-proxy
	install -Dm644 "$srcdir"/61-sensor-espresso10.hwdb \
		-t "$pkgdir"/usr/lib/udev/hwdb.d
}

kernel_standard() {
	pkgdesc="Standard board layout, without the IR blaster"
	depends="linux-postmarketos-omap"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_bby() {
	pkgdesc="Board layout with the IR blaster (\"Best Buy\", e.g. GT-P5113): charger and ADC on other pins"
	depends="linux-postmarketos-omap"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

