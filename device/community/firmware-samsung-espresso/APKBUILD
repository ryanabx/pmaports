maintainer="Mithil Bavishi <bavishimithil@gmail.com>"
pkgname=firmware-samsung-espresso
pkgver=2
pkgrel=1
pkgdesc="Samsung Galaxy Tab Firmware"
url="https://github.com/TheMuppets/proprietary_vendor_samsung"
arch="armv7"
license="proprietary"
options="!check !strip !archcheck !spdx !tracedeps pmb:cross-native"

# Source
_commit="89fe5020dbaf2920dece954ce86aa2edf3389852"
_url="https://github.com/TheMuppets/proprietary_vendor_samsung/raw/$_commit/espresso-common/proprietary/system/etc/wifi"
_files="
	bcmdhd_sta.bin
	nvram_net.txt
"
for _i in $_files; do
	source="$source $_i::$_url/$_i";
done
_url_vendor="https://github.com/TheMuppets/proprietary_vendor_samsung/raw/$_commit/espresso-common/proprietary/system/vendor/firmware"
source="$source BCM4330.hcd::$_url_vendor/BCM4330.hcd"

package() {
	install -Dm644 "$srcdir/nvram_net.txt" \
		"$pkgdir"/usr/lib/firmware/postmarketos/brcm/"brcmfmac4330-sdio.samsung,espresso7.txt"
	install -Dm644 "$srcdir/nvram_net.txt" \
		"$pkgdir"/usr/lib/firmware/postmarketos/brcm/"brcmfmac4330-sdio.samsung,espresso10.txt"
	install -Dm644 "$srcdir/bcmdhd_sta.bin" \
		"$pkgdir"/usr/lib/firmware/postmarketos/brcm/"brcmfmac4330-sdio.bin"
	# Bluetooth patch RAM for the BCM4330B1 (hci_uart_bcm)
	install -Dm644 "$srcdir/BCM4330.hcd" \
		"$pkgdir"/usr/lib/firmware/postmarketos/brcm/BCM4330B1.hcd
}
