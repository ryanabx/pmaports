From 4d063bc02a694f7179d3d68a02df4219c50e5dc2 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Fri, 25 Sep 2026 02:26:26 -0500
Subject: [PATCH] ARM: dts: ti: omap: samsung-espresso10: add the STMPE811 ADC

The 10.1" has an STMPE811 at 0x41 on the bit-banged ADC bus, used as an
8-channel ADC. Samsung's kernel reads the headset detection voltage
(EAR_ADC_35, channel 4), REMOTE_SENSE (5), the charger type
(ADC_CHECK_1, 6) and the accessory ID of the dock connector (7) from it,
with a 12-bit, internal-reference setup at 6.5 MHz. Its interrupt output
is ADC_INT on GPIO 36 (gpmc_ad12), which the vendor kernel muxes as an
input but doesn't use; mainline's stmpe-adc needs it for the conversion
done interrupt.

As for the charger, the bus is on the pins of Samsung's "Best Buy"
variant here: a GT-P5113 (US) unit gets an ACK from 0x41 on GPIO 137
(SDA, mcspi1_cs0) / GPIO 134 (SCL, mcspi1_clk), the pads the bootloader
leaves as GPIO inputs with pull-up, and not on the GPIO 66/65 pair of the
common file, which the vendor uses for its other boards. So this is only
right for the BBY layout and not for upstream as is; it needs a variant
DT.

Describe the chip and its ADC, and move the 10.1" ADC bus to GPIO
137/134.

Assisted-by: LLM
---
 .../dts/ti/omap/omap4-samsung-espresso10.dts  | 51 +++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts
index 8fe5ec8c45b8..c1c543045d2e 100644
--- a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts
+++ b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts
@@ -46,6 +46,41 @@ smb347: charger@6 {
 		};
 	};
 
+	i2c-gpio6 {
+		/*
+		 * Like the charger bus, the STMPE811 ADC bus is on other pins
+		 * than in the common file: GPIO 137 (SDA) and GPIO 134 (SCL),
+		 * the pins Samsung's kernel uses for its "Best Buy" variant.
+		 */
+		pinctrl-0 = <&i2c6_pins_espresso10>;
+		sda-gpios = <&gpio5 9 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>; /* GPIO_137 */
+		scl-gpios = <&gpio5 6 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>; /* GPIO_134 */
+
+		stmpe811: adc@41 {
+			compatible = "st,stmpe811";
+			reg = <0x41>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&stmpe811_pins>;
+			interrupt-parent = <&gpio2>;
+			interrupts = <4 IRQ_TYPE_EDGE_FALLING>; /* GPIO_36 */
+
+			/* vendor ADC setup: 80 clocks, 12 bit, internal reference, 6.5 MHz */
+			st,sample-time = <3>;
+			st,mod-12b = <1>;
+			st,ref-sel = <0>;
+			st,adc-freq = <3>;
+
+			/*
+			 * Vendor channel use: 4 headset (EAR_ADC_35), 5 REMOTE_SENSE,
+			 * 6 charger type (ADC_CHECK_1), 7 accessory ID.
+			 */
+			stmpe_adc: adc {
+				compatible = "st,stmpe-adc";
+				#io-channel-cells = <1>;
+			};
+		};
+	};
+
 	backlight: backlight {
 		compatible = "pwm-backlight";
 		pinctrl-names = "default";
@@ -175,4 +210,20 @@ OMAP4_IOPAD(0x0f6, PIN_INPUT_PULLUP | MUX_MODE3)
 			/* abe_mcbsp2_clkx.gpio_110 - CHG_SCL */
 		>;
 	};
+
+	i2c6_pins_espresso10: pinmux-i2c6-espresso10-pins {
+		pinctrl-single,pins = <
+			OMAP4_IOPAD(0x138, PIN_INPUT_PULLUP | MUX_MODE3)
+			/* mcspi1_cs0.gpio_137 - ADC_I2C_SDA */
+			OMAP4_IOPAD(0x132, PIN_INPUT_PULLUP | MUX_MODE3)
+			/* mcspi1_clk.gpio_134 - ADC_I2C_SCL */
+		>;
+	};
+
+	stmpe811_pins: pinmux-stmpe811-pins {
+		pinctrl-single,pins = <
+			OMAP4_IOPAD(0x058, PIN_INPUT_PULLUP | MUX_MODE3)
+			/* gpmc_ad12.gpio_36 - ADC_INT */
+		>;
+	};
 };
