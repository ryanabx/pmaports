# Kernel config based on: arch/arm/configs/omap2plus_defconfig
maintainer="Mithil Bavishi <bavishimithil@gmail.com>"
pkgname=linux-postmarketos-omap
pkgver=7.1.5
pkgrel=29
pkgdesc="Mainline kernel fork for OMAP devices"
arch="armv7"
url="https://kernel.org/"
license="GPL-2.0-only"
options="!check !strip !tracedeps pmb:cross-native pmb:kconfigcheck-community"
makedepends="
	bash
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zstd
"
_carch="arm"
_flavor="postmarketos-omap"
_config="config-$_flavor.armv7"

case $pkgver in
	*.*rc*)	_rc=1
	        _kernver=$(echo $pkgver | tr '_' '-');;
	*.*.0) _kernver=${pkgver%.0};;
	*.*.*) _kernver=$pkgver;;
esac

if [ $_rc ]
then
	_kernsrc="linux-$pkgver.tar.gz::https://git.kernel.org/torvalds/t/linux-$_kernver.tar.gz"
else
	_kernsrc="https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$_kernver.tar.xz"
fi

source="
	$_kernsrc
	$_config
	0001-iio-rescale-revert-logic.patch
	0002-hsi-dma-fix.patch
	0003-Add-TWL6030-power-button-support-to-twl-pwrbutton.patch
	0004-arm-dts-Add-barnesnoble-encore-support.patch
	0005-panel-Add-lg-ld070ws1-for-barnesnoble-encore.patch
	0006-omap4-cfi.patch
	0007-power-supply-smb347-treat-a-missing-monitored-battery-as-no-battery-info.patch
	0008-ARM-dts-ti-omap-samsung-espresso10-fix-the-charger-I2C-pins.patch
	0009-ARM-dts-ti-omap-espresso-common-keep-the-TWL6032-VIO-regulator-on.patch
	0010-dt-bindings-sram-add-TI-OMAP4-SAR-RAM.patch
	0011-bus-ti-sysc-populate-simple-mfd-child-nodes-too.patch
	0012-ARM-dts-ti-omap4-add-the-SAR-RAM.patch
	0013-ARM-dts-ti-omap-espresso-common-add-the-bootloader-r.patch
	0014-power-supply-smb347-re-enable-APSD-and-allow-setting.patch
	0015-ARM-dts-ti-omap-samsung-espresso10-describe-the-batt.patch
	0016-ARM-dts-ti-omap-espresso-common-reserve-the-secure-m.patch
	0017-ARM-dts-ti-omap-samsung-espresso10-size-the-splash-r.patch
	0018-ARM-dts-ti-omap-espresso-common-add-ramoops.patch
	0019-ARM-OMAP2-prm44xx-clear-the-reset-sources-at-boot-on.patch
	0020-ARM-dts-ti-omap-espresso-move-the-GP2AP002-light-sen.patch
	0021-ARM-dts-ti-omap-samsung-espresso10-add-the-BH1721-li.patch
	0022-ARM-OMAP4-PM-move-the-L2X0-save-area-out-of-the-boot.patch
	0023-ARM-dts-ti-omap-espresso-common-ramoops-no-map.patch
	0024-dt-bindings-power-reset-add-Samsung-Galaxy-Tab-2-reboo.patch
	0025-power-reset-add-Samsung-Galaxy-Tab-2-reboot-mode-driv.patch
	0026-ARM-dts-ti-omap-espresso-common-fix-the-reboot-mode-c.patch
	0027-ARM-dts-ti-omap-espresso-common-use-the-Samsung-reboo.patch
	0028-power-supply-core-count-each-power-supplies-entry-on.patch
	0029-power-supply-core-copy-the-supplier-names-for-suppli.patch
	0030-ARM-dts-ti-omap-espresso-common-disable-the-keypad-c.patch
	0031-ARM-dts-ti-omap-espresso-common-disable-the-secure-R.patch
	0032-ARM-dts-ti-omap-samsung-espresso10-add-the-sensor-mo.patch
	0033-ASoC-dt-bindings-add-the-Samsung-Galaxy-Tab-2-audio.patch
	0034-ASoC-ti-add-a-machine-driver-for-the-Samsung-Galaxy.patch
	0035-ARM-dts-ti-omap-espresso-common-add-the-WM1811-audio.patch
"
builddir="$srcdir/linux-$_kernver"
replaces="linux-samsung-espresso3g linux-nokia-n900"

prepare() {
	default_prepare
	cp -v "$srcdir"/$_config .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

