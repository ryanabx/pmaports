From 796478b3884bc4998a5779f52c0c4e4c896890de Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Wed, 23 Sep 2026 20:36:52 -0500
Subject: [PATCH] ARM: dts: ti: omap: samsung-espresso10: describe the battery

Describe the 7000 mAh pack of the Galaxy Tab 2 10.1 with the charge
settings of the vendor kernel (4.2 V, 2.2 A fast charge, 250 mA
pre-charge and termination current) and point the SMB347 charger at it,
so that the charger is configured from the DT instead of whatever the
bootloader or the OTP defaults left.

Also make the charger the supplier of the MAX17042 fuel gauge, so that
the gauge can report charging status.

Assisted-by: LLM
---
 .../omap/omap4-samsung-espresso-common.dtsi   |  2 +-
 .../dts/ti/omap/omap4-samsung-espresso10.dts  | 19 +++++++++++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
index 5a2656f42fef..3c05c8ea97d4 100644
--- a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
+++ b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
@@ -63,7 +63,7 @@ i2c-gpio7 {
 		#address-cells = <1>;
 		#size-cells = <0>;
 
-		fuel-gauge@36 {
+		fuel_gauge: fuel-gauge@36 {
 			compatible = "maxim,max17042";
 			reg = <0x36>;
 			pinctrl-0 = <&fuel_alert_irq>;
diff --git a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts
index c0266cf97b53..acf440c6a75b 100644
--- a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts
+++ b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts
@@ -7,6 +7,19 @@ / {
 	model = "Samsung Galaxy Tab 2 (10 inch)";
 	compatible = "samsung,espresso10", "ti,omap4430", "ti,omap4";
 
+	/* 7000 mAh pack; charge settings as in the vendor kernel */
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion-polymer";
+		charge-full-design-microamp-hours = <7000000>;
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4200000>;
+		constant-charge-voltage-max-microvolt = <4200000>;
+		constant-charge-current-max-microamp = <2200000>;
+		precharge-current-microamp = <250000>;
+		charge-term-current-microamp = <250000>;
+	};
+
 	i2c-gpio5 {
 		/*
 		 * On the 10.1" the charger bus is on GPIO 113 (SDA) and GPIO 110
@@ -29,6 +42,7 @@ smb347: charger@6 {
 			summit,enable-charge-control = <SMB3XX_CHG_ENABLE_SW>;
 			summit,chip-temperature-threshold-celsius = <120>;
 			summit,usb-current-limit-microamp = <1800000>;
+			monitored-battery = <&battery>;
 		};
 	};
 
@@ -111,6 +125,11 @@ rmi4-f11@11 {
 	};
 };
 
+&fuel_gauge {
+	power-supplies = <&smb347>;
+	monitored-battery = <&battery>;
+};
+
 &omap4_pmx_core {
 	i2c5_pins_espresso10: pinmux-i2c5-espresso10-pins {
 		pinctrl-single,pins = <
-- 
2.55.0

