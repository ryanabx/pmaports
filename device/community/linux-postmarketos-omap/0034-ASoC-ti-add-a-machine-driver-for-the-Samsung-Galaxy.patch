index 3323cf96e309..fb6b0067ca2c 100644
--- a/sound/soc/ti/Kconfig
+++ b/sound/soc/ti/Kconfig
@@ -123,6 +123,19 @@ config SND_SOC_OMAP_ABE_TWL6040
 	  - PandaBoardES (4460)
 	  - OMAP5 uEVM
 
+config SND_SOC_OMAP_SAMSUNG_ESPRESSO
+	tristate "SoC Audio support for the Samsung Galaxy Tab 2 (espresso)"
+	depends on ARCH_OMAP4 || COMPILE_TEST
+	depends on I2C && COMMON_CLK
+	select SND_SOC_OMAP_MCBSP
+	select MFD_WM8994
+	select SND_SOC_WM8994
