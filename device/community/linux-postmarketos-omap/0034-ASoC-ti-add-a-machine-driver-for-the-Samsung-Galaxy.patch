+	  Say Y or M if you want to add support for SoC audio on the Samsung
+	  Galaxy Tab 2 7.0 and 10.1 (espresso) tablets, which have a WM1811
+	  codec on McBSP3. The machine driver sets up the codec's FLL for
+	  each sample rate and switches the microphone biases.
+
 config SND_SOC_OMAP_AMS_DELTA
 	tristate "SoC Audio support for Amstrad E3 (Delta) videophone"
 	depends on MACH_AMS_DELTA || COMPILE_TEST
diff --git a/sound/soc/ti/Makefile b/sound/soc/ti/Makefile
index 421e13bc04db..d2a7c0d19d78 100644
--- a/sound/soc/ti/Makefile
+++ b/sound/soc/ti/Makefile
@@ -32,6 +32,7 @@ snd-soc-omap-abe-twl6040-y := omap-abe-twl6040.o
 snd-soc-ams-delta-y := ams-delta.o
 snd-soc-omap-hdmi-y := omap-hdmi.o
 snd-soc-osk5912-y := osk5912.o
