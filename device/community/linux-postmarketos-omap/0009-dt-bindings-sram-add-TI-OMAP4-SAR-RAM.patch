From 92146db11fd2501b38cb6971e510734171685aec Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Wed, 23 Sep 2026 14:32:18 -0500
Subject: [PATCH] dt-bindings: sram: add TI OMAP4 SAR RAM

The SAR (save and restore) RAM of OMAP4 keeps its contents across a
warm reset. Some bootloaders read a boot mode from it, for example the
one on Samsung's Galaxy Tab 2 (espresso) tablets.

Describe it as a syscon, so that a reboot-mode child (syscon-reboot-mode
or a device specific one) can write the mode on restart.

Assisted-by: LLM
---
 .../bindings/sram/ti,omap4-sar-ram.yaml       | 53 +++++++++++++++++++
 1 file changed, 53 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sram/ti,omap4-sar-ram.yaml

diff --git a/Documentation/devicetree/bindings/sram/ti,omap4-sar-ram.yaml b/Documentation/devicetree/bindings/sram/ti,omap4-sar-ram.yaml
new file mode 100644
index 000000000000..d03a9ad3966b
--- /dev/null
+++ b/Documentation/devicetree/bindings/sram/ti,omap4-sar-ram.yaml
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sram/ti,omap4-sar-ram.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: TI OMAP4 SAR RAM
+
+maintainers:
+  - Ryan Brue <ryanbrue.dev@gmail.com>
+
+description:
+  The SAR (save and restore) RAM of OMAP4 SoCs is on-chip RAM in the wakeup
+  domain. It keeps its contents across a warm reset, so boot firmware and the
+  kernel can use it to pass state, for example a reboot mode for the
+  bootloader.
+
+properties:
+  compatible:
+    items:
+      - const: ti,omap4-sar-ram
+      - const: syscon
+      - const: simple-mfd
+
+  reg:
+    maxItems: 1
+
+  reboot-mode:
+    type: object
+    description:
+      Reboot mode for the bootloader, for example a syscon-reboot-mode node
+      or a device specific one such as samsung,espresso-reboot-mode.
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    sram@4a326000 {
+        compatible = "ti,omap4-sar-ram", "syscon", "simple-mfd";
+        reg = <0x4a326000 0x1000>;
+
+        reboot-mode {
+            compatible = "syscon-reboot-mode";
+            offset = <0xff8>;
+            mode-normal = <0x1>;
+            mode-recovery = <0x2>;
+            mode-download = <0x20>;
+        };
+    };
-- 
