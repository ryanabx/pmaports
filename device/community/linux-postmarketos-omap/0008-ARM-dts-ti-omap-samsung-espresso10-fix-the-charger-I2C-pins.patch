From 27acfc838ea1a0ca01ff1df707837ece5dd950ce Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Wed, 23 Sep 2026 09:28:44 -0500
Subject: [PATCH] ARM: dts: ti: omap: samsung-espresso10: fix the charger I2C
 pins

The SMB347 charger of the Galaxy Tab 2 10.1 is not on GPIO 98/99, the
i2c-gpio5 pins inherited from omap4-samsung-espresso-common.dtsi. On a
GT-P51xx (US, XAR) unit nothing answers there at any address, while a
bit-banged probe on GPIO 113 (SDA, abe_mcbsp2_fsx) / GPIO 110 (SCL,
abe_mcbsp2_clkx) gets an ACK from the charger at 0x06, and NACKs at
other addresses. The bootloader leaves exactly those two pads set up as
GPIO inputs with pull-up.

Samsung's vendor kernel uses these pins for its "Best Buy" espresso10
variant (board-espresso-power.c: GPIO_CHG_SDA_BBY/GPIO_CHG_SCL_BBY),
although neither of its checks for that variant (sec_vendor=0 on the
command line, HW_REV4/GPIO 41 high) fires on this unit.

Move the 10.1" charger bus to GPIO 113/110. The 7" keeps GPIO 98/99 for
its SMB136.

Assisted-by: LLM
---
 .../dts/ti/omap/omap4-samsung-espresso10.dts  | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts
index 558dc3c029e9..c0266cf97b53 100644
--- a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts
+++ b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso10.dts
@@ -8,6 +8,17 @@ / {
 	compatible = "samsung,espresso10", "ti,omap4430", "ti,omap4";
 
 	i2c-gpio5 {
+		/*
+		 * On the 10.1" the charger bus is on GPIO 113 (SDA) and GPIO 110
+		 * (SCL), not on the GPIO 98/99 pair the common file uses: the
+		 * SMB347 ACKs its address there and nothing answers on 98/99.
+		 * Samsung's kernel uses the same pins for its "Best Buy" board
+		 * variant.
+		 */
+		pinctrl-0 = <&i2c5_pins_espresso10>;
+		sda-gpios = <&gpio4 17 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>; /* GPIO_113 */
+		scl-gpios = <&gpio4 14 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>; /* GPIO_110 */
+
 		smb347: charger@6 {
 			compatible = "summit,smb347";
 			reg = <0x6>; // 0x0C >> 1
@@ -99,3 +110,14 @@ rmi4-f11@11 {
 		};
 	};
 };
+
+&omap4_pmx_core {
+	i2c5_pins_espresso10: pinmux-i2c5-espresso10-pins {
+		pinctrl-single,pins = <
+			OMAP4_IOPAD(0x0fc, PIN_INPUT_PULLUP | MUX_MODE3)
+			/* abe_mcbsp2_fsx.gpio_113 - CHG_SDA */
+			OMAP4_IOPAD(0x0f6, PIN_INPUT_PULLUP | MUX_MODE3)
+			/* abe_mcbsp2_clkx.gpio_110 - CHG_SCL */
+		>;
+	};
+};
-- 
