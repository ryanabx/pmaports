From 4756014850f08e9c68f59d374364bd6abeec9f1d Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Thu, 24 Sep 2026 13:21:02 -0500
Subject: [PATCH] dt-bindings: power: reset: add Samsung Galaxy Tab 2 reboot
 mode

The bootloader of the Samsung Galaxy Tab 2 (espresso) takes its boot
mode from the OMAP4 SAR RAM: a flag at offset 0xff8, which it uses only
if the word at 0xff4 holds the tag that the vendor kernel writes with it.
At every boot the bootloader leaves another tag there, so the tag has to
be written together with the flag, which syscon-reboot-mode can't do.

Describe it as a reboot-mode node under the SAR RAM syscon, with the
flags as the mode-* values.

Assisted-by: LLM
---
 .../reset/samsung,espresso-reboot-mode.yaml   | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/reset/samsung,espresso-reboot-mode.yaml

diff --git a/Documentation/devicetree/bindings/power/reset/samsung,espresso-reboot-mode.yaml b/Documentation/devicetree/bindings/power/reset/samsung,espresso-reboot-mode.yaml
new file mode 100644
index 000000000000..dd27ac8b820b
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/reset/samsung,espresso-reboot-mode.yaml
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/reset/samsung,espresso-reboot-mode.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Galaxy Tab 2 bootloader reboot mode
+
+maintainers:
+  - Ryan Brue <ryanbrue.dev@gmail.com>
+
+description:
+  The bootloader of the Samsung Galaxy Tab 2 (espresso, OMAP4430) reads the
+  boot mode from the OMAP4 SAR RAM, from the word at offset 0xff8. It uses
+  that flag only if the word at 0xff4 holds the tag "RESE" (0x45534552);
+  at every boot it leaves a different tag there. The node is a child of
+  the SAR RAM syscon, and the mode-* values are the flags.
+
+allOf:
+  - $ref: reboot-mode.yaml#
+
+properties:
+  compatible:
+    const: samsung,espresso-reboot-mode
+
+patternProperties:
+  "^mode-.*$":
+    maxItems: 1
+
+required:
+  - compatible
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    reboot-mode {
+        compatible = "samsung,espresso-reboot-mode";
+        mode-normal = <0x1>;
+        mode-recovery = <0x2>;
+        mode-download = <0x20>;
+    };
+...
-- 
