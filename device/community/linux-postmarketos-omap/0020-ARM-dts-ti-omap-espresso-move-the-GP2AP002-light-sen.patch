From cc41dd5fa7c8104f8874199f26982aeb3c2d0082 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Thu, 24 Sep 2026 00:38:37 -0500
Subject: [PATCH 1/2] ARM: dts: ti: omap: espresso: move the GP2AP002 light
 sensor to the 7"

The common espresso file describes a Sharp GP2AP002 light/proximity
sensor at 0x44 on I2C4, with its ALS output on TWL6032 GPADC channel 4.
The vendor kernel registers that sensor only on the 7" 3G models; the
10.1" has a ROHM BH1721FVC at 0x23 instead. On a GT-P5100 nothing
answers at 0x44, and the probe fails at every boot:

  gp2ap002 3-0044: error setting up LED gain
  gp2ap002 3-0044: initialization failed
  gp2ap002 3-0044: probe with driver gp2ap002 failed with error -121

Move the sensor and its current-sense shunt to the espresso7 DT. The
espresso7 DTB doesn't change apart from phandle numbers.

Assisted-by: LLM
---
 .../omap/omap4-samsung-espresso-common.dtsi   | 20 -----------------
 .../dts/ti/omap/omap4-samsung-espresso7.dts   | 22 +++++++++++++++++++
 2 files changed, 22 insertions(+), 20 deletions(-)

diff --git a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
index 255491cb28ba..9a41531d1c6c 100644
--- a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
+++ b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
@@ -227,13 +227,6 @@ vibrator {
 		pinctrl-0 = <&vibrator_default>;
 	};
 
-	gp2a_shunt: current-sense-shunt {
-		compatible = "current-sense-shunt";
-		io-channels = <&gpadc 4>;
-		shunt-resistor-micro-ohms = <24000000>; /* 24 ohms */
-		#io-channel-cells = <0>;
-	};
-
 	led-ir {
 		compatible = "gpio-ir-tx";
 		gpios = <&gpio2 27 GPIO_ACTIVE_HIGH>; /* GPIO_59 */
@@ -667,19 +660,6 @@ magnetometer@2e {
 		reset-gpios = <&gpio5 29 GPIO_ACTIVE_LOW>;
 		interrupts = <&gpio6 10 IRQ_TYPE_EDGE_RISING>;
 	};
-
-	light-sensor@44 {
-		compatible = "sharp,gp2ap002a00f";
-		reg = <0x44>;
-		interrupt-parent = <&gpio1>;
-		interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
-		vdd-supply = <&ldo4>;
-		vio-supply = <&ldo4>;
-		io-channels = <&gp2a_shunt>;
-		io-channel-names = "alsout";
-		sharp,proximity-far-hysteresis = /bits/ 8 <0x40>;
-		sharp,proximity-close-hysteresis = /bits/ 8 <0x20>;
-	};
 };
 
 &dss {
diff --git a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso7.dts b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso7.dts
index cae37ff066c3..ede72ec0e1ec 100644
--- a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso7.dts
+++ b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso7.dts
@@ -18,6 +18,13 @@ backlight: backlight {
 		default-brightness-level = <2>;
 	};
 
+	gp2a_shunt: current-sense-shunt {
+		compatible = "current-sense-shunt";
+		io-channels = <&gpadc 4>;
+		shunt-resistor-micro-ohms = <24000000>; /* 24 ohms */
+		#io-channel-cells = <0>;
+	};
+
 	panel {
 		compatible = "samsung,ltn070nl01", "panel-lvds";
 		power-supply = <&reg_lcd>;
@@ -68,3 +75,18 @@ touchscreen@48 {
 		vdd-supply = <&ldo6>;
 	};
 };
+
+&i2c4 {
+	light-sensor@44 {
+		compatible = "sharp,gp2ap002a00f";
+		reg = <0x44>;
+		interrupt-parent = <&gpio1>;
+		interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
+		vdd-supply = <&ldo4>;
+		vio-supply = <&ldo4>;
+		io-channels = <&gp2a_shunt>;
+		io-channel-names = "alsout";
+		sharp,proximity-far-hysteresis = /bits/ 8 <0x40>;
+		sharp,proximity-close-hysteresis = /bits/ 8 <0x20>;
+	};
+};
-- 
