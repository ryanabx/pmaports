From b84baf58ea2fa0dbb00812cf6e921fdcf74896e3 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Thu, 24 Sep 2026 14:36:15 -0500
Subject: [PATCH] ASoC: dt-bindings: add the Samsung Galaxy Tab 2 audio complex

The Samsung Galaxy Tab 2 7.0 and 10.1 (espresso) have a WM1811 codec on
McBSP3 of the OMAP4430, with the codec as clock provider and GPIO
switched mic biases for the main and headset microphones.

Describe the sound card, following the Midas WM1811 binding.

Assisted-by: LLM
---
 .../sound/samsung,espresso-audio.yaml         | 97 +++++++++++++++++++
 1 file changed, 97 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/samsung,espresso-audio.yaml

diff --git a/Documentation/devicetree/bindings/sound/samsung,espresso-audio.yaml b/Documentation/devicetree/bindings/sound/samsung,espresso-audio.yaml
new file mode 100644
index 000000000000..15da4e0fa0b3
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/samsung,espresso-audio.yaml
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/samsung,espresso-audio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Galaxy Tab 2 (espresso) audio complex with WM1811 codec
+
+maintainers:
+  - Ryan Brue <ryanbrue.dev@gmail.com>
+
+description:
+  The Samsung Galaxy Tab 2 7.0 and 10.1 (espresso) tablets have a WM1811 codec
+  on McBSP3 of the OMAP4430. The codec provides the bit and frame clocks and
+  runs its FLL from MCLK1. The main and headset microphones have their mic
+  bias switched by GPIOs.
+
+allOf:
+  - $ref: sound-card-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,espresso-audio
+
+  cpu:
+    type: object
+    additionalProperties: false
+    properties:
+      sound-dai:
+        maxItems: 1
+        description: phandle to the McBSP
+    required:
+      - sound-dai
+
+  codec:
+    type: object
+    additionalProperties: false
+    properties:
+      sound-dai:
+        maxItems: 1
+        description: phandle to the WM1811 codec
+    required:
+      - sound-dai
+
+  audio-routing:
+    description:
+      List of the connections between audio components; each entry is a pair
+      of strings, the first being the connection's sink, the second being the
+      connection's source; valid names for sources and sinks are the WM1811's
+      pins (as documented in its binding), and the jacks on the board, HP,
+      SPK, RCV, LINE, Main Mic and Headset Mic.
+
+  mic-bias-supply:
+    description: Supply for the mic bias of the main microphone
+
+  headset-mic-bias-supply:
+    description: Supply for the mic bias of the headset microphone
+
+required:
+  - compatible
+  - model
+  - cpu
+  - codec
+  - audio-routing
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    sound {
+        compatible = "samsung,espresso-audio";
+        model = "GalaxyTab2";
+
+        mic-bias-supply = <&main_mic_bias>;
+        headset-mic-bias-supply = <&ear_mic_bias>;
+
+        audio-routing =
+            "HP", "HPOUT1L",
+            "HP", "HPOUT1R",
+            "SPK", "SPKOUTLN",
+            "SPK", "SPKOUTLP",
+            "SPK", "SPKOUTRN",
+            "SPK", "SPKOUTRP",
+            "IN1LP", "Main Mic",
+            "IN1LN", "Main Mic",
+            "IN1RP", "Headset Mic",
+            "IN1RN", "Headset Mic",
+            "Headset Mic", "MICBIAS2";
+
+        cpu {
+            sound-dai = <&mcbsp3>;
+        };
+
+        codec {
+            sound-dai = <&wm1811>;
+        };
+    };
-- 
