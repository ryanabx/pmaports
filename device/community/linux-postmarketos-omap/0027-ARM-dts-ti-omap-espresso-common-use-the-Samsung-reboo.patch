From 6af45ce5770b267755cf713521b7af084470b8d7 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Thu, 24 Sep 2026 13:22:53 -0500
Subject: [PATCH] ARM: dts: ti: omap: espresso-common: use the Samsung reboot
 mode driver

Use samsung,espresso-reboot-mode, which writes the tag with the flag (the bootloader ignores the flag otherwise). The DT patch then depends on the binding and driver commits. Squash before sending.

Assisted-by: LLM
---
 arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
index 0f0553d58bd4..0ed9583da1d2 100644
--- a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
+++ b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
@@ -763,10 +763,9 @@ &sar_target {
 };
 
 &sar_ram {
-	/* The Samsung bootloader takes its boot mode from this word */
+	/* The Samsung bootloader takes its boot mode from the end of SAR bank 1 */
 	reboot-mode {
-		compatible = "syscon-reboot-mode";
-		offset = <0xff8>;
+		compatible = "samsung,espresso-reboot-mode";
 		mode-normal = <0x1>;
 		mode-recovery = <0x2>;
 		mode-download = <0x20>;
-- 
2.55.0

