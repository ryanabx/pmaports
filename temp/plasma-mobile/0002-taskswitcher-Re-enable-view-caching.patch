From f4afba364aea4960f521ff6e49497f878038deef Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Sun, 15 Nov 2026 12:07:52 -0600
Subject: [PATCH 2/2] taskswitcher: Re-enable view caching

Rebuilding the switcher's scene on every open costs a few hundred
milliseconds on slow GPUs. The background work that made caching
inefficient came from hidden thumbnails rendering their windows; the
previous commit hides them while the effect is not shown.
---
 kwin/mobiletaskswitcher/plugin/mobiletaskswitchereffect.cpp | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/kwin/mobiletaskswitcher/plugin/mobiletaskswitchereffect.cpp b/kwin/mobiletaskswitcher/plugin/mobiletaskswitchereffect.cpp
index cbe487e33..c261d1846 100644
--- a/kwin/mobiletaskswitcher/plugin/mobiletaskswitchereffect.cpp
+++ b/kwin/mobiletaskswitcher/plugin/mobiletaskswitchereffect.cpp
@@ -36,8 +36,7 @@ void MobileTaskSwitcherState::init(KWin::QuickSceneEffect *parent)
     m_taskModel = new TaskModel{parent};
     m_effect = parent;
 
-    // Disable view caching for now - there is still background CPU usage from the KWin effect that makes it inefficient
-    // m_effect->setViewCachingEnabled(true);
+    m_effect->setViewCachingEnabled(true);
 
     // Connect signals
     connect(m_effect, &QuickSceneEffect::activated, this, &MobileTaskSwitcherState::activated);
-- 
