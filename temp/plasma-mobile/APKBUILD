# Forked from Alpine's community/plasma-mobile (master, 6.8.3-r0, 2026-11-15)
# for amazon-suez: 0001-0002 turn the task switcher's KWin view caching back
# on (upstream disabled it in 0113ff773 for background CPU), with window
# thumbnails and the desktop background hidden while the switcher is not
# shown. Every open after the first no longer rebuilds the switcher's QML
# scene and buffers: worst frame per open 176-304 -> 64-128 ms on the GX6250,
# KWin idle CPU unchanged. Needs temp/kwin r102 (0003-0005). LOCAL until
# upstream has them (unsent; suez-work notes/PLASMA-LOCKSCREEN-REDRAW-2026-11-14.md
# §11, §12). 0003 (r101) makes MarqueeLabel scroll once each time it is
# shown instead of looping: one quick settings label that overflowed its tile
# by 2 px kept the action drawer, and KWin, rendering every frame while it was
# open (§13). 0004 (r102) draws neither the wallpaper nor the masked blur
# under a full wallpaper blur: plasmashell's GPU time per app drawer frame
# ~20.5 -> 13.7 ms (§15). 0005 (r103) masks the app drawer's edges only while
# apps reach them: the drawer opens at 60 fps, ~70 MB less GPU memory (§16).
# 0006 (r104) gives the quick settings panel the simple shadow: action drawer
# frame 10.5 -> 6.2 ms GPU (§17).
#
# pkgrel is far above Alpine's so that a rebuild of the same version does not
# silently replace it; rebase onto each new plasma-mobile version.
# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-plasma
maintainer="team/kde <bribbers@disroot.org>"
pkgname=plasma-mobile
pkgver=6.8.3
pkgrel=104
pkgdesc="Modules providing phone functionality for Plasma"
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://www.plasma-mobile.org/"
license="GPL-2.0-or-later AND LGPL-2.1-or-later"
depends="
	bluez-qt
	breeze-icons
	dbus-x11
	feedbackd
	kpipewire
	kquickcharts
	plasma-activities
	plasma-keyboard
	plasma-nano
	plasma-nm
	plasma-pa
	plasma-settings
	plasma-workspace
	qqc2-breeze-style
	"
makedepends="
	extra-cmake-modules
	kauth-dev
	kbookmarks-dev
	kcodecs-dev
	kcompletion-dev
	kconfig-dev
	kconfigwidgets-dev
	kcoreaddons-dev
	kdbusaddons-dev
	kdeclarative-dev
	ki18n-dev
	kio-dev
	kirigami-addons-dev
	kitemviews-dev
	kjobwidgets-dev
	knotifications-dev
	kpackage-dev
	kpeople-dev
	kservice-dev
	kwayland-dev
	kwidgetsaddons-dev
	kwin-dev
	kwindowsystem-dev
	kxmlgui-dev
	libphonenumber-dev
	libplasma-dev
	modemmanager-qt-dev
	networkmanager-qt-dev
	plasma-activities-dev
	plasma-workspace-dev
	qcoro-dev
	qt6-qtdeclarative-dev
	samurai
	solid-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-lang
	$pkgname-systemd
	$pkgname-waydroid
	"
provides="plasma-phone-components=$pkgver-r$pkgrel" # For backwards compatibility
replaces="plasma-phone-components" # For backwards compatibility


case "$pkgver" in
	*.*.9*) _rel=unstable;;
	*) _rel=stable;;
esac
_repo_url="https://invent.kde.org/plasma/plasma-mobile.git"
source="https://download.kde.org/$_rel/plasma/$pkgver/plasma-mobile-$pkgver.tar.xz
	99-flashlight.rules
	0001-taskswitcher-Hide-window-thumbnails-while-the-effect.patch
	0002-taskswitcher-Re-enable-view-caching.patch
	0003-MarqueeLabel-Scroll-through-the-text-once-each-time-.patch
	0004-BlurEffect-Draw-neither-the-wallpaper-nor-the-masked.patch
	0005-folio-Mask-the-app-drawer-s-edges-only-while-apps-re.patch
	0006-actiondrawer-Give-the-quick-settings-panel-the-simpl.patch
	"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DINSTALL_SYSTEMD_SERVICE=ON
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	install -Dm644 "$srcdir"/99-flashlight.rules -t "$pkgdir"/usr/lib/udev/rules.d/
}

waydroid() {
	pkgdesc="$pkgdesc - Waydroid integration"
	install_if="$pkgname=$pkgver-r$pkgrel waydroid"

	amove usr/lib/libexec/kf6/kauth/waydroidhelper
	amove usr/lib/qt6/plugins/plasma/kcms/systemsettings/kcm_waydroidintegration.so
	amove usr/lib/qt6/qml/org/kde/plasma/private/mobileshell/waydroidintegrationplugin
	amove usr/share/applications/kcm_waydroidintegration.desktop
	amove usr/share/dbus-1/system-services/*waydroidhelper.service
	amove usr/share/dbus-1/system.d/*waydroidhelper.conf
	amove usr/share/plasma/quicksettings/*waydroid
	amove usr/share/polkit-1/actions/*waydroidhelper.policy
}

