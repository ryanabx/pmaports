# Forked from Alpine to add systemd!
# Forked again from Nura's extra-repos/systemd/kwin (main 0de6563605,
# 6.8.3-r0, 2026-11-14) for amazon-suez: 0001 advances slidingpopups'
# animations in prePaintScreen, so a popup that slides in below the boot lock
# screen no longer keeps KWin repainting at 60 fps (~70 % CPU) until unlock.
# 0002 compiles colour-transform shaders per transfer-function pair, so the
# GPU does not run every transfer function per pixel (1080p video composite
# 38 -> 9.3 ms on the GX6250 with temp/mesa r2; §6). LOCAL fixes until upstream
# has them (unsent; suez-work notes/PLASMA-LOCKSCREEN-REDRAW-2026-11-14.md
# §2, §6). Tests are not built
# (BUILD_TESTING=OFF; the aport never ran them).
#
# pkgrel is far above Nura's so that a rebuild of the same version does not
# silently replace it; rebase onto each new KWin version.
maintainer="team/kde <bribbers@disroot.org>"
pkgname=kwin
_pkgver=6.8.3
pkgver=9999$_pkgver
pkgrel=101
pkgdesc="An easy to use, but flexible, composited Window Manager"
# armhf blocked by qt6-qtdeclarative
# riscv64: slow Alpine builders
arch="all !armhf !riscv64"
url="https://kde.org/plasma-desktop/"
license="GPL-2.0-or-later AND (GPL-2.0-only OR GPL-3.0-only) AND LGPL-2.1-only"
depends="
	aurorae
	hwdata
	kirigami
	qt6-qtmultimedia
	qt6-qtwayland
	"
depends_dev="
	breeze-dev
	fontconfig-dev
	kcmutils-dev
	kcompletion-dev
	kconfig-dev
	kconfigwidgets-dev
	kcoreaddons-dev
	kcrash-dev
	kdeclarative-dev
	kdecoration-dev
	kglobalaccel-dev
	ki18n-dev
	kiconthemes-dev
	kidletime-dev
	kio-dev
	knewstuff-dev
	knighttime-dev
	knotifications-dev
	kpackage-dev
	krunner-dev
	kscreenlocker-dev
	kservice-dev
	ksvg-dev
	ktextwidgets-dev
	kwayland-dev
	kwidgetsaddons-dev
	kwindowsystem-dev
	kxmlgui-dev
	lcms2-dev
	libdrm-dev
	libepoxy-dev
	libinput-dev
	libplasma-dev
	libqaccessibilityclient-dev
	libxcvt-dev
	libxi-dev
	libxkbcommon-dev
	mesa-dev
	mesa-gbm
	pipewire-dev
	plasma-activities-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	qt6-qtsensors-dev
	wayland-dev
	xcb-util-cursor-dev
	xcb-util-image-dev
	xcb-util-wm-dev
	"
case "$CARCH" in
	armv7|x86) ;;
	*) depends_dev="$depends_dev libevdev-dev"
esac
makedepends="$depends_dev
	extra-cmake-modules
	kdoctools-dev
	kglobalacceld-dev
	kpipewire-dev
	libcap-utils
	libdisplay-info-dev
	libei-dev
	plasma-wayland-protocols
	qt6-qttools-dev
	samurai
	systemd-dev
	"
checkdepends="xwayland-run"

case "$_pkgver" in
	*.90*) _rel=unstable;;
	*) _rel=stable;;
esac
subpackages="
	$pkgname-systemd
	$pkgname-dbg
	$pkgname-dev
	$pkgname-lang
	"
_repo_url="https://invent.kde.org/plasma/kwin.git"
source="https://download.kde.org/stable/plasma/$(echo $_pkgver | cut -d . -f 1-3)/kwin-$_pkgver.tar.xz
	0001-slidingpopups-advance-animations-in-prePaintScreen.patch
	0002-opengl-specialise-colour-transform-shaders.patch
	"
# Broken, fails to setup due to missing or invalid XDG_RUNTIME_DIR?
options="setcap !check"
builddir="$srcdir/$pkgname-$_pkgver"

build() {
	# significantly reduce debug symbol size
	# use None here to not make cmake pass bare -g (-g2)
	CFLAGS="$CFLAGS -O2 -g1" CXXFLAGS="$CXXFLAGS -O2 -g1" \
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_TESTING=OFF
	cmake --build build
}

check() {
	XDG_RUNTIME_DIR="$(mktemp -p -d "$builddir")" \
	wlheadless-run -- ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
