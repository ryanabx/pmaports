1777a0c30cfa9fbcdcc1cf44e95822c6521b3ba95fb7a49e01a11e8107f24c0850b18fe2ac88fb1c1f88dfc5c2ed4ef17e081ef4e5a3cfbf4fb28c715f3935c5  select.patch
1255350a75306f636491ae968bb0ea8c5d71bd6ff76a204a43fec89fff8d5d01dc12612b1e8f4b0974b8e2374f50cc32b450f782b871ecec6b8c5fe61facd2d3  0001-GStreamer-enable-dmabuf-rendering-for-wayland-egl-and-desktop.patch
