+/* LOCAL DEBUG: PVR_MEM_REPORT, see pvr_bo.h. */
+DEBUG_GET_ONCE_NUM_OPTION(pvr_mem_report, "PVR_MEM_REPORT", 0)
+
+static unsigned pvr_mem_report_bucket(const struct pvr_device *device,
+                                      const struct pvr_winsys_heap *heap)
+{
+   const struct pvr_winsys_heap *const heaps[] = {
+      device->heaps.general_heap,       device->heaps.pds_heap,
+      device->heaps.rgn_hdr_heap,       device->heaps.transfer_frag_heap,
+      device->heaps.usc_heap,           device->heaps.vis_test_heap,
+   };
+
+   for (unsigned i = 0; i < ARRAY_SIZE(heaps); i++) {
+      if (heap == heaps[i])
+         return i;
+   }
+
+   return ARRAY_SIZE(heaps);
+}
+
+void pvr_mem_report_bo(struct pvr_device *device,
+                       const struct pvr_winsys_heap *heap,
+                       int64_t size)
+{
+   if (!debug_get_option_pvr_mem_report())
+      return;
+
+   const unsigned b = pvr_mem_report_bucket(device, heap);
+
+   p_atomic_add(&device->mem_report.bo_bytes[b], size);
+   p_atomic_add(&device->mem_report.bo_count[b], size > 0 ? 1 : -1);
+}
+
+void pvr_mem_report_memory(struct pvr_device *device,
+                           bool imported,
+                           int64_t size)
+{
+   if (!debug_get_option_pvr_mem_report())
+      return;
+
+   p_atomic_add(&device->mem_report.mem_bytes[imported], size);
+   p_atomic_add(&device->mem_report.mem_count[imported], size > 0 ? 1 : -1);
+}
+
+void pvr_mem_report(struct pvr_device *device, bool force)
+{
+   static const char *const names[] = {
+      "general", "pds", "rgn_hdr", "transfer", "usc", "vis_test", "other",
+   };
+   const int64_t interval_s = debug_get_option_pvr_mem_report();
+   const uint64_t now_ms = os_time_get_nano() / 1000000;
+   const uint64_t last_ms = p_atomic_read(&device->mem_report.last_ms);
+   int64_t internal = 0;
+   char line[640];
+   int n;
+
+   if (interval_s <= 0)
+      return;
+
+   if (!force && (now_ms - last_ms < (uint64_t)interval_s * 1000 ||
+                  p_atomic_cmpxchg(&device->mem_report.last_ms,
+                                   last_ms,
+                                   now_ms) != last_ms)) {
+      return;
+   }
+
+   n = snprintf(line,
+                sizeof(line),
+                "pvr-mem: pid %d dev %p%s: memory %d/%" PRId64
+                " KiB, imported %d/%" PRId64 " KiB; internal",
+                (int)getpid(),
+                (void *)device,
+                force ? " (destroy)" : "",
+                device->mem_report.mem_count[0],
+                device->mem_report.mem_bytes[0] / 1024,
+                device->mem_report.mem_count[1],
+                device->mem_report.mem_bytes[1] / 1024);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(names) && n < (int)sizeof(line); i++) {
+      internal += device->mem_report.bo_bytes[i];
+      n += snprintf(line + n,
+                    sizeof(line) - n,
+                    " %s %d/%" PRId64,
+                    names[i],
+                    device->mem_report.bo_count[i],
+                    device->mem_report.bo_bytes[i] / 1024);
+   }
+
+   if (n < (int)sizeof(line)) {
+      snprintf(line + n,
+               sizeof(line) - n,
+               " = %" PRId64 " KiB (of which SPM scratch %" PRIu64 " KiB)\n",
+               internal / 1024,
+               pvr_spm_scratch_buffer_store_size(device) / 1024);
+   }
+
+   fputs(line, stderr);
+}
