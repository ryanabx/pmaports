From 3b7562fefeaa59726d41482e5c8723609772861e Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Mon, 9 Nov 2026 23:21:06 -0600
Subject: [PATCH] LOCAL: pvr: linear layout for large non-power-of-two colour
 images

Local patch for amazon-sheldonp; not to be sent. Twiddled images are
padded to power-of-two dimensions, so 1920x1080 render targets take
2048x2048. With every GPU buffer pinned, the Plasma Bigscreen session
(plasma-keyboard 165 MiB, plasmashell 131 MiB, KWin 88 MiB) ran the
844 MiB stick out of memory. Keep single-level 2D colour images linear
when padding would waste more than a quarter; PVR_TWIDDLE_ALL=1 turns
it off.

Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_image.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/src/imagination/vulkan/pvr_image.c b/src/imagination/vulkan/pvr_image.c
index 654ba7761a0..869fa99719e 100644
--- a/src/imagination/vulkan/pvr_image.c
+++ b/src/imagination/vulkan/pvr_image.c
@@ -38,6 +38,7 @@
 #include "pvr_physical_device.h"
 #include "pvr_tex_state.h"
 #include "util/macros.h"
+#include "util/u_debug.h"
 #include "util/u_math.h"
 #include "vk_format.h"
 #include "vk_image.h"
@@ -46,6 +47,33 @@
 #include "vk_util.h"
 #include "wsi_common.h"
 
+/* LOCAL: twiddled images are padded to power-of-two dimensions, so a
+ * 1920x1080 render target takes 2048x2048. On the 844 MiB Fire TV Stick,
+ * where every GPU buffer is pinned, that ran the desktop out of memory.
+ * Keep single-level 2D colour images linear when padding would waste more
+ * than a quarter of the memory (PVR_TWIDDLE_ALL=1 disables this).
+ */
+static bool pvr_image_prefer_linear(const struct pvr_image *image)
+{
+   const VkExtent3D *e = &image->vk.extent;
+   uint64_t size, padded;
+
+   if (debug_get_bool_option("PVR_TWIDDLE_ALL", false))
+      return false;
+
+   if (image->vk.image_type != VK_IMAGE_TYPE_2D || image->vk.mip_levels > 1 ||
+       image->vk.array_layers > 1 || image->vk.samples > 1 ||
+       !vk_format_is_color(image->vk.format) ||
+       vk_format_is_compressed(image->vk.format))
+      return false;
+
+   size = (uint64_t)e->width * e->height;
+   padded = (uint64_t)util_next_power_of_two(e->width) *
+            util_next_power_of_two(e->height);
+
+   return size >= 256 * 256 && padded * 4 > size * 5;
+}
+
 static void pvr_image_init_memlayout(struct pvr_image *image)
 {
    switch (image->vk.tiling) {
@@ -57,6 +85,8 @@ static void pvr_image_init_memlayout(struct pvr_image *image)
          image->memlayout = PVR_MEMLAYOUT_LINEAR;
       else if (image->vk.image_type == VK_IMAGE_TYPE_3D)
          image->memlayout = PVR_MEMLAYOUT_3DTWIDDLED;
+      else if (pvr_image_prefer_linear(image))
+         image->memlayout = PVR_MEMLAYOUT_LINEAR;
       else
          image->memlayout = PVR_MEMLAYOUT_TWIDDLED;
       break;
-- 
