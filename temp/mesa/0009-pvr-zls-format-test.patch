From 67d4840432d02370ae80437230f42a026b81835b Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Mon, 9 Nov 2026 22:01:45 -0600
Subject: [PATCH] LOCAL TEST: pvr: PVR_TEST_ZLS forces the ZLS load/store
 format codes

Local experiment for the GE8300 on amazon-sheldonp; not to be sent.
Integer depth formats reject depth-writing objects; see whether the
ISP_ZLSCTL format fields alone trigger it.

Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_arch_job_render.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/imagination/vulkan/pvr_arch_job_render.c b/src/imagination/vulkan/pvr_arch_job_render.c
index a49bd476d14..f64a71412a3 100644
--- a/src/imagination/vulkan/pvr_arch_job_render.c
+++ b/src/imagination/vulkan/pvr_arch_job_render.c
@@ -24,6 +24,7 @@
 #include <assert.h>
 #include <stdbool.h>
 #include <stdint.h>
+#include <stdio.h>
 #include <stdlib.h>
 
 #include "util/u_debug.h"
@@ -1007,6 +1008,21 @@ static void pvr_frag_state_stream_init(struct pvr_render_ctx *ctx,
          value.zloadformat = job->ds.zls_format;
          value.zstoreformat = job->ds.zls_format;
 
+         /* LOCAL TEST: PVR_TEST_ZLS=<load>,<store> forces the ZLS format
+          * codes (0 F32Z, 1 24BITINT, 2 16BITINT, 3 F64Z); -1 keeps one.
+          */
+         {
+            const char *zls = getenv("PVR_TEST_ZLS");
+            int zl = -1, zs = -1;
+
+            if (zls && sscanf(zls, "%d,%d", &zl, &zs) >= 1) {
+               if (zl >= 0)
+                  value.zloadformat = zl;
+               if (zs >= 0)
+                  value.zstoreformat = zs;
+            }
+         }
+
          zload_format = value.zloadformat;
       }
 
