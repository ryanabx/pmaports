From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Wed, 11 Nov 2026 20:51:24 -0600
Subject: [PATCH 37/57] LOCAL: pvr: a zero texture for null sampled images, no
 null check on texture sampling (PVR_NULL_TEX_CHECK=1 keeps it)

Generated-by: LLM
---
 src/imagination/pco/pco_internal.h            |  4 ++++
 src/imagination/pco/pco_nir.c                 | 16 +++++++++----
 .../pco/pco_nir_lower_null_descriptors.c      | 18 ++++++++++++++
 .../vulkan/pvr_arch_descriptor_set.c          | 22 +++++++++++++++++
 src/imagination/vulkan/pvr_arch_device.c      | 24 +++++++++++++++++++
 src/imagination/vulkan/pvr_device.h           |  5 ++++
 6 files changed, 84 insertions(+), 5 deletions(-)

diff --git a/src/imagination/pco/pco_internal.h b/src/imagination/pco/pco_internal.h
index 942b0b602d1..08b29e4cb8c 100644
--- a/src/imagination/pco/pco_internal.h
+++ b/src/imagination/pco/pco_internal.h
@@ -1863,6 +1863,10 @@ typedef enum {
    pco_nir_lower_null_descriptor_image = (1 << 3),
 
    pco_nir_lower_null_descriptor_all = BITFIELD_MASK(4),
+   /* LOCAL: only queries and texel buffers among texture ops (the driver
+    * writes a zero texture for null sampled images).
+    */
+   pco_nir_lower_null_descriptor_texture_queries_only = (1 << 4),
 } pco_nir_lower_null_descriptor_options;
 
 bool pco_nir_lower_null_descriptors(
diff --git a/src/imagination/pco/pco_nir.c b/src/imagination/pco/pco_nir.c
index cb009cb83e1..2815bef8d02 100644
--- a/src/imagination/pco/pco_nir.c
+++ b/src/imagination/pco/pco_nir.c
@@ -16,6 +16,7 @@
 #include "pco.h"
 #include "pco_internal.h"
 #include "pvr_limits.h"
+#include "util/u_debug.h"
 
 #include <stdio.h>
 
@@ -1020,11 +1021,16 @@ void pco_lower_nir(pco_ctx *ctx, nir_shader *nir, pco_data *data)
       /* PROTOTYPE: null UBO descriptors point at a zeroed buffer
        * (pvr_device::null_buffer), so UBO loads are left unguarded.
        */
-      NIR_PASS(_,
-               nir,
-               pco_nir_lower_null_descriptors,
-               pco_nir_lower_null_descriptor_all &
-                  ~pco_nir_lower_null_descriptor_ubo);
+      pco_nir_lower_null_descriptor_options null_opts =
+         pco_nir_lower_null_descriptor_all &
+         ~pco_nir_lower_null_descriptor_ubo;
+      /* The driver writes a zero texture for null sampled images
+       * (pvr_device.h, null_tex_state); PVR_NULL_TEX_CHECK=1 keeps the
+       * check on every texture read.
+       */
+      if (!debug_get_bool_option("PVR_NULL_TEX_CHECK", false))
+         null_opts |= pco_nir_lower_null_descriptor_texture_queries_only;
+      NIR_PASS(_, nir, pco_nir_lower_null_descriptors, null_opts);
    }
 
    NIR_PASS(_, nir, pco_nir_lower_vk, data);
diff --git a/src/imagination/pco/pco_nir_lower_null_descriptors.c b/src/imagination/pco/pco_nir_lower_null_descriptors.c
index 0b0a3d1fd98..e46362d0eab 100644
--- a/src/imagination/pco/pco_nir_lower_null_descriptors.c
+++ b/src/imagination/pco/pco_nir_lower_null_descriptors.c
@@ -70,6 +70,24 @@ static nir_def *get_is_null(nir_builder *b,
          return NULL;
 
       nir_tex_instr *tex = nir_instr_as_tex(instr);
+
+      if ((options & pco_nir_lower_null_descriptor_texture_queries_only) &&
+          tex->sampler_dim != GLSL_SAMPLER_DIM_BUF) {
+         switch (tex->op) {
+         case nir_texop_tex:
+         case nir_texop_txb:
+         case nir_texop_txl:
+         case nir_texop_txd:
+         case nir_texop_txf:
+         case nir_texop_txf_ms:
+         case nir_texop_tg4:
+         case nir_texop_lod:
+            return NULL;
+         default:
+            break;
+         }
+      }
+
       nir_def *deref_def = nir_get_tex_src(tex, nir_tex_src_texture_deref);
       if (!deref_def)
          return NULL;
diff --git a/src/imagination/vulkan/pvr_arch_descriptor_set.c b/src/imagination/vulkan/pvr_arch_descriptor_set.c
index e1c6d5ca29f..a0c1b80d4c5 100644
--- a/src/imagination/vulkan/pvr_arch_descriptor_set.c
+++ b/src/imagination/vulkan/pvr_arch_descriptor_set.c
@@ -112,6 +112,18 @@ write_sampler(const struct pvr_descriptor_set *set,
    memcpy(desc_mapping, &sampler_desc, sizeof(sampler_desc));
 }
 
+/* LOCAL: the device's null texture (see pvr_device.h), if any. */
+static const struct pvr_image_descriptor *
+null_tex_state(const struct pvr_descriptor_set *set)
+{
+   const struct pvr_device *device =
+      container_of(set->layout->vk.base.device, struct pvr_device, vk);
+
+   return device->null_state.null_tex_valid
+             ? &device->null_state.null_tex_state
+             : NULL;
+}
+
 static void
 write_image_sampler(const struct pvr_descriptor_set *set,
                     const VkDescriptorImageInfo *image_info,
@@ -153,6 +165,8 @@ write_image_sampler(const struct pvr_descriptor_set *set,
                image_view->sampler_words[i];
          }
       }
+   } else if (null_tex_state(set)) {
+      image_sampler_desc.image = *null_tex_state(set);
    }
 
    memcpy(desc_mapping, &image_sampler_desc, sizeof(image_sampler_desc));
@@ -187,6 +201,14 @@ write_sampled_image(const struct pvr_descriptor_set *set,
    const unsigned desc_offset = binding->offset + (elem * binding->stride);
    void *desc_mapping = (uint8_t *)set->mapping + desc_offset;
 
+   if (image_view == NULL) {
+      if (null_tex_state(set))
+         memcpy(desc_mapping, null_tex_state(set), sizeof(struct pvr_image_descriptor));
+      else
+         memset(desc_mapping, 0, sizeof(struct pvr_image_descriptor));
+      return;
+   }
+
    struct pvr_image_descriptor sampled_image_desc =
       image_view->image_state[PVR_TEXTURE_STATE_SAMPLE];
 
diff --git a/src/imagination/vulkan/pvr_arch_device.c b/src/imagination/vulkan/pvr_arch_device.c
index 41bb5404090..e4ac12db1c1 100644
--- a/src/imagination/vulkan/pvr_arch_device.c
+++ b/src/imagination/vulkan/pvr_arch_device.c
@@ -912,6 +912,30 @@ VkResult PVR_PER_ARCH(create_device)(struct pvr_physical_device *pdevice,
     * possible for the zero page.
     */
    result = pvr_init_null_pages(device);
+   if (result == VK_SUCCESS) {
+      /* LOCAL: see pvr_device.h, null_state.null_tex_state. */
+      struct pvr_texture_state_info null_tex_info = {
+         .format = VK_FORMAT_R8G8B8A8_UNORM,
+         .mem_layout = PVR_MEMLAYOUT_TWIDDLED,
+         .type = VK_IMAGE_VIEW_TYPE_2D,
+         .aspect_mask = VK_IMAGE_ASPECT_COLOR_BIT,
+         .tex_state_type = PVR_TEXTURE_STATE_SAMPLE,
+         .extent = { .width = 1, .height = 1, .depth = 1 },
+         .mip_levels = 1,
+         .sample_count = 1,
+         .stride = 1,
+         .swizzle = { PIPE_SWIZZLE_X, PIPE_SWIZZLE_Y, PIPE_SWIZZLE_Z,
+                      PIPE_SWIZZLE_W },
+         .addr = device->null_state.zero_bo->vma->dev_addr,
+      };
+      memset(&device->null_state.null_tex_state, 0,
+             sizeof(device->null_state.null_tex_state));
+      device->null_state.null_tex_valid =
+         pvr_arch_pack_tex_state(device,
+                                 &null_tex_info,
+                                 &device->null_state.null_tex_state) ==
+         VK_SUCCESS;
+   }
    if (result != VK_SUCCESS)
       goto err_dec_device_count;
 
diff --git a/src/imagination/vulkan/pvr_device.h b/src/imagination/vulkan/pvr_device.h
index 2fc822f3308..66dab791fdd 100644
--- a/src/imagination/vulkan/pvr_device.h
