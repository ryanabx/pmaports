From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Mon, 9 Nov 2026 20:37:12 -0600
Subject: [PATCH 48/56] LOCAL DEBUG: pvr: PVR_DUMP_RGN dumps region headers on
 teardown

Debug aid for the format v1 bring-up on amazon-sheldonp; never sent.
PVR_DUMP_RGN=<bytes> maps the region-header buffer for the CPU and
hex-dumps its first <bytes> when the render target dataset is freed.

Assisted-by: LLM
---
 src/imagination/vulkan/pvr_arch_job_render.c |  5 ++-
 src/imagination/vulkan/pvr_rt_dataset.c      | 36 ++++++++++++++++++++
 2 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/src/imagination/vulkan/pvr_arch_job_render.c b/src/imagination/vulkan/pvr_arch_job_render.c
index e279be7b70a..7603abcefaf 100644
--- a/src/imagination/vulkan/pvr_arch_job_render.c
+++ b/src/imagination/vulkan/pvr_arch_job_render.c
@@ -24,6 +24,7 @@
 #include <assert.h>
 #include <stdbool.h>
 #include <stdint.h>
+#include <stdlib.h>
 #include <vulkan/vulkan.h>
 
 #include "hwdef/rogue_hw_defs.h"
@@ -493,7 +494,9 @@ pvr_rt_rgn_headers_data_init(struct pvr_device *device,
                          device->heaps.rgn_hdr_heap,
                          rgn_headers_size * num_rt_datas,
                          ROGUE_CR_TE_PSGREGION_ADDR_BASE_ALIGNMENT,
-                         PVR_BO_ALLOC_FLAG_GPU_UNCACHED,
+                         PVR_BO_ALLOC_FLAG_GPU_UNCACHED |
+                            (getenv("PVR_DUMP_RGN") ?
+                                PVR_BO_ALLOC_FLAG_CPU_MAPPED : 0),
                          &rt_dataset->rgn_headers_bo);
    if (result != VK_SUCCESS)
       return result;
diff --git a/src/imagination/vulkan/pvr_rt_dataset.c b/src/imagination/vulkan/pvr_rt_dataset.c
index 8f110ce707b..0e2feb83f1c 100644
--- a/src/imagination/vulkan/pvr_rt_dataset.c
+++ b/src/imagination/vulkan/pvr_rt_dataset.c
@@ -9,8 +9,44 @@
 #include "pvr_device.h"
 #include "pvr_free_list.h"
 
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+/* LOCAL DEBUG: PVR_DUMP_RGN=<bytes> dumps the region headers on teardown. */
+static void pvr_rt_rgn_headers_dump(struct pvr_rt_dataset *rt_dataset)
+{
+   const char *env = getenv("PVR_DUMP_RGN");
+   const struct pvr_bo *bo = rt_dataset->rgn_headers_bo;
+   const uint8_t *p;
+   uint64_t n;
+
+   if (!env || !bo || !bo->bo->map)
+      return;
+
+   p = bo->bo->map;
+   n = MIN2((uint64_t)strtoul(env, NULL, 0), bo->bo->size);
+
+   fprintf(stderr,
+           "rgn dump: %ux%u dev 0x%" PRIx64 " size 0x%" PRIx64
+           " stride 0x%" PRIx64 "\n",
+           rt_dataset->width,
+           rt_dataset->height,
+           bo->vma->dev_addr.addr,
+           bo->bo->size,
+           rt_dataset->rgn_headers_stride);
+   for (uint64_t i = 0; i < n; i += 16) {
+      fprintf(stderr, "  %04" PRIx64 ":", i);
+      for (uint64_t j = i; j < i + 16 && j < n; j++)
+         fprintf(stderr, " %02x", p[j]);
+      fprintf(stderr, "\n");
+   }
+}
+
 static void pvr_rt_rgn_headers_data_fini(struct pvr_rt_dataset *rt_dataset)
 {
+   pvr_rt_rgn_headers_dump(rt_dataset);
+
    for (uint32_t i = 0; i < ARRAY_SIZE(rt_dataset->rt_datas); i++)
       rt_dataset->rt_datas[i].rgn_headers_dev_addr = PVR_DEV_ADDR_INVALID;
 
