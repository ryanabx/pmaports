@@ -34,6 +34,11 @@
 #include "zink_resource.h"
 #include "zink_screen.h"
 #include "util/u_hash_table.h"
+#include "util/os_time.h"
+#include "util/u_debug.h"
+#include "util/u_atomic.h"
+#include <inttypes.h>
+#include <unistd.h>
 
 #ifdef HAVE_LIBDRM
 #define ZINK_USE_DMABUF
@@ -84,6 +89,44 @@ zink_slab(struct pb_slab *pslab)
    return (struct zink_slab*)pslab;
 }
 
+/* LOCAL DEBUG: ZINK_MEM_REPORT, see zink_bo.h. */
+DEBUG_GET_ONCE_NUM_OPTION(zink_mem_report, "ZINK_MEM_REPORT", 0)
+
+#define ZINK_MEM_REPORT_ADD(screen, what, size)                               \
+   do {                                                                       \
+      if (debug_get_option_zink_mem_report()) {                               \
+         p_atomic_add(&(screen)->mem_report.what##_bytes, (int64_t)(size));   \
+         p_atomic_add(&(screen)->mem_report.what##_count,                     \
+                      (int64_t)(size) > 0 ? 1 : -1);                          \
+      }                                                                       \
+   } while (0)
+
+void
+zink_mem_report(struct zink_screen *screen)
+{
+   const int64_t interval_s = debug_get_option_zink_mem_report();
+   const uint64_t now_ms = os_time_get_nano() / 1000000;
+   const uint64_t last_ms = p_atomic_read(&screen->mem_report.last_ms);
+
+   if (interval_s <= 0 || now_ms - last_ms < (uint64_t)interval_s * 1000 ||
+       p_atomic_cmpxchg(&screen->mem_report.last_ms, last_ms, now_ms) != last_ms)
+      return;
+
+   fprintf(stderr,
+           "zink-mem: pid %d screen %p: VkDeviceMemory %d/%" PRId64
+           " KiB; slab backing %d/%" PRId64 " KiB holding %d entries of %" PRId64
+           " KiB; idle in BO cache %" PRIu64 " KiB (cap %" PRIu64 " KiB)\n",
+           (int)getpid(), (void *)screen,
+           screen->mem_report.real_count, screen->mem_report.real_bytes / 1024,
+           screen->mem_report.slab_count, screen->mem_report.slab_bytes / 1024,
+           screen->mem_report.entry_count, screen->mem_report.entry_bytes / 1024,
+           screen->pb.bo_cache.cache_size / 1024,
+           screen->pb.bo_cache.max_cache_size / 1024);
+
+   if (zink_debug & ZINK_DEBUG_MEM)
+      zink_debug_mem_print_stats(screen);
+}
+
 /* Return the power of two size of a slab entry matching the input size. */
 static unsigned
 get_slab_pot_entry_size(struct zink_screen *screen, unsigned size)
@@ -150,6 +193,7 @@ bo_destroy(struct zink_screen *screen, struct zink_bo *bo)
       zink_bo_unmap(screen, bo);
    }
 
+   ZINK_MEM_REPORT_ADD(screen, real, -(int64_t)bo->base.size);
    VKSCR(FreeMemory)(screen->dev, bo->mem, NULL);
 
    simple_mtx_destroy(&bo->lock);
@@ -186,6 +230,7 @@ bo_slab_free(struct zink_screen *screen, struct pb_slab *pslab)
    ASSERTED unsigned slab_size = slab->buffer->base.size;
 
    assert(slab->base.num_entries * slab->base.entry_size <= slab_size);
+   ZINK_MEM_REPORT_ADD(screen, slab, -(int64_t)slab->buffer->base.size);
    FREE(slab->entries);
    zink_bo_unref(screen, slab->buffer);
    FREE(slab);
@@ -199,6 +244,7 @@ bo_slab_destroy(struct zink_screen *screen, struct zink_bo *bo)
    struct zink_clientptr_heap *clientptr_heap = bo->u.slab.real->u.real.clientptr_heap;
    struct pb_slabs *slabs = clientptr_heap ? &clientptr_heap->slabs : &screen->pb.bo_slabs;
 
+   ZINK_MEM_REPORT_ADD(screen, entry, -(int64_t)bo->u.slab.entry.slab->entry_size);
    pb_slab_free(slabs, &bo->u.slab.entry);
    if (!p_atomic_read_relaxed(&screen->base.num_contexts))
       pb_slabs_reclaim(slabs);
@@ -340,6 +386,7 @@ bo_create_internal(struct zink_screen *screen,
    pipe_reference_init(&bo->base.reference, 1);
    bo->base.alignment_log2 = util_logbase2(alignment);
    bo->base.size = mai.allocationSize;
+   ZINK_MEM_REPORT_ADD(screen, real, bo->base.size);
    bo->type = ZINK_BO_REAL;
    bo->base.placement = mem_type_idx;
    bo->base.usage = flags;
@@ -650,6 +697,7 @@ zink_bo_create(struct zink_screen *screen, uint64_t size, unsigned alignment, en
          return NULL;
 
       bo = container_of(entry, struct zink_bo, u.slab.entry);
+      ZINK_MEM_REPORT_ADD(screen, entry, entry->slab->entry_size);
       assert(bo->base.placement == mem_type_idx);
       pipe_reference_init(&bo->base.reference, 1);
       bo->base.size = size;
@@ -1377,6 +1425,7 @@ bo_slab_alloc(struct zink_screen *screen, unsigned mem_type_idx, unsigned entry_
       goto fail;
 
    slab_size = slab->buffer->base.size;
+   ZINK_MEM_REPORT_ADD(screen, slab, slab_size);
 
    slab->base.num_entries = slab_size / entry_size;
    slab->base.num_free = slab->base.num_entries;
