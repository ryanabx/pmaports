From 7d92fb8e54785cdb57d7059576bd3af42fa6b842 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Mon, 9 Nov 2026 22:09:53 -0600
Subject: [PATCH] LOCAL: pvr: no 24-bit depth attachments on parameter format
 v1

Local patch for the GE8300 on amazon-sheldonp; not to be sent. With an
integer ZLS load format (24BITINT or 16BITINT) the ISP rejects every
depth-writing object, with float load formats (F32Z, F64Z) depth works:
tested with forced ISP_ZLSCTL formats. A float load format can't load
stored integer depth though, so stop offering X8_D24 and D24S8 as
attachments on v1; zink falls back to D32_SFLOAT(_S8_UINT). D16 stays,
since Vulkan requires it.

Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_formats.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/imagination/vulkan/pvr_formats.c b/src/imagination/vulkan/pvr_formats.c
index f45396a0bf8..fd7cedcf4c7 100644
--- a/src/imagination/vulkan/pvr_formats.c
+++ b/src/imagination/vulkan/pvr_formats.c
@@ -315,7 +315,19 @@ pvr_get_image_format_features2(struct pvr_physical_device *pdevice,
       }
    }
 
-   if (pvr_format->bind & PVR_BIND_DEPTH_STENCIL) {
+   /* On simple parameter format v1 (GE8300) an integer ZLS load format
+    * makes the ISP reject every depth-writing object (float works), so
+    * don't offer the 24-bit depth formats as attachments there; zink then
+    * picks D32_SFLOAT(_S8_UINT). D16 stays: Vulkan requires it.
+    */
+   const bool skip_int_depth =
+      PVR_GET_FEATURE_VALUE(&pdevice->dev_info,
+                            simple_parameter_format_version,
+                            0) == 1 &&
+      (vk_format == VK_FORMAT_X8_D24_UNORM_PACK32 ||
+       vk_format == VK_FORMAT_D24_UNORM_S8_UINT);
+
+   if ((pvr_format->bind & PVR_BIND_DEPTH_STENCIL) && !skip_int_depth) {
       flags |= VK_FORMAT_FEATURE_2_DEPTH_STENCIL_ATTACHMENT_BIT |
                VK_FORMAT_FEATURE_2_BLIT_DST_BIT |
                VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_DEPTH_COMPARISON_BIT;
