From 6b17ece5884b387db776fb37d4f2f5926f7de75b Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Mon, 9 Nov 2026 21:32:39 -0600
Subject: [PATCH] LOCAL TEST: pvr: float background depth on parameter format
 v1

Local experiment for the GE8300 (22.68.54.30) on amazon-sheldonp; not to
be sent. With a 16 or 24-bit integer depth buffer, every depth-writing
object is rejected (even with compare ALWAYS); with a float depth buffer
depth works. Try ISP_BGOBJDEPTH as IEEE float whatever the ZLS format.

Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_arch_job_render.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/imagination/vulkan/pvr_arch_job_render.c b/src/imagination/vulkan/pvr_arch_job_render.c
index 6effaf19664..3fd6cc7df19 100644
--- a/src/imagination/vulkan/pvr_arch_job_render.c
+++ b/src/imagination/vulkan/pvr_arch_job_render.c
@@ -1120,6 +1120,16 @@ static void pvr_frag_state_stream_init(struct pvr_render_ctx *ctx,
        *  - zload_format is set to a sensible default above, and
        *  - job->depth_clear_value is set to a sensible default in that case.
        */
+      /* LOCAL TEST: the GE8300 (format v1) seems to want a float here
+       * whatever the ZLS format; with UNORM16/24 values depth-writing
+       * objects are all rejected.
+       */
+      if (PVR_GET_FEATURE_VALUE(dev_info, simple_parameter_format_version,
+                                0) == 1) {
+         value.value = fui(depth_clear);
+         break;
+      }
+
       switch (zload_format) {
       case ROGUE_CR_ZLS_FORMAT_TYPE_F32Z:
       case ROGUE_CR_ZLS_FORMAT_TYPE_F64Z:
-- 
2.56.0

