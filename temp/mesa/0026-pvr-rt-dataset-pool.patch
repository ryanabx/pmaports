From e56094aa2e1d937fd531dd992846e833b9214a8f Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Wed, 11 Nov 2026 15:23:08 -0600
Subject: [PATCH] LOCAL: pvr: pool RT datasets for reuse across
 dynamic-rendering render states (PVR_NO_RT_POOL=1 disables)

Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_arch_cmd_buffer.c | 18 ++++--
 src/imagination/vulkan/pvr_arch_device.c     |  6 ++
 src/imagination/vulkan/pvr_device.h          |  5 ++
 src/imagination/vulkan/pvr_rt_dataset.c      | 58 ++++++++++++++++++++
 src/imagination/vulkan/pvr_rt_dataset.h      | 21 ++++++-
 5 files changed, 101 insertions(+), 7 deletions(-)

diff --git a/src/imagination/vulkan/pvr_arch_cmd_buffer.c b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
index e4bd2227a5c..f469c7b7d64 100644
--- a/src/imagination/vulkan/pvr_arch_cmd_buffer.c
+++ b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
@@ -3436,12 +3436,18 @@ static inline VkResult pvr_render_targets_datasets_create(
       if (render_target->valid_mask & BITFIELD_BIT(view_idx))
          continue;
 
-      result = pvr_arch_render_target_dataset_create(device,
-                                                     rstate->width,
-                                                     rstate->height,
-                                                     hw_render->sample_count,
-                                                     layers,
-                                                     &rt_dataset);
+      rt_dataset = pvr_rt_dataset_pool_get(device,
+                                           rstate->width,
+                                           rstate->height,
+                                           hw_render->sample_count,
+                                           layers);
+      result = rt_dataset ? VK_SUCCESS
+                          : pvr_arch_render_target_dataset_create(device,
+                                                                  rstate->width,
+                                                                  rstate->height,
+                                                                  hw_render->sample_count,
+                                                                  layers,
+                                                                  &rt_dataset);
       if (result != VK_SUCCESS) {
          pvr_render_targets_datasets_destroy(render_target);
          pthread_mutex_unlock(&render_target->mutex);
diff --git a/src/imagination/vulkan/pvr_arch_device.c b/src/imagination/vulkan/pvr_arch_device.c
index 5a646b0cca3..9c5cbec970b 100644
--- a/src/imagination/vulkan/pvr_arch_device.c
+++ b/src/imagination/vulkan/pvr_arch_device.c
@@ -972,6 +972,9 @@ VkResult PVR_PER_ARCH(create_device)(struct pvr_physical_device *pdevice,
 
    simple_mtx_init(&device->rs_mtx, mtx_plain);
    list_inithead(&device->render_states);
+   simple_mtx_init(&device->rt_pool_mtx, mtx_plain);
+   list_inithead(&device->rt_pool);
+   device->rt_pool_count = 0;
 
    *pDevice = pvr_device_to_handle(device);
 
@@ -1067,6 +1070,9 @@ void PVR_PER_ARCH(destroy_device)(struct pvr_device *device,
    simple_mtx_unlock(&device->rs_mtx);
    simple_mtx_destroy(&device->rs_mtx);
 
+   /* After the render states, which return their datasets to the pool. */
+   pvr_rt_dataset_pool_finish(device);
+
    pvr_device_dummy_rt_finish(device);
    pvr_arch_border_color_table_finish(device);
    pvr_robustness_buffer_finish(device);
diff --git a/src/imagination/vulkan/pvr_device.h b/src/imagination/vulkan/pvr_device.h
index 5b9e96d94e2..fce2f226160 100644
--- a/src/imagination/vulkan/pvr_device.h
+++ b/src/imagination/vulkan/pvr_device.h
@@ -170,6 +170,11 @@ struct pvr_device {
    simple_mtx_t rs_mtx;
    struct list_head render_states;
 
+   /* LOCAL: unused RT datasets for reuse (pvr_rt_dataset_pool_get()). */
+   simple_mtx_t rt_pool_mtx;
+   struct list_head rt_pool;
+   uint32_t rt_pool_count;
+
    /* Data Source for GPU tracing */
    struct pvr_ds_device ds;
 };
diff --git a/src/imagination/vulkan/pvr_rt_dataset.c b/src/imagination/vulkan/pvr_rt_dataset.c
index 0e2feb83f1c..b1a7ea26346 100644
--- a/src/imagination/vulkan/pvr_rt_dataset.c
+++ b/src/imagination/vulkan/pvr_rt_dataset.c
@@ -9,6 +9,8 @@
 #include "pvr_device.h"
 #include "pvr_free_list.h"
 
+#include "util/u_debug.h"
+
 #include <inttypes.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -96,6 +98,62 @@ void pvr_rt_vheap_rtc_data_fini(struct pvr_rt_dataset *rt_dataset)
    rt_dataset->vheap_rtc_bo = NULL;
 }
 
+#define PVR_RT_POOL_MAX 4
+
+struct pvr_rt_dataset *pvr_rt_dataset_pool_get(struct pvr_device *device,
+                                               uint32_t width,
+                                               uint32_t height,
+                                               uint32_t samples,
+                                               uint32_t layers)
+{
+   struct pvr_rt_dataset *found = NULL;
+
+   simple_mtx_lock(&device->rt_pool_mtx);
+   list_for_each_entry (struct pvr_rt_dataset, entry, &device->rt_pool, pool_link) {
+      if (entry->width == width && entry->height == height &&
+          entry->samples == samples && entry->layers == layers) {
+         list_del(&entry->pool_link);
+         device->rt_pool_count--;
+         found = entry;
+         break;
+      }
+   }
+   simple_mtx_unlock(&device->rt_pool_mtx);
+
+   return found;
+}
+
+void pvr_rt_dataset_release(struct pvr_rt_dataset *rt_dataset)
+{
+   struct pvr_device *device = rt_dataset->device;
+   bool pooled = false;
+
+   if (!debug_get_bool_option("PVR_NO_RT_POOL", false)) {
+      simple_mtx_lock(&device->rt_pool_mtx);
+      if (device->rt_pool_count < PVR_RT_POOL_MAX) {
+         list_add(&rt_dataset->pool_link, &device->rt_pool);
+         device->rt_pool_count++;
+         pooled = true;
+      }
+      simple_mtx_unlock(&device->rt_pool_mtx);
+   }
+
+   if (!pooled)
+      pvr_render_target_dataset_destroy(rt_dataset);
+}
+
+void pvr_rt_dataset_pool_finish(struct pvr_device *device)
+{
+   simple_mtx_lock(&device->rt_pool_mtx);
+   list_for_each_entry_safe (struct pvr_rt_dataset, entry, &device->rt_pool, pool_link) {
+      list_del(&entry->pool_link);
+      pvr_render_target_dataset_destroy(entry);
+   }
+   device->rt_pool_count = 0;
+   simple_mtx_unlock(&device->rt_pool_mtx);
+   simple_mtx_destroy(&device->rt_pool_mtx);
+}
+
 void pvr_render_target_dataset_destroy(struct pvr_rt_dataset *rt_dataset)
 {
    struct pvr_device *device = rt_dataset->device;
diff --git a/src/imagination/vulkan/pvr_rt_dataset.h b/src/imagination/vulkan/pvr_rt_dataset.h
index c0e56aaf1bf..17c960e576b 100644
--- a/src/imagination/vulkan/pvr_rt_dataset.h
+++ b/src/imagination/vulkan/pvr_rt_dataset.h
@@ -11,6 +11,7 @@
 #include <stdbool.h>
 
 #include "util/bitscan.h"
+#include "util/list.h"
 
 #include "pvr_framebuffer.h"
 #include "pvr_rogue_fw.h"
@@ -24,6 +25,11 @@ struct pvr_winsys_rt_dataset;
 struct pvr_rt_dataset {
    struct pvr_device *device;
 
+   /* LOCAL: entry in pvr_device::rt_pool while unused (see
+    * pvr_rt_dataset_release()).
+    */
+   struct list_head pool_link;
+
    /* RT dataset information */
    uint32_t width;
    uint32_t height;
@@ -70,6 +76,19 @@ void pvr_rt_vheap_rtc_data_fini(struct pvr_rt_dataset *rt_dataset);
 
 void pvr_render_target_dataset_destroy(struct pvr_rt_dataset *rt_dataset);
 
+/* LOCAL: a small device-level pool of unused RT datasets. Dynamic rendering
+ * makes a new render state, and so new RT datasets (five buffers, a firmware
+ * HWRT dataset, VM maps and MMU flushes), for every vkCmdBeginRendering;
+ * the pool reuses them by size, as the VkFramebuffer path reuses its own.
+ */
+struct pvr_rt_dataset *pvr_rt_dataset_pool_get(struct pvr_device *device,
+                                               uint32_t width,
+                                               uint32_t height,
+                                               uint32_t samples,
+                                               uint32_t layers);
+void pvr_rt_dataset_release(struct pvr_rt_dataset *rt_dataset);
+void pvr_rt_dataset_pool_finish(struct pvr_device *device);
+
 static inline void
 pvr_render_targets_datasets_destroy(struct pvr_render_target *render_target)
 {
@@ -77,7 +96,7 @@ pvr_render_targets_datasets_destroy(struct pvr_render_target *render_target)
       struct pvr_rt_dataset *rt_dataset = render_target->rt_dataset[valid_idx];
 
       if (rt_dataset && render_target->valid_mask & BITFIELD_BIT(valid_idx))
-         pvr_render_target_dataset_destroy(rt_dataset);
+         pvr_rt_dataset_release(rt_dataset);
 
       render_target->rt_dataset[valid_idx] = NULL;
       render_target->valid_mask &= ~BITFIELD_BIT(valid_idx);
-- 
2.56.0

