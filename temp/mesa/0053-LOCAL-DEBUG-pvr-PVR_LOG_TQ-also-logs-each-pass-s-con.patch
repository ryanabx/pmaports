From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Wed, 11 Nov 2026 11:36:20 -0600
Subject: [PATCH 53/56] LOCAL DEBUG: pvr: PVR_LOG_TQ also logs each pass's
 control stream

Generated-by: LLM
---
 .../vulkan/pvr_arch_job_transfer.c            | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/src/imagination/vulkan/pvr_arch_job_transfer.c b/src/imagination/vulkan/pvr_arch_job_transfer.c
index c5fdc672170..8c33276fd16 100644
--- a/src/imagination/vulkan/pvr_arch_job_transfer.c
+++ b/src/imagination/vulkan/pvr_arch_job_transfer.c
@@ -4603,6 +4603,34 @@ static VkResult pvr_isp_ctrl_stream(const struct pvr_device_info *dev_info,
       /* clang-format on */
    }
 
+   /* LOCAL DEBUG: PVR_LOG_TQ=1 also logs each pass's control stream. */
+   if (debug_get_bool_option("PVR_LOG_TQ", false)) {
+      const struct pvr_transfer_custom_mapping *cm = &state->custom_mapping;
+      const uint32_t *words = pvr_bo_suballoc_get_map_addr(pvr_cs_bo);
+      const uint32_t nwords = total_stream_size / sizeof(uint32_t);
+
+      fprintf(stderr,
+              "pvr-tq-cs pass %u/%u dstride %d ext %u/%u unw %u/%u"
+              " fill %d prims %u arrays %u linked %d cs 0x%" PRIx64
+              " (heap +0x%" PRIx64 ") size %u mtile_base 0x%" PRIx64
+              " isp_rgn 0x%" PRIx64 " origin %u,%u\n",
+              state->pass_idx, cm->pass_count, cm->double_stride,
+              cm->texel_extend_src, cm->texel_extend_dst,
+              cm->texel_unwind_src, cm->texel_unwind_dst,
+              (transfer_cmd->flags & PVR_TRANSFER_CMD_FLAGS_FILL) != 0U,
+              num_prim_blks, num_region_arrays, was_linked,
+              pvr_cs_bo->dev_addr.addr, stream_base_vaddr.addr,
+              total_stream_size, (uint64_t)regs->isp_mtile_base,
+              (uint64_t)regs->isp_rgn, state->origin_x_in_tiles,
+              state->origin_y_in_tiles);
+      for (uint32_t i = 0; i < MIN2(nwords, 48U); i += 8) {
+         fprintf(stderr, "pvr-tq-cs   %03x:", i * 4);
+         for (uint32_t j = i; j < MIN2(i + 8, nwords); j++)
+            fprintf(stderr, " %08x", words[j]);
+         fprintf(stderr, "\n");
+      }
+   }
+
    return VK_SUCCESS;
 }
 
