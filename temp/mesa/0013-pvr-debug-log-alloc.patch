From 339a3a1441aa323d4bc6322b15477cfc3ea504f3 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Mon, 9 Nov 2026 23:33:25 -0600
Subject: [PATCH 1/3] LOCAL DEBUG: pvr: PVR_LOG_ALLOC logs images and memory
 allocations

Debug aid for amazon-sheldonp; never sent. To find what pins 165 MiB of
GPU memory in plasma-keyboard and 133 MiB in plasmashell.

Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_device.c |  8 ++++++++
 src/imagination/vulkan/pvr_image.c  | 14 ++++++++++++++
 2 files changed, 22 insertions(+)

diff --git a/src/imagination/vulkan/pvr_device.c b/src/imagination/vulkan/pvr_device.c
index 7ba4fb89f4b..48e1350713c 100644
--- a/src/imagination/vulkan/pvr_device.c
+++ b/src/imagination/vulkan/pvr_device.c
@@ -63,6 +63,7 @@
 #include "util/macros.h"
 #include "util/mesa-blake3.h"
 #include "util/os_misc.h"
+#include "util/u_debug.h"
 #include "util/u_math.h"
 #include "vk_device_memory.h"
 #include "vk_extensions.h"
@@ -208,6 +209,13 @@ VkResult pvr_AllocateMemory(VkDevice _device,
    VkDeviceSize aligned_alloc_size =
       ALIGN_POT(pAllocateInfo->allocationSize, device->ws->page_size);
 
+   /* LOCAL DEBUG: PVR_LOG_ALLOC=1 logs memory allocations. */
+   if (debug_get_bool_option("PVR_LOG_ALLOC", false)) {
+      fprintf(stderr, "pvr-alloc: memory %" PRIu64 " KiB type %u\n",
+              (uint64_t)aligned_alloc_size / 1024,
+              pAllocateInfo->memoryTypeIndex);
+   }
+
    if (aligned_alloc_size > mem_heap->size)
       return VK_ERROR_OUT_OF_DEVICE_MEMORY;
 
diff --git a/src/imagination/vulkan/pvr_image.c b/src/imagination/vulkan/pvr_image.c
index 869fa99719e..74f7e26ade7 100644
--- a/src/imagination/vulkan/pvr_image.c
+++ b/src/imagination/vulkan/pvr_image.c
@@ -39,6 +39,8 @@
 #include "pvr_tex_state.h"
 #include "util/macros.h"
 #include "util/u_debug.h"
+#include <stdio.h>
+#include <inttypes.h>
 #include "util/u_math.h"
 #include "vk_format.h"
 #include "vk_image.h"
@@ -309,6 +311,18 @@ VkResult pvr_CreateImage(VkDevice _device,
 
    pvr_image_init(device, pCreateInfo, image);
 
+   /* LOCAL DEBUG: PVR_LOG_ALLOC=1 logs images and memory allocations. */
+   if (debug_get_bool_option("PVR_LOG_ALLOC", false)) {
+      fprintf(stderr,
+              "pvr-alloc: image %ux%ux%u fmt %d mips %u layers %u samples %u "
+              "tiling %d layout %d usage 0x%x size %" PRIu64 " KiB\n",
+              image->vk.extent.width, image->vk.extent.height,
+              image->vk.extent.depth, image->vk.format, image->vk.mip_levels,
+              image->vk.array_layers, image->vk.samples, image->vk.tiling,
+              image->memlayout, image->vk.usage,
+              (uint64_t)image->size / 1024);
+   }
+
    *pImage = pvr_image_to_handle(image);
 
    return VK_SUCCESS;
-- 
2.56.0

From da989749b5960e6ba9c8d8f5e92fc485fdc68b4e Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Mon, 9 Nov 2026 23:41:52 -0600
Subject: [PATCH 2/3] LOCAL DEBUG: pvr: fix PVR_LOG_ALLOC image size field

Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_image.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/imagination/vulkan/pvr_image.c b/src/imagination/vulkan/pvr_image.c
index 74f7e26ade7..ee20d375849 100644
--- a/src/imagination/vulkan/pvr_image.c
+++ b/src/imagination/vulkan/pvr_image.c
@@ -320,7 +320,7 @@ VkResult pvr_CreateImage(VkDevice _device,
               image->vk.extent.depth, image->vk.format, image->vk.mip_levels,
               image->vk.array_layers, image->vk.samples, image->vk.tiling,
               image->memlayout, image->vk.usage,
-              (uint64_t)image->size / 1024);
+              (uint64_t)image->total_size / 1024);
    }
 
    *pImage = pvr_image_to_handle(image);
-- 
2.56.0

From d953e09915f144fe002f7b21475ef9f7a15084d8 Mon Sep 17 00:00:00 2001
