# Forked from Alpine's main/mesa (aports master, 26.2.6-r0, 2026-11-05) for
# amazon-suez only: Mesa main plus Mesa !42747 (the pco preamble) and local
# PowerVR prototypes that make the Phosh desktop GPU-accelerated on the
# GX6250 (phoc's frame 84 -> 16 ms). The patches come from ~/repos/mesa
# branch suez/pvr-desktop-pkg and are LOCAL EXPERIMENTS, NEVER TO BE SENT:
# Imagination declines LLM-generated code in src/imagination. Evidence:
# suez-work notes/PVR-DESKTOP-2026-11-04.md; book GPU chapter.
#
# Trimmed to what suez uses: gallium zink and llvmpipe, Vulkan imagination
# and lavapipe; no VA, no rusticl, no Vulkan layers. Do not merge this into
# pmaports master.
maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=mesa
pkgver=27.0.0_git20261110
pkgrel=1
_commit="5304cac24b08b8f7d4da00464dff6e7bc1d4a07b"
pkgdesc="Mesa DRI OpenGL library (amazon-suez PowerVR fork)"
