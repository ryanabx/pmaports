# Forked from Alpine's main/mesa (aports master, 26.2.6-r0) by way of the
# amazon-suez temp/mesa aport, for amazon-sheldonp GPU bring-up: plain Mesa
# main, NO local patches, to test the PowerVR GE8300 (22.68.54.30) with
# the latest pvr driver. Trimmed: gallium zink and llvmpipe, Vulkan
# imagination and lavapipe. Do not merge this into pmaports master.
maintainer="Ryan Brue <ryanbrue.dev@gmail.com>"
pkgname=mesa
pkgver=27.0.0_git20261109
pkgrel=0
_commit="1c87c60187064c60a10378fa79e20debf0941f97"
pkgdesc="Mesa DRI OpenGL library (amazon-sheldonp PowerVR test build)"
url="https://www.mesa3d.org"
arch="aarch64"
license="MIT AND SGI-B-2.0 AND BSL-1.0"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-dri-gallium:_gallium
	$pkgname-egl
	$pkgname-gl
	$pkgname-gles
	$pkgname-gbm
	$pkgname-vulkan-imagination:_vulkan
	$pkgname-vulkan-swrast:_vulkan
	"
_llvmver=23
depends_dev="
	libdrm-dev
	libxdamage-dev
	libxshmfence-dev
	"
makedepends="
	$depends_dev
	binutils
	bison
	clang$_llvmver-dev
	elfutils-dev
	eudev-dev
	expat-dev
	findutils
	flex
	gettext
	glslang-dev
	libclc-dev~$_llvmver
	libdisplay-info-dev
	libtool
	libx11-dev
	libxfixes-dev
	libxml2-dev
	libxrandr-dev
	libxxf86vm-dev
	llvm$_llvmver-dev
	meson
	py3-cparser
	py3-mako
	py3-packaging
	py3-ply
	py3-yaml
	python3
	spirv-llvm-translator-dev
	spirv-tools-dev
	vulkan-loader-dev
	wayland-dev
	wayland-protocols
	xorgproto
	zlib-dev
	zstd-dev
	"
source="mesa-$_commit.tar.gz::https://gitlab.freedesktop.org/mesa/mesa/-/archive/$_commit/mesa-$_commit.tar.gz"
builddir="$srcdir/mesa-$_commit"
options="!check"

_dri_driverdir=/usr/lib/dri

prepare() {
	default_prepare
	# main's VERSION is "27.0.0-devel", which ends up in the .pc files, and
	# abuild rejects it as a pkgconf version.
	echo "${pkgver%%_git*}" > VERSION
}

build() {
	export CFLAGS="$CFLAGS -O2 -g1"
	export CXXFLAGS="$CXXFLAGS -O2 -g1"
	export CPPFLAGS="$CPPFLAGS -O2 -g1"

	PATH="$PATH:/usr/lib/llvm$_llvmver/bin" \
	abuild-meson \
		-Db_ndebug=true \
		-Db_lto=false \
		-Dallow-kcmp=enabled \
		-Dexpat=enabled \
		-Dshader-cache=enabled \
		-Dxlib-lease=enabled \
		-Dxmlconfig=enabled \
		-Dzstd=enabled \
		-Dbackend_max_links=2 \
		-Dbuild-tests=false \
		-Ddri-drivers-path=$_dri_driverdir \
		-Dgallium-drivers=llvmpipe,zink \
		-Dvulkan-drivers=imagination,swrast \
		-Dvulkan-layers= \
		-Dplatforms=x11,wayland \
		-Dllvm=enabled \
		-Dshared-llvm=enabled \
		-Dgbm=enabled \
		-Dglx=dri \
		-Dopengl=true \
		-Dgles1=enabled \
		-Dgles2=enabled \
		-Degl=enabled \
		-Dgallium-rusticl=false \
		-Dgallium-va=disabled \
		-Dvideo-codecs= \
		. output

	meson configure --no-pager output

	# Mesa main (2026-11): src/git_sha1.h is used by pvr_physical_device.c but
	# not depended on, so generate it before the parallel build.
	meson compile -C output src/git_sha1.h
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

egl() {
	pkgdesc="Mesa libEGL runtime libraries"
	depends="mesa=$pkgver-r$pkgrel mesa-gles=$pkgver-r$pkgrel"

	amove usr/lib/libEGL.so*
}

gl() {
	pkgdesc="Mesa libGL runtime libraries"
	depends="mesa=$pkgver-r$pkgrel"

	amove usr/lib/libGL.so*
}

gles() {
	pkgdesc="Mesa libGLESv2 runtime libraries"
	depends="mesa=$pkgver-r$pkgrel"

	amove usr/lib/libGLES*.so*
}

gbm() {
	pkgdesc="Mesa gbm library"
	depends="mesa=$pkgver-r$pkgrel"

	amove usr/lib/libgbm.so.*
}

_mv_links() {
	install -d "$subpkgdir"/$1
	find -L "$pkgdir"/$1 -samefile "$pkgdir"/$1/$2 -print0 \
		| xargs -0 -I{} mv {} "$subpkgdir"/$1/
}

_mv_vulkan() {
	local i
	for i in "$@"; do
		amove usr/lib/libvulkan_$i*.so
		amove usr/share/vulkan/icd.d/${i}_*.*
	done
}

_gallium() {
	pkgdesc="Mesa gallium DRI drivers"
	depends="mesa=$pkgver-r$pkgrel"

	_mv_links $_dri_driverdir swrast_dri.so
}

_vulkan() {
	local n=${subpkgname##*-vulkan-}
	pkgdesc="Mesa Vulkan API driver for $n"
	depends="mesa=$pkgver-r$pkgrel"

	case $n in
	imagination)
		_mv_vulkan powervr_mesa ;;
	swrast)
		_mv_vulkan lvp ;;
	esac
}

