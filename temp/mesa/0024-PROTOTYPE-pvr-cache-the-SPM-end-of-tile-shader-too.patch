+/* PROTOTYPE: end-of-tile shader cache. pvr compiled the end-of-tile shader
+ * with pco for every render, and the SPM one for every dynamic render
+ * (vkCmdBeginRendering sets up a whole render state, ~1.1 ms of CPU on
+ * GX6250/A53 per render, measured with uprobes). The shader depends only on
+ * the props, including the PBE state words (render target or scratch buffer
+ * addresses), so a client reusing its images hits after the first frames.
+ * Kept per device, in memory, at most 128 entries (emptied when full).
+ * The binary is returned as a malloc'ed copy for the caller to free, so a
+ * concurrent clear cannot free it under the caller.
+ */
+struct pvr_eot_cache_entry {
+   blake3_hash key;
+   uint32_t temps;
+   uint32_t bin_size;
+   uint8_t bin[];
+};
+
+VkResult PVR_PER_ARCH(eot_shader_get)(struct pvr_device *device,
+                                      struct pvr_eot_props *props,
+                                      struct pvr_eot_shader *out)
+{
+   const bool use_cache = device->eot_cache &&
+                          !getenv("SUEZ_PVR_NO_EOT_CACHE");
+   blake3_hash key;
+
+   if (use_cache) {
+      struct mesa_blake3 ctx;
+
+      _mesa_blake3_init(&ctx);
+      _mesa_blake3_update(&ctx, &props->emit_count, sizeof(props->emit_count));
+      _mesa_blake3_update(&ctx,
+                          &props->shared_words,
+                          sizeof(props->shared_words));
+      _mesa_blake3_update(&ctx,
+                          props->state_words,
+                          props->emit_count * ROGUE_NUM_PBESTATE_STATE_WORDS *
+                             sizeof(props->state_words[0]));
+      _mesa_blake3_update(&ctx,
+                          &props->msaa_samples,
+                          sizeof(props->msaa_samples));
+      _mesa_blake3_update(&ctx,
+                          &props->num_output_regs,
+                          sizeof(props->num_output_regs));
+      _mesa_blake3_update(&ctx,
+                          props->tile_buffer_addrs,
+                          sizeof(props->tile_buffer_addrs));
+      _mesa_blake3_final(&ctx, key);
+
+      simple_mtx_lock(&device->loadop_cache_mtx);
+      struct hash_entry *he = _mesa_hash_table_search(device->eot_cache, key);
+      const struct pvr_eot_cache_entry *cached = he ? he->data : NULL;
+      if (cached) {
+         out->bin = malloc(cached->bin_size);
+         if (out->bin) {
+            memcpy(out->bin, cached->bin, cached->bin_size);
+            out->bin_size = cached->bin_size;
+            out->temps = cached->temps;
+         }
+      }
+      simple_mtx_unlock(&device->loadop_cache_mtx);
+
+      if (getenv("SUEZ_PVR_CACHE_DEBUG")) {
+         char hex[BLAKE3_HEX_LEN];
+         _mesa_blake3_format(hex, key);
+         fprintf(stderr, "pvr-eot-cache: %s %.16s emit=%u w0=%08x w1=%08x\n",
+                 cached ? "hit " : "miss", hex, props->emit_count,
+                 props->emit_count ? props->state_words[0] : 0,
+                 props->emit_count ? props->state_words[1] : 0);
+      }
+
+      if (cached)
+         return out->bin ? VK_SUCCESS
+                         : vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   pco_shader *eot =
+      pvr_usc_eot(device->pdevice->pco_ctx, props, &device->pdevice->dev_info);
+   const uint32_t bin_size = pco_shader_binary_size(eot);
+
+   out->temps = pco_shader_data(eot)->common.temps;
+   out->bin_size = bin_size;
+   out->bin = malloc(bin_size);
+   if (out->bin)
+      memcpy(out->bin, pco_shader_binary_data(eot), bin_size);
+
+   if (use_cache) {
+      struct pvr_eot_cache_entry *entry = malloc(sizeof(*entry) + bin_size);
+
+      if (entry) {
+         memcpy(entry->key, key, sizeof(key));
+         entry->temps = out->temps;
+         entry->bin_size = bin_size;
+         memcpy(entry->bin, pco_shader_binary_data(eot), bin_size);
+
+         simple_mtx_lock(&device->loadop_cache_mtx);
+         if (_mesa_hash_table_num_entries(device->eot_cache) >= 128) {
+            hash_table_foreach (device->eot_cache, he)
+               free(he->data);
+            _mesa_hash_table_clear(device->eot_cache, NULL);
+         }
+         if (_mesa_hash_table_search(device->eot_cache, entry->key))
+            free(entry);
+         else
+            _mesa_hash_table_insert(device->eot_cache, entry->key, entry);
+         simple_mtx_unlock(&device->loadop_cache_mtx);
+      }
+   }
+
+   ralloc_free(eot);
+
+   return out->bin ? VK_SUCCESS : vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+}
