From ab2f4e14fe002f6f768d2b170a54007eaa031aaf Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Mon, 9 Nov 2026 21:40:12 -0600
Subject: [PATCH] LOCAL TEST: pvr: PVR_TEST_NO_DBIAS_INT clears
 ISP_CTL.DBIAS_IS_INT

Local experiment for the GE8300 on amazon-sheldonp; not to be sent. With
16/24-bit integer depth every depth-writing object is rejected; float
depth works. ISP_CTL.DBIAS_IS_INT is the one ISP control bit that
differs besides the ZLS formats.

Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_arch_job_render.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/imagination/vulkan/pvr_arch_job_render.c b/src/imagination/vulkan/pvr_arch_job_render.c
index 3fd6cc7df19..edec2b86aa8 100644
--- a/src/imagination/vulkan/pvr_arch_job_render.c
+++ b/src/imagination/vulkan/pvr_arch_job_render.c
@@ -25,6 +25,8 @@
 #include <stdbool.h>
 #include <stdint.h>
 #include <stdlib.h>
+
+#include "util/u_debug.h"
 #include <vulkan/vulkan.h>
 
 #include "hwdef/rogue_hw_defs.h"
@@ -1179,6 +1181,11 @@ static void pvr_frag_state_stream_init(struct pvr_render_ctx *ctx,
        */
       value.dbias_is_int = PVR_HAS_ENHANCEMENT(dev_info, 42307) &&
                            pvr_zls_format_type_is_int(job->ds.zls_format);
+      /* LOCAL TEST: integer depth formats reject every depth-writing
+       * object on the GE8300; see whether DBIAS_IS_INT is the cause.
+       */
+      if (debug_get_bool_option("PVR_TEST_NO_DBIAS_INT", false))
+         value.dbias_is_int = false;
 
       if (PVR_HAS_FEATURE(dev_info, gpu_multicore_support) &&
           PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format)) {
-- 
