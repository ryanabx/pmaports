From 45941a796ac2e705fad53fee29fc868a7acad24f Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Mon, 9 Nov 2026 20:23:24 -0600
Subject: [PATCH] LOCAL: pvr: allocate the transfer submit on the heap

Local test patch for amazon-sheldonp (postmarketOS, musl); not to be
sent. struct pvr_transfer_submit is about 320 KiB, and
pvr_queue_transfer() runs on the Vulkan queue thread. musl gives threads
128 KiB of stack by default, so the stack probe faults on the first
transfer (glmark2 'texture' through zink).

Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 .../vulkan/pvr_arch_job_transfer.c            | 36 +++++++++++++------
 1 file changed, 25 insertions(+), 11 deletions(-)

diff --git a/src/imagination/vulkan/pvr_arch_job_transfer.c b/src/imagination/vulkan/pvr_arch_job_transfer.c
index df05efe7e2e..0a6b5077a57 100644
--- a/src/imagination/vulkan/pvr_arch_job_transfer.c
+++ b/src/imagination/vulkan/pvr_arch_job_transfer.c
@@ -5952,7 +5952,7 @@ static VkResult pvr_queue_transfer(struct pvr_transfer_ctx *ctx,
 {
    struct pvr_transfer_prep_data *prep_data = NULL;
    struct pvr_transfer_prep_data *prev_prep_data;
-   struct pvr_transfer_submit submit = { 0U };
+   struct pvr_transfer_submit *submit;
    bool finished = false;
    uint32_t pass = 0U;
    VkResult result;
@@ -5977,16 +5977,28 @@ static VkResult pvr_queue_transfer(struct pvr_transfer_ctx *ctx,
     * S/U   : update / server sync update point
     */
 
+   /* Too big for the stack of a queue thread on musl (128 KiB). */
+   submit = vk_zalloc(&ctx->device->vk.alloc,
+                      sizeof(*submit),
+                      8,
+                      VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+   if (!submit)
+      return vk_error(ctx->device, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   result = VK_SUCCESS;
+
    while (!finished) {
       prev_prep_data = prep_data;
-      prep_data = &submit.prep_array[submit.prep_count++];
+      prep_data = &submit->prep_array[submit->prep_count++];
 
       /* Clear down the memory before we write to this prep. */
       memset(prep_data, 0U, sizeof(*prep_data));
 
       if (pass == 0U) {
-         if (!pvr_3d_validate_addr(transfer_cmd))
-            return vk_error(ctx->device, VK_ERROR_FEATURE_NOT_PRESENT);
+         if (!pvr_3d_validate_addr(transfer_cmd)) {
+            result = vk_error(ctx->device, VK_ERROR_FEATURE_NOT_PRESENT);
+            break;
+         }
       } else {
          /* Transfer queue workarounds could use more than one pass with 3D
           * path.
@@ -6002,26 +6014,28 @@ static VkResult pvr_queue_transfer(struct pvr_transfer_ctx *ctx,
             pvr_3d_copy_blit(ctx, transfer_cmd, prep_data, pass, &finished);
       }
       if (result != VK_SUCCESS)
-         return result;
+         break;
 
       /* Submit if we have finished the blit or if we are out of prepares. */
-      if (finished || submit.prep_count == ARRAY_SIZE(submit.prep_array)) {
+      if (finished || submit->prep_count == ARRAY_SIZE(submit->prep_array)) {
          result = pvr_submit_transfer(ctx,
-                                      &submit,
+                                      submit,
                                       wait,
                                       finished ? signal_sync : NULL);
          if (result != VK_SUCCESS)
-            return result;
+            break;
 
          /* Check if we need to reset prep_count. */
-         if (submit.prep_count == ARRAY_SIZE(submit.prep_array))
-            submit.prep_count = 0U;
+         if (submit->prep_count == ARRAY_SIZE(submit->prep_array))
+            submit->prep_count = 0U;
       }
 
       pass++;
    }
 
-   return VK_SUCCESS;
+   vk_free(&ctx->device->vk.alloc, submit);
+
+   return result;
 }
 
 VkResult pvr_arch_transfer_job_submit(struct pvr_transfer_ctx *ctx,
