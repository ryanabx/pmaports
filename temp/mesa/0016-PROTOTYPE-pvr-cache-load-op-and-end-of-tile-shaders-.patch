+/* PROTOTYPE: load-op shader cache.
+ *
+ * pvr compiled a load-op shader with pco on every vkCmdBeginRendering that
+ * loads or clears (13 % of phoc's CPU during a panel gesture on GX6250,
+ * measured with perf). The shader only depends on the load-op state and the
+ * MRT setup, so keep compiled ones per device, in memory.
+ */
+struct pvr_loadop_cache_entry {
+   blake3_hash key;
+   pco_data data;
+   uint32_t num_tile_buffers;
+   uint32_t const_shareds_count;
+   uint32_t shareds_count;
+   uint32_t bin_size;
+   uint8_t bin[];
+};
+
+static uint32_t pvr_loadop_cache_hash(const void *key)
+{
+   return _mesa_hash_data(key, sizeof(blake3_hash));
+}
+
+static bool pvr_loadop_cache_equal(const void *a, const void *b)
+{
+   return !memcmp(a, b, sizeof(blake3_hash));
+}
+
+struct hash_table *pvr_loadop_cache_create(void)
+{
+   return _mesa_hash_table_create(NULL,
+                                  pvr_loadop_cache_hash,
+                                  pvr_loadop_cache_equal);
+}
+
+void pvr_loadop_cache_destroy(struct hash_table *cache)
+{
+   if (!cache)
+      return;
+
+   hash_table_foreach (cache, entry)
+      free(entry->data);
+
+   _mesa_hash_table_destroy(cache, NULL);
+}
+
+static void pvr_loadop_cache_key(const struct pvr_load_op *load_op,
+                                 blake3_hash key)
+{
+   const struct usc_mrt_setup *setup = load_op->clears_loads_state.mrt_setup;
+   struct mesa_blake3 ctx;
+
+   _mesa_blake3_init(&ctx);
+   _mesa_blake3_update(&ctx,
+                       &load_op->clears_loads_state.rt_clear_mask,
+                       sizeof(load_op->clears_loads_state.rt_clear_mask));
+   _mesa_blake3_update(&ctx,
+                       &load_op->clears_loads_state.rt_load_mask,
+                       sizeof(load_op->clears_loads_state.rt_load_mask));
+   _mesa_blake3_update(&ctx,
+                       &load_op->clears_loads_state.rt_2d_view_3d_mask,
+                       sizeof(load_op->clears_loads_state.rt_2d_view_3d_mask));
+   _mesa_blake3_update(&ctx,
+                       &load_op->clears_loads_state.unresolved_msaa_mask,
+                       sizeof(load_op->clears_loads_state.unresolved_msaa_mask));
+   _mesa_blake3_update(&ctx,
+                       load_op->clears_loads_state.dest_vk_format,
+                       sizeof(load_op->clears_loads_state.dest_vk_format));
+   _mesa_blake3_update(&ctx,
+                       &load_op->clears_loads_state.depth_clear_to_reg,
+                       sizeof(load_op->clears_loads_state.depth_clear_to_reg));
+   if (setup) {
+      _mesa_blake3_update(&ctx,
+                          &setup->num_render_targets,
+                          sizeof(setup->num_render_targets));
+      _mesa_blake3_update(&ctx,
+                          &setup->num_output_regs,
+                          sizeof(setup->num_output_regs));
+      _mesa_blake3_update(&ctx,
+                          &setup->num_tile_buffers,
+                          sizeof(setup->num_tile_buffers));
+      _mesa_blake3_update(&ctx,
+                          &setup->disable_source_pos_override,
+                          sizeof(setup->disable_source_pos_override));
+      /* Only what pvr_uscgen_loadop() reads: mrt_desc's valid_mask and
+       * priority can hold uninitialised words beyond the target's size.
+       */
+      for (unsigned i = 0; i < setup->num_render_targets; i++) {
+         const struct usc_mrt_resource *res = &setup->mrt_resources[i];
+         const uint32_t fields[] = {
+            res->type,
+            res->intermediate_size,
+            res->mrt_desc.intermediate_size,
+            res->type == USC_MRT_RESOURCE_TYPE_OUTPUT_REG ? res->reg.output_reg
+                                                          : res->mem.tile_buffer,
+            res->type == USC_MRT_RESOURCE_TYPE_OUTPUT_REG ? res->reg.offset
+                                                          : res->mem.offset_dw,
+         };
+         _mesa_blake3_update(&ctx, fields, sizeof(fields));
+      }
+   }
+   _mesa_blake3_final(&ctx, key);
+}
