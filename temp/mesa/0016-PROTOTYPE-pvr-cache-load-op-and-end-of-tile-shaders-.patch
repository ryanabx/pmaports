-   pco_shader *loadop = pvr_uscgen_loadop(device->pdevice->pco_ctx, load_op);
+   if (cached) {
+      /* Entries are never removed before the device is destroyed. */
+      load_op->num_tile_buffers = cached->num_tile_buffers;
+      load_op->const_shareds_count = cached->const_shareds_count;
+      load_op->shareds_count = cached->shareds_count;
+      data = &cached->data;
+      bin = cached->bin;
+      bin_size = cached->bin_size;
+   } else {
+      loadop = pvr_uscgen_loadop(device->pdevice->pco_ctx, load_op);
+      data = pco_shader_data(loadop);
+      bin = pco_shader_binary_data(loadop);
+      bin_size = pco_shader_binary_size(loadop);
+
+      if (use_cache) {
+         struct pvr_loadop_cache_entry *entry =
+            malloc(sizeof(*entry) + bin_size);
+
+         if (entry) {
+            memcpy(entry->key, key, sizeof(key));
+            entry->data = *data;
+            for (unsigned u = 0; u < ARRAY_SIZE(entry->data.common.desc_sets);
+                 u++) {
+               entry->data.common.desc_sets[u].bindings = NULL;
+               entry->data.common.desc_sets[u].binding_count = 0;
+            }
+            entry->num_tile_buffers = load_op->num_tile_buffers;
+            entry->const_shareds_count = load_op->const_shareds_count;
+            entry->shareds_count = load_op->shareds_count;
+            entry->bin_size = bin_size;
+            memcpy(entry->bin, bin, bin_size);
+
+            simple_mtx_lock(&device->loadop_cache_mtx);
+            if (_mesa_hash_table_search(device->loadop_cache, entry->key))
+               free(entry);
+            else
+               _mesa_hash_table_insert(device->loadop_cache, entry->key, entry);
+            simple_mtx_unlock(&device->loadop_cache_mtx);
+         }
+      }
+   }
 
    VkResult result = pvr_gpu_upload_usc(device,
-                                        pco_shader_binary_data(loadop),
-                                        pco_shader_binary_size(loadop),
+                                        bin,
+                                        bin_size,
                                         cache_line_size,
                                         &load_op->usc_frag_prog_bo);
 
@@ -665,12 +836,12 @@ pvr_arch_load_op_shader_generate(struct pvr_device *device,
    result =
       pvr_pds_fragment_program_create_and_upload(device,
                                                  allocator,
-                                                 loadop,
+                                                 data,
                                                  load_op->usc_frag_prog_bo,
                                                  &load_op->pds_frag_prog,
                                                  msaa);
 
-   load_op->temps_count = pco_shader_data(loadop)->common.temps;
+   load_op->temps_count = data->common.temps;
    ralloc_free(loadop);
 
    if (result != VK_SUCCESS)
