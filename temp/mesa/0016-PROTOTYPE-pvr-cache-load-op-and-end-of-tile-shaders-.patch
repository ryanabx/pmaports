 VkResult
 pvr_arch_load_op_shader_generate(struct pvr_device *device,
                                  const VkAllocationCallbacks *allocator,
@@ -645,12 +749,79 @@ pvr_arch_load_op_shader_generate(struct pvr_device *device,
