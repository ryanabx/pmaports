+      struct hash_entry *he =
+         _mesa_hash_table_search(device->loadop_cache, key);
+      cached = he ? he->data : NULL;
+      simple_mtx_unlock(&device->loadop_cache_mtx);
+   }
+
+   if (use_cache && getenv("SUEZ_PVR_CACHE_DEBUG")) {
+      char hex[BLAKE3_HEX_LEN];
+      _mesa_blake3_format(hex, key);
+      fprintf(stderr, "pvr-loadop-cache: %s %.16s clear=%x load=%x\n",
+              cached ? "hit " : "miss", hex,
