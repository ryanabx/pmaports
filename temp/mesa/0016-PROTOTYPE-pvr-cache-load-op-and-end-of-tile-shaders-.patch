+   blake3_hash key;
+
+   if (use_cache) {
+      struct mesa_blake3 ctx;
+
+      _mesa_blake3_init(&ctx);
+      _mesa_blake3_update(&ctx, &props.emit_count, sizeof(props.emit_count));
+      _mesa_blake3_update(&ctx,
+                          &props.shared_words,
+                          sizeof(props.shared_words));
+      _mesa_blake3_update(&ctx,
+                          props.state_words,
+                          emit_count * ROGUE_NUM_PBESTATE_STATE_WORDS *
+                             sizeof(props.state_words[0]));
+      _mesa_blake3_update(&ctx,
+                          &props.msaa_samples,
+                          sizeof(props.msaa_samples));
+      _mesa_blake3_update(&ctx,
+                          &props.num_output_regs,
+                          sizeof(props.num_output_regs));
+      _mesa_blake3_update(&ctx,
+                          props.tile_buffer_addrs,
+                          sizeof(props.tile_buffer_addrs));
+      _mesa_blake3_final(&ctx, key);
+
+      simple_mtx_lock(&device->loadop_cache_mtx);
+      struct hash_entry *he = _mesa_hash_table_search(device->eot_cache, key);
+      cached = he ? he->data : NULL;
+      simple_mtx_unlock(&device->loadop_cache_mtx);
+   }
+
+   if (use_cache && getenv("SUEZ_PVR_CACHE_DEBUG")) {
+      char hex[BLAKE3_HEX_LEN];
+      _mesa_blake3_format(hex, key);
+      fprintf(stderr, "pvr-eot-cache: %s %.16s emit=%u w0=%08x w1=%08x w2=%08x w3=%08x\n",
+              cached ? "hit " : "miss", hex, emit_count,
+              emit_count ? props.state_words[0] : 0,
+              emit_count ? props.state_words[1] : 0,
+              emit_count ? props.state_words[2] : 0,
+              emit_count ? props.state_words[3] : 0);
+   }
+
+   if (cached) {
+      usc_temp_count = cached->temps;
+      result = pvr_cmd_buffer_upload_usc(cmd_buffer,
+                                         cached->bin,
+                                         cached->bin_size,
+                                         4,
+                                         &usc_eot_program);
+   } else {
+      eot = pvr_usc_eot(device->pdevice->pco_ctx,
+                        &props,
+                        &device->pdevice->dev_info);
+      usc_temp_count = pco_shader_data(eot)->common.temps;
+
+      result = pvr_cmd_buffer_upload_usc(cmd_buffer,
+                                         pco_shader_binary_data(eot),
+                                         pco_shader_binary_size(eot),
+                                         4,
+                                         &usc_eot_program);
+
+      if (use_cache) {
+         const uint32_t bin_size = pco_shader_binary_size(eot);
+         struct pvr_eot_cache_entry *entry = malloc(sizeof(*entry) + bin_size);
+
+         if (entry) {
+            memcpy(entry->key, key, sizeof(key));
+            entry->temps = usc_temp_count;
+            entry->bin_size = bin_size;
+            memcpy(entry->bin, pco_shader_binary_data(eot), bin_size);
+
+            simple_mtx_lock(&device->loadop_cache_mtx);
+            if (_mesa_hash_table_num_entries(device->eot_cache) >= 128) {
+               hash_table_foreach (device->eot_cache, he)
+                  free(he->data);
+               _mesa_hash_table_clear(device->eot_cache, NULL);
+            }
+            if (_mesa_hash_table_search(device->eot_cache, entry->key))
+               free(entry);
+            else
+               _mesa_hash_table_insert(device->eot_cache, entry->key, entry);
+            simple_mtx_unlock(&device->loadop_cache_mtx);
+         }
+      }
 
-   ralloc_free(eot);
+      ralloc_free(eot);
+   }
 
    if (result != VK_SUCCESS)
       return result;
