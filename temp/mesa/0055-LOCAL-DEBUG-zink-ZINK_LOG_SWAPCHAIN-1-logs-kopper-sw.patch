             return;
+         }
       }
       cdt->old_swapchain = cswap->next;
       destroy_swapchain(screen, cswap);
@@ -380,6 +408,11 @@ kopper_CreateSwapchain(struct zink_screen *screen, struct kopper_displaytarget *
    }
    cswap->last_present = UINT32_MAX;
 
+   if (kopper_log_swapchain())
+      mesa_logi("zink-swapchain: create %p %ux%u present mode %d min images %u, got %u",
+                (void *)cswap, cswap->scci.imageExtent.width, cswap->scci.imageExtent.height,
+                cswap->scci.presentMode, cswap->scci.minImageCount, cswap->num_images);
+
    *result = VK_SUCCESS;
