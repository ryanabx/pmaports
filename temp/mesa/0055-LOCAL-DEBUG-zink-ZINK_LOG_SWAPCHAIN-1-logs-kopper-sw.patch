+/* LOCAL DEBUG: ZINK_LOG_SWAPCHAIN=1 logs swapchain creation, destruction and
+ * why old swapchains aren't pruned.
+ */
+static bool
+kopper_log_swapchain(void)
+{
+   static int log = -1;
+   if (log < 0)
+      log = debug_get_bool_option("ZINK_LOG_SWAPCHAIN", false);
+   return log;
+}
+
 static void
 zink_kopper_set_present_mode_for_interval(struct kopper_displaytarget *cdt, int interval)
 {
@@ -164,6 +179,8 @@ recycle_semaphore(struct zink_screen *screen, VkSemaphore sem)
 static void
 destroy_swapchain(struct zink_screen *screen, struct kopper_swapchain *cswap)
 {
