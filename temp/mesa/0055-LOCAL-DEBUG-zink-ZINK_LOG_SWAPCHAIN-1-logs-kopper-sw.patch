+      mesa_logi("zink-swapchain: destroy %p (%u images)", (void *)cswap, cswap->num_images);
    if (!cswap)
       return;
    util_queue_fence_destroy(&cswap->present_fence);
@@ -197,16 +214,23 @@ prune_old_swapchains(struct zink_screen *screen, struct kopper_displaytarget *cd
       struct kopper_swapchain *cswap = cdt->old_swapchain;
       /* present_fence is always in signalled state when !cdt->async */
       if (cdt->async && cdt->swapchain && !util_queue_fence_is_signalled(&cdt->swapchain->present_fence)) {
-         if (!wait)
