+   /* A constant LOD bias with the sampler state in registers: fold it into
+    * the sampler's own LOD bias (dadjust, 5.8 fixed point in bits 0..12 of
+    * the first sampler word) instead of passing it with the coordinates.
+    * Per-pixel LOD sampling costs the texture unit about 2.5x per sample;
+    * the sampler bias is applied with the hardware's per-quad LOD. Vulkan
+    * clamps the sum of both biases to maxSamplerLodBias (16), the field's
+    * range.
+    */
+   nir_intrinsic_instr *smp_load =
+      params->smp_state && nir_def_is_intrinsic(params->smp_state)
+         ? nir_def_as_intrinsic(params->smp_state)
+         : NULL;
+   nir_intrinsic_instr *tex_load =
+      params->tex_state && nir_def_is_intrinsic(params->tex_state)
+         ? nir_def_as_intrinsic(params->tex_state)
+         : NULL;
+   /* The sample must be in the function's top-level control flow, so that
+    * the preamble can compute the modified state once per draw into shared
+    * registers (pco_nir_opt_preamble); sample instructions read their state
+    * from shared registers.
+    */
+   nir_block *cursor_block = nir_cursor_current_block(b->cursor);
+   bool top_level = cursor_block->cf_node.parent == &b->impl->cf_node;
+   if (params->lod_bias && smp_load && tex_load && !params->addr_lo &&
+       PCO_DEBUG(PREAMBLE) && top_level &&
+       smp_load->intrinsic == nir_intrinsic_load_smp_state_pco &&
+       tex_load->intrinsic == nir_intrinsic_load_tex_state_pco &&
+       nir_src_is_const(smp_load->src[0]) &&
+       nir_src_is_const(tex_load->src[0]) &&
+       nir_scalar_is_const(nir_get_scalar(params->lod_bias, 0))) {
+      float bias = nir_scalar_as_float(nir_get_scalar(params->lod_bias, 0));
+      int delta = _mesa_lroundevenf(
+         CLAMP(bias, -32.0f, 32.0f) *
+         256.0f);
+
+      nir_def *w0 = nir_channel(b, params->smp_state, 0);
+      nir_def *dadjust = nir_iand_imm(b, w0, 0x1fff);
+      dadjust = nir_iadd_imm(b, dadjust, delta);
+      dadjust = nir_imax(b, dadjust, nir_imm_int(b, 0));
+      dadjust = nir_imin(b, dadjust, nir_imm_int(b, 0x1fff));
+      w0 = nir_ior(b, nir_iand_imm(b, w0, ~0x1fffu), dadjust);
+
+      params->smp_state = nir_vector_insert_imm(b, params->smp_state, w0, 0);
+      params->lod_bias = NULL;
+   }
+
    /* Emit LOD (if present). */
    bool lod_present = false;
    assert(!!params->lod_ddx == !!params->lod_ddy);
