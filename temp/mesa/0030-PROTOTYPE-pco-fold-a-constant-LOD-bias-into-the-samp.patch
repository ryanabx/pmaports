+   /* Texture/sampler state computed in the preamble stays a vector. */
+   if (only_used_as_tex_smp_state(&intr->def))
+      return false;
+
    unsigned base = nir_intrinsic_base(intr);
    nir_preamble_class preamble_class = nir_intrinsic_preamble_class(intr);
 
