+/* Whether a def is only used as texture/sampler state by sample
+ * instructions, which take the state as a vector of shared registers.
+ */
+static bool only_used_as_tex_smp_state(nir_def *def)
+{
+   nir_foreach_use_including_if (src, def) {
+      if (nir_src_is_if(src))
+         return false;
+
+      nir_instr *instr = nir_src_use_instr(src);
+      if (instr->type != nir_instr_type_intrinsic)
+         return false;
+
+      switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+      case nir_intrinsic_smp_pco:
+      case nir_intrinsic_smp_coeffs_pco:
+      case nir_intrinsic_smp_raw_pco: {
+         nir_intrinsic_instr *smp = nir_instr_as_intrinsic(instr);
+         if (src != &smp->src[1] && src != &smp->src[2])
+            return false;
+         break;
+      }
+
+      default:
+         return false;
+      }
+   }
+
+   return true;
+}
