+/* PROTOTYPE: graphics pipeline cache.
+ *
+ * pvr ignored VkPipelineCache, so every pipeline was compiled from SPIR-V on
+ * every process start (zink's and GTK's pipelines: ~0.7 s of a GTK app's
+ * first frame on GX6250). This caches the compiled result of a whole
+ * graphics pipeline as a raw blob, keyed by everything the compile reads:
+ * the stages, the layout, the graphics state, the enabled features and the
+ * compiler's environment switches. The runtime backs it with the disk cache.
+ * Not cached: render-pass pipelines, capture flags, transform feedback.
+ */
+#define PVR_GFX_CACHE_MAGIC 0x47525650u /* "PVRG" */
+#define PVR_GFX_CACHE_VERSION 1u
+
+struct pvr_gfx_cache_hdr {
+   uint32_t magic;
+   uint32_t version;
+   uint32_t has_fs;
+   uint32_t fs_passthrough;
+   uint32_t vs_bin_size;
+   uint32_t fs_bin_size;
+   uint64_t fs_varyings_used;
+   uint8_t fs_interp[64];
+   uint32_t vs_binding_counts[PVR_MAX_DESCRIPTOR_SETS];
+   uint32_t fs_binding_counts[PVR_MAX_DESCRIPTOR_SETS];
+   pco_data vs_data;
+   pco_data fs_data;
+};
+
+static void pvr_gfx_cache_hash_str(struct mesa_blake3 *ctx, const char *name)
+{
+   const char *v = getenv(name);
+   _mesa_blake3_update(ctx, name, strlen(name) + 1);
+   if (v)
+      _mesa_blake3_update(ctx, v, strlen(v) + 1);
+   else
+      _mesa_blake3_update(ctx, "", 1);
+}
+
+#define PVR_GFX_CACHE_HASH_STATE(ctx, ptr)                     \
+   do {                                                       \
+      const uint8_t present = (ptr) != NULL;                  \
+      _mesa_blake3_update(ctx, &present, sizeof(present));    \
+      if (ptr)                                                \
+         _mesa_blake3_update(ctx, (ptr), sizeof(*(ptr)));     \
+   } while (0)
+
+static void
+pvr_gfx_pipeline_cache_key(const struct pvr_device *device,
+                           const VkGraphicsPipelineCreateInfo *pCreateInfo,
+                           const struct pvr_graphics_pipeline *gfx_pipeline,
+                           const struct vk_graphics_pipeline_state *state,
+                           blake3_hash key)
+{
+   const struct vk_pipeline_layout *layout = gfx_pipeline->base.layout;
+   struct mesa_blake3 ctx;
+
+   _mesa_blake3_init(&ctx);
+
+   static const char tag[] = "pvr-gfx-pipeline-v1";
+   _mesa_blake3_update(&ctx, tag, sizeof(tag));
+   _mesa_blake3_update(&ctx,
+                       &gfx_pipeline->base.pipeline_flags,
+                       sizeof(gfx_pipeline->base.pipeline_flags));
+
+   for (mesa_shader_stage stage = 0; stage < MESA_SHADER_STAGES; ++stage) {
+      const size_t stage_index = gfx_pipeline->stage_indices[stage];
+      blake3_hash stage_hash;
+      const uint32_t s = stage;
+
+      if (stage_index == ~0)
+         continue;
+
+      vk_pipeline_hash_shader_stage(gfx_pipeline->base.pipeline_flags,
+                                    &pCreateInfo->pStages[stage_index],
+                                    NULL,
+                                    stage_hash);
+      _mesa_blake3_update(&ctx, &s, sizeof(s));
+      _mesa_blake3_update(&ctx, stage_hash, sizeof(stage_hash));
+   }
+
+   _mesa_blake3_update(&ctx, &layout->set_count, sizeof(layout->set_count));
+   for (uint32_t i = 0; i < layout->set_count; i++) {
+      static const blake3_hash zero = { 0 };
+      const struct vk_descriptor_set_layout *set_layout =
+         layout->set_layouts[i];
+
+      _mesa_blake3_update(&ctx,
+                          set_layout ? set_layout->blake3 : zero,
+                          sizeof(blake3_hash));
+   }
+   _mesa_blake3_update(&ctx,
+                       &layout->push_range_count,
+                       sizeof(layout->push_range_count));
+   _mesa_blake3_update(&ctx,
+                       layout->push_ranges,
+                       layout->push_range_count *
+                          sizeof(layout->push_ranges[0]));
+
+   /* The state structs are hashed by value: pvr_graphics_pipeline_init()
+    * zeroes them before vk_graphics_pipeline_state_fill(), so their padding
+    * is deterministic. The multisample state's one pointer is hashed by
+    * what it points to.
+    */
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->vi);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->ia);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->ts);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->vp);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->dr);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->rs);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->fsr);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->ds);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->cb);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->ial);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->cal);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->mv);
+   PVR_GFX_CACHE_HASH_STATE(&ctx, state->rp);
+   if (state->ms) {
+      struct vk_multisample_state ms = *state->ms;
+
+      ms.sample_locations = NULL;
+      PVR_GFX_CACHE_HASH_STATE(&ctx, &ms);
+      PVR_GFX_CACHE_HASH_STATE(&ctx, state->ms->sample_locations);
+   } else {
+      const struct vk_multisample_state *none = NULL;
+      PVR_GFX_CACHE_HASH_STATE(&ctx, none);
+   }
+   _mesa_blake3_update(&ctx, state->dynamic, sizeof(state->dynamic));
+   _mesa_blake3_update(&ctx,
+                       &state->pipeline_flags,
+                       sizeof(state->pipeline_flags));
+   _mesa_blake3_update(&ctx,
+                       &state->feedback_loop_not_input_only,
+                       sizeof(state->feedback_loop_not_input_only));
+   _mesa_blake3_update(&ctx,
+                       &state->rasterization_order_access,
+                       sizeof(state->rasterization_order_access));
+
+   _mesa_blake3_update(&ctx,
+                       &device->vk.enabled_features,
+                       sizeof(device->vk.enabled_features));
+
+   pvr_gfx_cache_hash_str(&ctx, "PCO_DEBUG");
+   pvr_gfx_cache_hash_str(&ctx, "PVR_DEBUG");
+   pvr_gfx_cache_hash_str(&ctx, "SUEZ_PVR_2D_VIEW_OF_3D");
+
+   _mesa_blake3_final(&ctx, key);
+}
+
+static void pvr_gfx_cache_fs_varyings(nir_shader *fs,
+                                      uint64_t *varyings_used,
+                                      uint8_t interp[64])
+{
+   *varyings_used = fs->info.inputs_read &
+                    BITFIELD64_RANGE(VARYING_SLOT_VAR0, MAX_VARYING);
+
+   u_foreach_bit64 (varying, *varyings_used) {
+      nir_variable *var =
+         nir_find_variable_with_location(fs, nir_var_shader_in, varying);
+      assert(var);
+      interp[varying] = var->data.interpolation;
+   }
+}
+
+/* Serializes a compiled pipeline; returns a malloc'd blob or NULL. */
+static void *pvr_gfx_cache_serialize(const pco_data *vs_data,
+                                     const void *vs_bin,
+                                     uint32_t vs_bin_size,
+                                     const pco_data *fs_data,
+                                     const void *fs_bin,
+                                     uint32_t fs_bin_size,
+                                     bool fs_passthrough,
+                                     uint64_t fs_varyings_used,
+                                     const uint8_t fs_interp[64],
+                                     size_t *size_out)
+{
+   struct pvr_gfx_cache_hdr hdr = {
+      .magic = PVR_GFX_CACHE_MAGIC,
+      .version = PVR_GFX_CACHE_VERSION,
+      .has_fs = fs_data != NULL,
+      .fs_passthrough = fs_passthrough,
+      .vs_bin_size = vs_bin_size,
+      .fs_bin_size = fs_bin_size,
+      .fs_varyings_used = fs_varyings_used,
+   };
+   size_t size = sizeof(hdr) + vs_bin_size + fs_bin_size;
+
+   memcpy(hdr.fs_interp, fs_interp, sizeof(hdr.fs_interp));
+   hdr.vs_data = *vs_data;
+   if (fs_data)
+      hdr.fs_data = *fs_data;
+
+   for (unsigned u = 0; u < PVR_MAX_DESCRIPTOR_SETS; u++) {
+      hdr.vs_binding_counts[u] =
+         vs_data->common.desc_sets[u].bindings
+            ? vs_data->common.desc_sets[u].binding_count
+            : 0;
+      hdr.vs_data.common.desc_sets[u].bindings = NULL;
+      size += hdr.vs_binding_counts[u] * sizeof(pco_binding_data);
+
+      if (fs_data) {
+         hdr.fs_binding_counts[u] =
+            fs_data->common.desc_sets[u].bindings
+               ? fs_data->common.desc_sets[u].binding_count
+               : 0;
+         hdr.fs_data.common.desc_sets[u].bindings = NULL;
+         size += hdr.fs_binding_counts[u] * sizeof(pco_binding_data);
+      }
+   }
+   hdr.vs_data.vs.xfb_info = NULL;
+
+   uint8_t *blob = malloc(size);
+   if (!blob)
+      return NULL;
+
+   uint8_t *p = blob;
+   memcpy(p, &hdr, sizeof(hdr));
+   p += sizeof(hdr);
+   for (unsigned u = 0; u < PVR_MAX_DESCRIPTOR_SETS; u++) {
+      size_t n = hdr.vs_binding_counts[u] * sizeof(pco_binding_data);
+      if (n)
+         memcpy(p, vs_data->common.desc_sets[u].bindings, n);
+      p += n;
+   }
+   for (unsigned u = 0; u < PVR_MAX_DESCRIPTOR_SETS; u++) {
+      size_t n = hdr.fs_binding_counts[u] * sizeof(pco_binding_data);
+      if (n)
+         memcpy(p, fs_data->common.desc_sets[u].bindings, n);
+      p += n;
+   }
+   memcpy(p, vs_bin, vs_bin_size);
+   p += vs_bin_size;
+   if (fs_bin_size)
+      memcpy(p, fs_bin, fs_bin_size);
+   p += fs_bin_size;
+   assert(p == blob + size);
+
+   *size_out = size;
+   return blob;
+}
+
+/* Restores a compiled pipeline from a blob. On success the binaries point
+ * into the blob and the binding arrays are rzalloc'd, as
+ * pvr_init_descriptors() does.
+ */
+static bool pvr_gfx_cache_deserialize(const void *data,
+                                      size_t size,
+                                      pco_data *vs_data,
+                                      const void **vs_bin,
+                                      uint32_t *vs_bin_size,
+                                      pco_data *fs_data,
+                                      bool *has_fs,
+                                      const void **fs_bin,
+                                      uint32_t *fs_bin_size,
+                                      bool *fs_passthrough,
+                                      uint64_t *fs_varyings_used,
+                                      uint8_t fs_interp[64])
+{
+   struct pvr_gfx_cache_hdr hdr;
+   const uint8_t *p = data;
+   size_t need = sizeof(hdr);
+
+   if (size < sizeof(hdr))
+      return false;
+   memcpy(&hdr, p, sizeof(hdr));
+   if (hdr.magic != PVR_GFX_CACHE_MAGIC ||
+       hdr.version != PVR_GFX_CACHE_VERSION)
+      return false;
+
+   for (unsigned u = 0; u < PVR_MAX_DESCRIPTOR_SETS; u++) {
+      need += (hdr.vs_binding_counts[u] + hdr.fs_binding_counts[u]) *
+              sizeof(pco_binding_data);
+   }
+   need += hdr.vs_bin_size + hdr.fs_bin_size;
+   if (size != need)
+      return false;
+
+   p += sizeof(hdr);
+   *vs_data = hdr.vs_data;
+   *fs_data = hdr.fs_data;
+
+   for (unsigned v = 0; v < 2; v++) {
+      pco_data *d = v ? fs_data : vs_data;
+      const uint32_t *counts = v ? hdr.fs_binding_counts : hdr.vs_binding_counts;
+
+      for (unsigned u = 0; u < PVR_MAX_DESCRIPTOR_SETS; u++) {
+         size_t n = counts[u] * sizeof(pco_binding_data);
+
+         d->common.desc_sets[u].bindings = NULL;
+         if (!counts[u])
+            continue;
+
+         d->common.desc_sets[u].bindings =
+            rzalloc_array_size(NULL, sizeof(pco_binding_data), counts[u]);
+         memcpy(d->common.desc_sets[u].bindings, p, n);
+         p += n;
+      }
+   }
+
+   *vs_bin = p;
+   *vs_bin_size = hdr.vs_bin_size;
+   p += hdr.vs_bin_size;
+   *fs_bin = hdr.fs_bin_size ? p : NULL;
+   *fs_bin_size = hdr.fs_bin_size;
+   *has_fs = hdr.has_fs;
+   *fs_passthrough = hdr.fs_passthrough;
+   *fs_varyings_used = hdr.fs_varyings_used;
+   memcpy(fs_interp, hdr.fs_interp, sizeof(hdr.fs_interp));
+
+   return true;
+}
+
 /* Compiles and uploads shaders and PDS programs. */
 static VkResult
 pvr_graphics_pipeline_compile(struct pvr_device *const device,
@@ -2989,6 +3295,66 @@ pvr_graphics_pipeline_compile(struct pvr_device *const device,
    uint32_t vtx_dma_count = 0;
    bool build_fs_passthrough = false;
 
+   /* PROTOTYPE: pipeline cache; see pvr_gfx_pipeline_cache_key(). */
+   struct vk_pipeline_cache *pcache = cache ? cache : device->vk.mem_cache;
+   const bool cacheable =
+      pcache && !pCreateInfo->renderPass &&
+      !(pCreateInfo->flags &
+        (VK_PIPELINE_CREATE_CAPTURE_STATISTICS_BIT_KHR |
+         VK_PIPELINE_CREATE_CAPTURE_INTERNAL_REPRESENTATIONS_BIT_KHR)) &&
+      !getenv("SUEZ_PVR_NO_PIPELINE_CACHE");
+   struct vk_pipeline_cache_object *cached = NULL;
+   blake3_hash cache_key;
+   pco_data cached_vs_data, cached_fs_data;
+   const void *vs_bin = NULL, *fs_bin = NULL;
+   uint32_t vs_bin_size = 0, fs_bin_size = 0;
+   const pco_data *vs_data_src = NULL, *fs_data_src = NULL;
+   bool have_fs = false;
+   uint64_t fs_varyings_used = 0;
+   uint8_t fs_interp[64] = { 0 };
+
+   if (cacheable) {
+      pvr_gfx_pipeline_cache_key(device, pCreateInfo, gfx_pipeline, state,
+                                 cache_key);
+      cached = vk_pipeline_cache_lookup_object(pcache,
+                                               cache_key,
+                                               sizeof(cache_key),
+                                               &vk_raw_data_cache_object_ops,
+                                               NULL);
+      if (getenv("SUEZ_PVR_CACHE_DEBUG")) {
+         char hex[BLAKE3_HEX_LEN];
+         _mesa_blake3_format(hex, cache_key);
+         fprintf(stderr, "pvr-gfx-cache: %s %.16s\n",
+                 cached ? "hit " : "miss", hex);
+      }
+      if (cached) {
+         const struct vk_raw_data_cache_object *raw =
+            container_of(cached, struct vk_raw_data_cache_object, base);
+
+         if (pvr_gfx_cache_deserialize(raw->data,
+                                       raw->data_size,
+                                       &cached_vs_data,
+                                       &vs_bin,
+                                       &vs_bin_size,
+                                       &cached_fs_data,
+                                       &have_fs,
+                                       &fs_bin,
+                                       &fs_bin_size,
+                                       &build_fs_passthrough,
+                                       &fs_varyings_used,
+                                       fs_interp)) {
+            vs_data_src = &cached_vs_data;
+            fs_data_src = have_fs ? &cached_fs_data : NULL;
+            if (!pCreateInfo->renderPass)
+               pvr_arch_destroy_mrt_setup(device, &mrt_setup);
+            goto compiled;
+         }
+
+         vk_pipeline_cache_object_unref(&device->vk, cached);
+         cached = NULL;
+      }
+   }
+
    for (mesa_shader_stage stage = 0; stage < MESA_SHADER_STAGES; ++stage) {
