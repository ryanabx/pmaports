From 8a41ca5eb06ff0e18de9731508263b2e3a7f5208 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Wed, 11 Nov 2026 21:24:24 -0600
Subject: [PATCH] LOCAL: pvr: pipeline cache for compiled shaders
 (PVR_NO_PIPELINE_CACHE=1 disables)

vk_pipeline_cache was passed around but never used, so every pipeline
was compiled from SPIR-V in every process. Cache the compiler's output
for a whole pipeline (each stage's pco_data and USC binary, plus the
fragment varyings' interpolation for the coefficient program) as a
vk_pipeline_cache object with serialize/deserialize, so it reaches the
disk cache and vkGetPipelineCacheData. PDS programs and uploads are
rebuilt from the entry.

The key hashes the stages (vk_pipeline_hash_shader_stage), the pipeline
layout (binding layout and YCbCr conversions of immutable samplers),
the enabled features the compiler reads, the vertex attribute formats,
the attachment formats, view mask, blend, multisample and dynamic
state. Not cached: pipelines with a VkRenderPass, ones capturing
statistics or internal representations, and processes with compiler
debug or test switches set. A weak-reference device cache serves
pipelines created without a VkPipelineCache. PVR_LOG_PIPELINE_CACHE=1
logs hits, misses and times.

Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_arch_device.c   |   18 +
 src/imagination/vulkan/pvr_arch_pipeline.c | 1011 +++++++++++++++++---
 2 files changed, 920 insertions(+), 109 deletions(-)

diff --git a/src/imagination/vulkan/pvr_arch_device.c b/src/imagination/vulkan/pvr_arch_device.c
index 237f25b8516..56f543f9d22 100644
--- a/src/imagination/vulkan/pvr_arch_device.c
+++ b/src/imagination/vulkan/pvr_arch_device.c
@@ -13,6 +13,7 @@
 #include "pvr_device.h"
 
 #include "vk_log.h"
+#include "vk_pipeline_cache.h"
 #include "util/u_debug.h"
 
 #include "hwdef/pvr_hw_utils.h"
@@ -827,6 +828,19 @@ VkResult PVR_PER_ARCH(create_device)(struct pvr_physical_device *pdevice,
 
    vk_device_set_drm_fd(&device->vk, ws->render_fd);
 
+   /* LOCAL: the cache for pipelines created without a VkPipelineCache. Its
+    * entries live only while in use; the disk cache keeps them across
+    * processes. Without it (allocation failure) those pipelines are just
+    * not cached.
+    */
+   {
+      const struct vk_pipeline_cache_create_info cache_info = {
+         .weak_ref = true,
+      };
+      device->vk.mem_cache =
+         vk_pipeline_cache_create(&device->vk, &cache_info, NULL);
+   }
+
    if (ws->features.supports_threaded_submit) {
       /* Queue submission can be blocked if the kernel CCBs become full,
        * so enable threaded submit to not block the submitter.
@@ -1064,6 +1078,8 @@ err_dec_device_count:
    pvr_bo_store_destroy(device);
 
 err_vk_device_finish:
+   if (device->vk.mem_cache)
+      vk_pipeline_cache_destroy(device->vk.mem_cache, NULL);
    vk_device_finish(&device->vk);
 
 err_free_device:
@@ -1130,6 +1146,8 @@ void PVR_PER_ARCH(destroy_device)(struct pvr_device *device,
    pvr_bo_store_destroy(device);
    pvr_winsys_destroy(device->ws);
    p_atomic_dec(&device->instance->active_device_count);
+   if (device->vk.mem_cache)
+      vk_pipeline_cache_destroy(device->vk.mem_cache, NULL);
    vk_device_finish(&device->vk);
    vk_free(&device->vk.alloc, device);
 }
diff --git a/src/imagination/vulkan/pvr_arch_pipeline.c b/src/imagination/vulkan/pvr_arch_pipeline.c
index 8256c3b36ed..350adcc6b4b 100644
--- a/src/imagination/vulkan/pvr_arch_pipeline.c
+++ b/src/imagination/vulkan/pvr_arch_pipeline.c
@@ -57,7 +57,10 @@
 
 #include "util/u_debug.h"
 #include "util/log.h"
+#include "util/blob.h"
 #include "util/macros.h"
+#include "util/mesa-blake3.h"
+#include "util/os_time.h"
 #include "util/ralloc.h"
 #include "util/shader_stats.h"
 #include "util/u_dynarray.h"
@@ -128,12 +131,11 @@ static VkResult pvr_pds_coeff_program_create_and_upload(
 static VkResult pvr_pds_fragment_program_create(
    struct pvr_device *device,
    const VkAllocationCallbacks *allocator,
-   pco_shader *fs,
+   const pco_data *fs_data,
    struct pvr_fragment_shader_state *fragment_state)
 {
    struct pvr_pds_kickusc_program *program =
       &fragment_state->pds_fragment_program;
-   pco_data *fs_data = pco_shader_data(fs);
    uint32_t staging_buffer_size;
    uint32_t *staging_buffer;
 
@@ -979,37 +981,622 @@ lookup_ycbcr_conversion(const void *_state,
 }
 
 /******************************************************************************
-   Compute pipeline functions
+   LOCAL: pipeline cache
  ******************************************************************************/
 
+/* A cache entry holds what the compiler produces for a whole pipeline: the
+ * shader data and the USC binary of each stage, and for the fragment stage
+ * the interpolation of each varying (the coefficient program needs it, and
+ * otherwise reads it from the NIR). Everything after that (PDS programs,
+ * uploads) is rebuilt from the entry, so it can go through
+ * vk_pipeline_cache and from there to the disk cache.
+ *
+ * The key hashes every input the compile reads; see
+ * pvr_graphics_pipeline_hash(). Pipelines made with a VkRenderPass, ones
+ * that capture statistics or internal representations, and processes with
+ * compiler debug or test switches set are not cached. PVR_NO_PIPELINE_CACHE=1
+ * turns the cache off.
+ */
+
+#define PVR_PIPELINE_CACHE_VERSION 1u
+
+enum pvr_cache_slot {
+   PVR_CACHE_SLOT_VS,
+   PVR_CACHE_SLOT_FS,
+   PVR_CACHE_SLOT_CS,
+   PVR_CACHE_SLOT_COUNT,
+};
+
+struct pvr_pipeline_cache_entry {
+   struct vk_pipeline_cache_object base;
+   uint8_t key[BLAKE3_OUT_LEN];
+
+   uint32_t slot_mask;
+   pco_data data[PVR_CACHE_SLOT_COUNT];
+   void *binary[PVR_CACHE_SLOT_COUNT];
+   uint32_t binary_size[PVR_CACHE_SLOT_COUNT];
+
+   /* Fragment stage: generic varyings read, and their interpolation. */
+   uint64_t fs_varyings_used;
+   uint8_t fs_interp[MAX_VARYING];
+};
+
+static const struct vk_pipeline_cache_object_ops pvr_pipeline_cache_entry_ops;
+
+static void pvr_pipeline_destroy_shader_data(pco_data *data, bool vs);
+
+/* Deep-copies shader data: the descriptor binding arrays and the vertex
+ * shader's transform feedback info are allocated separately.
+ */
+static bool pvr_pco_data_copy(pco_data *dst, const pco_data *src, bool vs)
+{
+   memcpy(dst, src, sizeof(*dst));
+
+   for (unsigned u = 0; u < ARRAY_SIZE(dst->common.desc_sets); ++u) {
+      pco_descriptor_set_data *set = &dst->common.desc_sets[u];
+
+      set->bindings = NULL;
+      if (!src->common.desc_sets[u].bindings || !set->binding_count)
+         continue;
+
+      set->bindings =
+         ralloc_memdup(NULL,
+                       src->common.desc_sets[u].bindings,
+                       set->binding_count * sizeof(*set->bindings));
+      if (!set->bindings)
+         goto err_free;
+   }
+
+   if (vs) {
+      dst->vs.xfb_info = NULL;
+      if (src->vs.xfb_info) {
+         dst->vs.xfb_info =
+            ralloc_memdup(NULL,
+                          src->vs.xfb_info,
+                          nir_xfb_info_size(src->vs.xfb_info->output_count));
+         if (!dst->vs.xfb_info)
+            goto err_free;
+      }
+   }
+
+   return true;
+
+err_free:
+   pvr_pipeline_destroy_shader_data(dst, vs);
+   memset(dst, 0, sizeof(*dst));
+   return false;
+}
+
+static struct pvr_pipeline_cache_entry *
+pvr_pipeline_cache_entry_create(struct vk_device *device,
+                                const void *key_data,
+                                size_t key_size)
+{
+   struct pvr_pipeline_cache_entry *entry;
+
+   assert(key_size == sizeof(entry->key));
+
+   entry = vk_zalloc(&device->alloc,
+                     sizeof(*entry),
+                     8,
+                     VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!entry)
+      return NULL;
+
+   memcpy(entry->key, key_data, sizeof(entry->key));
+   vk_pipeline_cache_object_init(device,
+                                 &entry->base,
+                                 &pvr_pipeline_cache_entry_ops,
+                                 entry->key,
+                                 sizeof(entry->key));
+
+   return entry;
+}
+
+static void pvr_pipeline_cache_entry_destroy(struct vk_device *device,
+                                             struct vk_pipeline_cache_object *obj)
+{
+   struct pvr_pipeline_cache_entry *entry =
+      container_of(obj, struct pvr_pipeline_cache_entry, base);
+
+   for (unsigned s = 0; s < PVR_CACHE_SLOT_COUNT; ++s) {
+      if (!(entry->slot_mask & BITFIELD_BIT(s)))
+         continue;
+
+      pvr_pipeline_destroy_shader_data(&entry->data[s],
+                                       s == PVR_CACHE_SLOT_VS);
+      vk_free(&device->alloc, entry->binary[s]);
+   }
+
+   vk_pipeline_cache_object_finish(&entry->base);
+   vk_free(&device->alloc, entry);
+}
+
+/* Takes over the shader's data (its binding and xfb allocations included)
+ * and copies its binary.
+ */
+static bool pvr_pipeline_cache_entry_set(struct vk_device *device,
+                                         struct pvr_pipeline_cache_entry *entry,
+                                         enum pvr_cache_slot slot,
+                                         pco_shader *shader)
+{
+   const uint32_t size = pco_shader_binary_size(shader);
+
+   entry->binary[slot] = vk_alloc(&device->alloc,
+                                  MAX2(size, 1),
+                                  8,
+                                  VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!entry->binary[slot])
+      return false;
+
+   memcpy(entry->binary[slot], pco_shader_binary_data(shader), size);
+   entry->binary_size[slot] = size;
+   memcpy(&entry->data[slot], pco_shader_data(shader), sizeof(pco_data));
+   entry->slot_mask |= BITFIELD_BIT(slot);
+
+   return true;
+}
+
+static bool
+pvr_pipeline_cache_entry_serialize(struct vk_pipeline_cache_object *obj,
+                                   struct blob *blob)
+{
+   struct pvr_pipeline_cache_entry *entry =
+      container_of(obj, struct pvr_pipeline_cache_entry, base);
+
+   blob_write_uint32(blob, PVR_PIPELINE_CACHE_VERSION);
+   blob_write_uint32(blob, sizeof(pco_data));
+   blob_write_uint32(blob, entry->slot_mask);
+   blob_write_uint64(blob, entry->fs_varyings_used);
+   blob_write_bytes(blob, entry->fs_interp, sizeof(entry->fs_interp));
+
+   for (unsigned s = 0; s < PVR_CACHE_SLOT_COUNT; ++s) {
+      const pco_data *data = &entry->data[s];
+
+      if (!(entry->slot_mask & BITFIELD_BIT(s)))
+         continue;
+
+      blob_write_bytes(blob, data, sizeof(*data));
+
+      for (unsigned u = 0; u < ARRAY_SIZE(data->common.desc_sets); ++u) {
+         const pco_descriptor_set_data *set = &data->common.desc_sets[u];
+         const bool has_bindings = set->bindings && set->binding_count;
+
+         blob_write_uint8(blob, has_bindings);
+         if (has_bindings) {
+            blob_write_bytes(blob,
+                             set->bindings,
+                             set->binding_count * sizeof(*set->bindings));
+         }
+      }
+
+      if (s == PVR_CACHE_SLOT_VS) {
+         const nir_xfb_info *xfb = data->vs.xfb_info;
+         const uint32_t xfb_size =
+            xfb ? nir_xfb_info_size(xfb->output_count) : 0;
+
+         blob_write_uint32(blob, xfb_size);
+         if (xfb_size)
+            blob_write_bytes(blob, xfb, xfb_size);
+      }
+
+      blob_write_uint32(blob, entry->binary_size[s]);
+      blob_write_bytes(blob, entry->binary[s], entry->binary_size[s]);
+   }
+
+   return !blob->out_of_memory;
+}
+
+static struct vk_pipeline_cache_object *
+pvr_pipeline_cache_entry_deserialize(struct vk_pipeline_cache *cache,
+                                     const void *key_data,
+                                     size_t key_size,
+                                     struct blob_reader *blob)
+{
+   struct vk_device *device = cache->base.device;
+   struct pvr_pipeline_cache_entry *entry;
+
+   if (key_size != sizeof(entry->key))
+      return NULL;
+
+   if (blob_read_uint32(blob) != PVR_PIPELINE_CACHE_VERSION ||
+       blob_read_uint32(blob) != sizeof(pco_data)) {
+      return NULL;
+   }
+
+   entry = pvr_pipeline_cache_entry_create(device, key_data, key_size);
+   if (!entry)
+      return NULL;
+
+   const uint32_t slot_mask = blob_read_uint32(blob);
+   entry->fs_varyings_used = blob_read_uint64(blob);
+   blob_copy_bytes(blob, entry->fs_interp, sizeof(entry->fs_interp));
+
+   if (slot_mask & ~BITFIELD_MASK(PVR_CACHE_SLOT_COUNT))
+      goto err_destroy;
+
+   for (unsigned s = 0; s < PVR_CACHE_SLOT_COUNT; ++s) {
+      pco_data *data = &entry->data[s];
+
+      if (!(slot_mask & BITFIELD_BIT(s)))
+         continue;
+
+      /* From here on the destroy callback frees this slot. */
+      entry->slot_mask |= BITFIELD_BIT(s);
+
+      blob_copy_bytes(blob, data, sizeof(*data));
+      for (unsigned u = 0; u < ARRAY_SIZE(data->common.desc_sets); ++u)
+         data->common.desc_sets[u].bindings = NULL;
+      if (s == PVR_CACHE_SLOT_VS)
+         data->vs.xfb_info = NULL;
+
+      if (blob->overrun)
+         goto err_destroy;
+
+      for (unsigned u = 0; u < ARRAY_SIZE(data->common.desc_sets); ++u) {
+         pco_descriptor_set_data *set = &data->common.desc_sets[u];
+
+         if (!blob_read_uint8(blob))
+            continue;
+
+         const size_t size = set->binding_count * sizeof(*set->bindings);
+         const void *src = blob_read_bytes(blob, size);
+         if (blob->overrun || !size)
+            goto err_destroy;
+
+         set->bindings = ralloc_memdup(NULL, src, size);
+         if (!set->bindings)
+            goto err_destroy;
+      }
+
+      if (s == PVR_CACHE_SLOT_VS) {
+         const uint32_t xfb_size = blob_read_uint32(blob);
+
+         if (xfb_size) {
+            const void *src = blob_read_bytes(blob, xfb_size);
+            if (blob->overrun)
+               goto err_destroy;
+
+            data->vs.xfb_info = ralloc_memdup(NULL, src, xfb_size);
+            if (!data->vs.xfb_info)
+               goto err_destroy;
+         }
+      }
+
+      const uint32_t size = blob_read_uint32(blob);
+      const void *src = blob_read_bytes(blob, size);
+      if (blob->overrun)
+         goto err_destroy;
+
+      entry->binary[s] = vk_alloc(&device->alloc,
+                                  MAX2(size, 1),
+                                  8,
+                                  VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+      if (!entry->binary[s])
+         goto err_destroy;
+
+      memcpy(entry->binary[s], src, size);
+      entry->binary_size[s] = size;
+   }
+
+   if (blob->overrun)
+      goto err_destroy;
+
+   return &entry->base;
+
+err_destroy:
+   pvr_pipeline_cache_entry_destroy(device, &entry->base);
+   return NULL;
+}
+
+static const struct vk_pipeline_cache_object_ops pvr_pipeline_cache_entry_ops = {
+   .serialize = pvr_pipeline_cache_entry_serialize,
+   .deserialize = pvr_pipeline_cache_entry_deserialize,
+   .destroy = pvr_pipeline_cache_entry_destroy,
+};
+
+/* Off when compiler debug or test switches are set: they change the code
+ * without changing the key.
+ */
+static bool pvr_pipeline_cache_allowed(VkPipelineCreateFlags2KHR flags)
+{
+   static const char *const switches[] = {
+      "PVR_NO_PIPELINE_CACHE", "PCO_DEBUG",          "PCO_SKIP_PASSES",
+      "PVR_FULL_DYNAMIC_FS",   "PVR_NULL_TEX_CHECK", "PVR_TEST_NO_NULL_TEX",
+   };
+
+   if (flags & (VK_PIPELINE_CREATE_2_CAPTURE_STATISTICS_BIT_KHR |
+                VK_PIPELINE_CREATE_2_CAPTURE_INTERNAL_REPRESENTATIONS_BIT_KHR)) {
+      return false;
+   }
+
+   for (unsigned u = 0; u < ARRAY_SIZE(switches); ++u) {
+      const char *value = getenv(switches[u]);
+      if (value && *value)
+         return false;
+   }
+
+   return true;
+}
+
+#define PVR_HASH(ctx, x) _mesa_blake3_update((ctx), &(x), sizeof(x))
+
+static void pvr_hash_device_features(blake3_hasher *ctx,
+                                     const struct pvr_device *device)
+{
+   const bool features[] = {
+      device->vk.enabled_features.robustBufferAccess,
+      device->vk.enabled_features.nullDescriptor,
+      device->vk.enabled_features.image2DViewOf3D,
+      device->vk.enabled_features.imageSlicedViewOf3D,
+   };
+
+   PVR_HASH(ctx, features);
+}
+
+static void pvr_hash_pipeline_layout(blake3_hasher *ctx,
+                                     const struct vk_pipeline_layout *layout)
+{
+   PVR_HASH(ctx, layout->set_count);
+
+   for (unsigned s = 0; s < layout->set_count; ++s) {
+      const struct pvr_descriptor_set_layout *set_layout =
+         layout->set_layouts[s]
+            ? vk_to_pvr_descriptor_set_layout(layout->set_layouts[s])
+            : NULL;
+      const uint32_t present = !!set_layout;
+
+      PVR_HASH(ctx, present);
+      if (!set_layout)
+         continue;
+
+      PVR_HASH(ctx, set_layout->flags);
+      PVR_HASH(ctx, set_layout->descriptor_count);
+      PVR_HASH(ctx, set_layout->dynamic_buffer_count);
+      PVR_HASH(ctx, set_layout->binding_count);
+      PVR_HASH(ctx, set_layout->stage_flags);
+      PVR_HASH(ctx, set_layout->size);
+
+      for (unsigned b = 0; b < set_layout->binding_count; ++b) {
+         const struct pvr_descriptor_set_layout_binding *binding =
+            &set_layout->bindings[b];
+
+         PVR_HASH(ctx, binding->type);
+         PVR_HASH(ctx, binding->flags);
+         PVR_HASH(ctx, binding->stage_flags);
+         PVR_HASH(ctx, binding->descriptor_count);
+         PVR_HASH(ctx, binding->immutable_sampler_count);
+         PVR_HASH(ctx, binding->offset);
+         PVR_HASH(ctx, binding->dynamic_buffer_idx);
+         PVR_HASH(ctx, binding->stride);
+
+         /* The compiler reads immutable samplers only for YCbCr
+          * conversions (lookup_ycbcr_conversion()).
+          */
+         for (unsigned i = 0; i < binding->immutable_sampler_count; ++i) {
+            const struct pvr_sampler *sampler =
+               binding->immutable_samplers ? binding->immutable_samplers[i]
+                                           : NULL;
+            const uint32_t has_ycbcr =
+               sampler && sampler->vk.ycbcr_conversion;
+
+            PVR_HASH(ctx, has_ycbcr);
+            if (has_ycbcr)
+               PVR_HASH(ctx, sampler->vk.ycbcr_conversion->state);
+         }
+      }
+   }
+
+   PVR_HASH(ctx, layout->push_range_count);
+   for (unsigned u = 0; u < layout->push_range_count; ++u)
+      PVR_HASH(ctx, layout->push_ranges[u]);
+}
+
+static void pvr_hash_stage(blake3_hasher *ctx,
+                           VkPipelineCreateFlags2KHR flags,
+                           const VkPipelineShaderStageCreateInfo *stage_info)
+{
+   unsigned char stage_hash[BLAKE3_OUT_LEN];
+   const uint32_t stage = stage_info->stage;
+
+   vk_pipeline_hash_shader_stage(flags, stage_info, NULL, stage_hash);
+   PVR_HASH(ctx, stage);
+   PVR_HASH(ctx, stage_hash);
+}
+
+/* Everything pvr_graphics_pipeline_compile_shaders() reads. Only for
+ * pipelines without a VkRenderPass.
+ */
 static void
-pvr_compute_state_save(struct pvr_compute_pipeline *compute_pipeline,
-                       pco_shader *cs)
+pvr_graphics_pipeline_hash(const struct pvr_device *device,
+                           const VkGraphicsPipelineCreateInfo *pCreateInfo,
+                           const struct pvr_graphics_pipeline *gfx_pipeline,
+                           const struct vk_graphics_pipeline_state *state,
+                           uint8_t key_out[BLAKE3_OUT_LEN])
 {
-   const pco_data *shader_data = pco_shader_data(cs);
-   memcpy(&compute_pipeline->cs_data, shader_data, sizeof(*shader_data));
+   static const char tag[] = "pvr-graphics-pipeline";
+   const VkPipelineCreateFlags2KHR flags = gfx_pipeline->base.pipeline_flags;
+   const struct vk_render_pass_state *rp = state->rp;
+   const struct vk_color_blend_state *cb = state->cb;
+   const struct vk_multisample_state *ms = state->ms;
+   const VkPipelineRenderingCreateInfo *ri =
+      vk_find_struct_const(pCreateInfo->pNext, PIPELINE_RENDERING_CREATE_INFO);
+   const uint32_t view_mask = ri ? ri->viewMask : 0;
+   blake3_hasher ctx;
+
+   assert(!pCreateInfo->renderPass);
+
+   _mesa_blake3_init(&ctx);
+   _mesa_blake3_update(&ctx, tag, sizeof(tag));
+   pvr_hash_device_features(&ctx, device);
+   PVR_HASH(&ctx, flags);
+
+   for (mesa_shader_stage stage = 0; stage < MESA_SHADER_STAGES; ++stage) {
+      const size_t stage_index = gfx_pipeline->stage_indices[stage];
+
+      if (stage_index == ~0)
+         continue;
+
+      pvr_hash_stage(&ctx, flags, &pCreateInfo->pStages[stage_index]);
+   }
+
+   pvr_hash_pipeline_layout(&ctx, gfx_pipeline->base.layout);
+
+   /* Vertex attribute formats (pvr_init_vs_attribs()). */
+   {
+      const VkPipelineVertexInputStateCreateInfo *vi =
+         pCreateInfo->pVertexInputState;
+      const uint32_t count = vi ? vi->vertexAttributeDescriptionCount : 0;
+
+      PVR_HASH(&ctx, count);
+      for (uint32_t u = 0; u < count; ++u) {
+         PVR_HASH(&ctx, vi->pVertexAttributeDescriptions[u].location);
+         PVR_HASH(&ctx, vi->pVertexAttributeDescriptions[u].format);
+      }
+   }
+
+   /* Attachments and multiview (MRT setup, fragment outputs). */
+   PVR_HASH(&ctx, view_mask);
+   PVR_HASH(&ctx, rp->attachments);
+   PVR_HASH(&ctx, rp->color_attachment_count);
+   for (uint32_t u = 0; u < rp->color_attachment_count; ++u)
+      PVR_HASH(&ctx, rp->color_attachment_formats[u]);
+   PVR_HASH(&ctx, rp->depth_attachment_format);
+   PVR_HASH(&ctx, rp->stencil_attachment_format);
+
+   /* Blending (pvr_init_fs_blend()) and colour write enables. */
+   {
+      const uint32_t has_cb = !!cb;
+
+      PVR_HASH(&ctx, has_cb);
+      if (cb) {
