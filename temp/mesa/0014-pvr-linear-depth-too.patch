From 10476efd7894d1c98f3897ee7b1bf10a00d8f897 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Tue, 10 Nov 2026 00:01:33 -0600
Subject: [PATCH] LOCAL: pvr: linear layout also for depth/stencil, at 10%
 padding waste

Local patch for amazon-sheldonp; not to be sent. With 24-bit depth
hidden on format v1, QtQuick's 1080p depth/stencil buffer is D32S8 and,
twiddled, padded to 2048x2048: 32 MiB per window. 1920x1920 colour
images (14% padding) also stayed twiddled.

Assisted-by: LLM
Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_image.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/imagination/vulkan/pvr_image.c b/src/imagination/vulkan/pvr_image.c
index c993f0b08c4..6c1cd5495f0 100644
--- a/src/imagination/vulkan/pvr_image.c
+++ b/src/imagination/vulkan/pvr_image.c
@@ -52,8 +52,8 @@
 /* LOCAL: twiddled images are padded to power-of-two dimensions, so a
  * 1920x1080 render target takes 2048x2048. On the 844 MiB Fire TV Stick,
  * where every GPU buffer is pinned, that ran the desktop out of memory.
- * Keep single-level 2D colour images linear when padding would waste more
- * than a quarter of the memory (PVR_TWIDDLE_ALL=1 disables this).
+ * Keep single-level 2D images linear when padding would waste more than a
+ * tenth of the memory (PVR_TWIDDLE_ALL=1 disables this).
  */
 static bool pvr_image_prefer_linear(const struct pvr_image *image)
 {
@@ -65,7 +65,6 @@ static bool pvr_image_prefer_linear(const struct pvr_image *image)
 
    if (image->vk.image_type != VK_IMAGE_TYPE_2D || image->vk.mip_levels > 1 ||
        image->vk.array_layers > 1 || image->vk.samples > 1 ||
-       !vk_format_is_color(image->vk.format) ||
        vk_format_is_compressed(image->vk.format))
       return false;
 
@@ -73,7 +72,8 @@ static bool pvr_image_prefer_linear(const struct pvr_image *image)
    padded = (uint64_t)util_next_power_of_two(e->width) *
             util_next_power_of_two(e->height);
 
-   return size >= 256 * 256 && padded * 4 > size * 5;
+   /* Depth/stencil included: QtQuick's 1080p D32S8 buffer took 32 MiB. */
+   return size >= 256 * 256 && padded * 10 > size * 11;
 }
 
 static void pvr_image_init_memlayout(struct pvr_image *image)
-- 
