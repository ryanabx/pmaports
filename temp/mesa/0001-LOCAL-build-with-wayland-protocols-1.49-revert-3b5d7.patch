From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Tue, 17 Nov 2026 13:47:43 -0600
Subject: [PATCH 01/58] LOCAL: build with wayland-protocols 1.49 (revert
 3b5d7f1f188)

Alpine edge has wayland-protocols 1.49 (11-17) and Mesa main requires
1.50 since 3b5d7f1f188, which only dropped the version check for the
presentation protocol. Restore it until Alpine has 1.50; nothing changes
when building against 1.50.

Generated-by: LLM
(cherry picked from commit 0cf79de227e16e61a9c62b21cbc9e11130e598b1)
---
 meson.build                         |  2 +-
 src/vulkan/wsi/wsi_common_wayland.c | 13 +++++++++++--
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/meson.build b/meson.build
index 56c13e02c90..68e56faa871 100644
--- a/meson.build
+++ b/meson.build
@@ -2282,7 +2282,7 @@ endif
 
 with_wayland_bind_display = with_platform_wayland and get_option('legacy-wayland').contains('bind-wayland-display')
 if with_platform_wayland
-  dep_wl_protocols = dependency('wayland-protocols', version : '>= 1.50', default_options: [ 'tests=false' ])
+  dep_wl_protocols = dependency('wayland-protocols', version : '>= 1.49', default_options: [ 'tests=false' ])
   dep_wayland_client = dependency('wayland-client', version : '>=1.18')
   dep_wayland_server = dependency('wayland-server', version : '>=1.18')
   if with_egl
diff --git a/src/vulkan/wsi/wsi_common_wayland.c b/src/vulkan/wsi/wsi_common_wayland.c
index e38e282631b..738673c5957 100644
--- a/src/vulkan/wsi/wsi_common_wayland.c
+++ b/src/vulkan/wsi/wsi_common_wayland.c
@@ -1497,6 +1497,12 @@ static const struct wp_presentation_listener presentation_listener = {
 #define MESA_WL_FIXES_VERSION 1
 #endif
 
+#if defined(WP_PRESENTATION_FEEDBACK_KIND_FIXED_RATE_SINCE_VERSION)
+#define MESA_WP_PRESENTATION_VERSION 3
+#else
+#define MESA_WP_PRESENTATION_VERSION 2
+#endif
+
 static void
 registry_handle_global(void *data, struct wl_registry *registry,
                        uint32_t name, const char *interface, uint32_t version)
@@ -1529,7 +1535,7 @@ registry_handle_global(void *data, struct wl_registry *registry,
    if (strcmp(interface, wp_presentation_interface.name) == 0) {
       display->wp_presentation_notwrapped =
          wl_registry_bind(registry, name, &wp_presentation_interface,
-                          MIN2(version, WP_PRESENTATION_FEEDBACK_KIND_FIXED_RATE_SINCE_VERSION));
+                          MIN2(version, MESA_WP_PRESENTATION_VERSION));
       wp_presentation_add_listener(display->wp_presentation_notwrapped, &presentation_listener, display);
    } else if (strcmp(interface, wp_tearing_control_manager_v1_interface.name) == 0) {
       display->tearing_control_manager =
@@ -3113,6 +3119,7 @@ presentation_handle_presented(void *data,
    struct wsi_wl_swapchain *chain = id->chain;
    uint64_t target_time = id->target_time;
 
+#if MESA_WP_PRESENTATION_VERSION >= 3
    if (wp_presentation_get_version(chain->wsi_wl_surface->display->wp_presentation_notwrapped) >= 3) {
       if (flags & WP_PRESENTATION_FEEDBACK_KIND_FIXED_RATE) {
          wsi_swapchain_present_timing_update_refresh_rate(&chain->base, refresh, refresh, 1000);
@@ -3122,7 +3129,9 @@ presentation_handle_presented(void *data,
          /* Just report Unknown if compositor doesn't tell us what kind of refresh rate we're running at. */
          wsi_swapchain_present_timing_update_refresh_rate(&chain->base, refresh, 0, 0);
       }
-   } else {
+   } else
+#endif
+   {
       /* Prior to v3 of presentation time, we can't know if we're running VRR
        * or FRR so just report "Unknown" instead. */
       wsi_swapchain_present_timing_update_refresh_rate(&chain->base, refresh, 0, 0);
