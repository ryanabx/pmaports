From dc27c549bfaaa18dc65325b345a23dd9090933f7 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Wed, 11 Nov 2026 15:32:05 -0600
Subject: [PATCH 1/2] LOCAL: pvr: cache 4 KiB control-stream buffers across
 command buffers (PVR_NO_CSB_CACHE=1 disables)

Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 src/imagination/vulkan/pvr_arch_csb.c    |  8 +--
 src/imagination/vulkan/pvr_arch_device.c |  5 ++
 src/imagination/vulkan/pvr_csb.c         | 63 +++++++++++++++++++++++-
 src/imagination/vulkan/pvr_csb.h         | 10 ++++
 src/imagination/vulkan/pvr_device.h      |  5 ++
 5 files changed, 84 insertions(+), 7 deletions(-)

diff --git a/src/imagination/vulkan/pvr_arch_csb.c b/src/imagination/vulkan/pvr_arch_csb.c
index 66edec7622b..9ae47d7b3d3 100644
--- a/src/imagination/vulkan/pvr_arch_csb.c
+++ b/src/imagination/vulkan/pvr_arch_csb.c
@@ -121,12 +121,8 @@ static bool pvr_csb_buffer_extend(struct pvr_csb *csb)
    STATIC_ASSERT(ROGUE_VDMCTRL_GUARD_SIZE_DEFAULT ==
                  ROGUE_CDMCTRL_GUARD_SIZE_DEFAULT);
 
-   result = pvr_bo_alloc(csb->device,
-                         csb->device->heaps.general_heap,
-                         PVR_CMD_BUFFER_CSB_BO_SIZE,
-                         cache_line_size,
-                         PVR_BO_ALLOC_FLAG_CPU_MAPPED,
-                         &pvr_bo);
+   (void)cache_line_size;
+   result = pvr_csb_bo_get(csb->device, &pvr_bo);
    if (result != VK_SUCCESS) {
       vk_error(csb->device, result);
       csb->status = result;
diff --git a/src/imagination/vulkan/pvr_arch_device.c b/src/imagination/vulkan/pvr_arch_device.c
index 9c5cbec970b..82bfc07704c 100644
--- a/src/imagination/vulkan/pvr_arch_device.c
+++ b/src/imagination/vulkan/pvr_arch_device.c
@@ -31,6 +31,7 @@
 #include "pvr_query.h"
 #include "pvr_queue.h"
 #include "pvr_robustness.h"
+#include "pvr_csb.h"
 #include "pvr_rt_dataset.h"
 #include "pvr_tex_state.h"
 #include "pvr_utrace.h"
@@ -972,6 +973,9 @@ VkResult PVR_PER_ARCH(create_device)(struct pvr_physical_device *pdevice,
 
    simple_mtx_init(&device->rs_mtx, mtx_plain);
    list_inithead(&device->render_states);
+   simple_mtx_init(&device->csb_bo_mtx, mtx_plain);
+   list_inithead(&device->csb_bo_cache);
+   device->csb_bo_count = 0;
    simple_mtx_init(&device->rt_pool_mtx, mtx_plain);
    list_inithead(&device->rt_pool);
    device->rt_pool_count = 0;
@@ -1079,6 +1083,7 @@ void PVR_PER_ARCH(destroy_device)(struct pvr_device *device,
    pvr_spm_finish_scratch_buffer_store(device);
    pvr_arch_queues_destroy(device);
    pvr_device_finish_tile_buffer_state(device);
+   pvr_csb_bo_cache_finish(device);
    pvr_arch_device_finish_spm_load_state(device);
    pvr_device_finish_graphics_static_clear_state(device);
    pvr_device_finish_compute_idfwdf_state(device);
diff --git a/src/imagination/vulkan/pvr_csb.c b/src/imagination/vulkan/pvr_csb.c
index deaae4f3c71..09711c541f4 100644
--- a/src/imagination/vulkan/pvr_csb.c
+++ b/src/imagination/vulkan/pvr_csb.c
@@ -44,6 +44,7 @@
 #include "pvr_physical_device.h"
 #include "pvr_types.h"
 #include "util/list.h"
+#include "util/u_debug.h"
 #include "util/u_dynarray.h"
 #include "vk_log.h"
 
@@ -98,6 +99,66 @@ void pvr_csb_init(struct pvr_device *device,
       list_inithead(&csb->pvr_bo_list);
 }
 
+#define PVR_CSB_BO_CACHE_MAX 64
+
+VkResult pvr_csb_bo_get(struct pvr_device *device, struct pvr_bo **pvr_bo_out)
+{
+   struct pvr_bo *pvr_bo = NULL;
+
+   simple_mtx_lock(&device->csb_bo_mtx);
+   if (!list_is_empty(&device->csb_bo_cache)) {
+      pvr_bo = list_first_entry(&device->csb_bo_cache, struct pvr_bo, link);
+      list_del(&pvr_bo->link);
+      device->csb_bo_count--;
+   }
+   simple_mtx_unlock(&device->csb_bo_mtx);
+
+   if (pvr_bo) {
+      /* As a newly created buffer is. */
+      memset(pvr_bo->bo->map, 0, pvr_bo->bo->size);
+      *pvr_bo_out = pvr_bo;
+      return VK_SUCCESS;
+   }
+
+   return pvr_bo_alloc(device,
+                       device->heaps.general_heap,
+                       PVR_CMD_BUFFER_CSB_BO_SIZE,
+                       pvr_get_slc_cache_line_size(&device->pdevice->dev_info),
+                       PVR_BO_ALLOC_FLAG_CPU_MAPPED,
+                       pvr_bo_out);
+}
+
+void pvr_csb_bo_put(struct pvr_device *device, struct pvr_bo *pvr_bo)
+{
+   bool cached = false;
+
+   if (pvr_bo->bo->size == PVR_CMD_BUFFER_CSB_BO_SIZE && pvr_bo->bo->map &&
+       !debug_get_bool_option("PVR_NO_CSB_CACHE", false)) {
+      simple_mtx_lock(&device->csb_bo_mtx);
+      if (device->csb_bo_count < PVR_CSB_BO_CACHE_MAX) {
+         list_add(&pvr_bo->link, &device->csb_bo_cache);
+         device->csb_bo_count++;
+         cached = true;
+      }
+      simple_mtx_unlock(&device->csb_bo_mtx);
+   }
+
+   if (!cached)
+      pvr_bo_free(device, pvr_bo);
+}
+
+void pvr_csb_bo_cache_finish(struct pvr_device *device)
+{
+   simple_mtx_lock(&device->csb_bo_mtx);
+   list_for_each_entry_safe (struct pvr_bo, pvr_bo, &device->csb_bo_cache, link) {
+      list_del(&pvr_bo->link);
+      pvr_bo_free(device, pvr_bo);
+   }
+   device->csb_bo_count = 0;
+   simple_mtx_unlock(&device->csb_bo_mtx);
+   simple_mtx_destroy(&device->csb_bo_mtx);
+}
+
 /**
  * \brief Frees the resources associated with the csb object.
  *
@@ -118,7 +179,7 @@ void pvr_csb_finish(struct pvr_csb *csb)
    } else {
       list_for_each_entry_safe (struct pvr_bo, pvr_bo, &csb->pvr_bo_list, link) {
          list_del(&pvr_bo->link);
-         pvr_bo_free(csb->device, pvr_bo);
+         pvr_csb_bo_put(csb->device, pvr_bo);
       }
    }
 
diff --git a/src/imagination/vulkan/pvr_csb.h b/src/imagination/vulkan/pvr_csb.h
index 07a49dfd6ff..f6b0955964b 100644
--- a/src/imagination/vulkan/pvr_csb.h
+++ b/src/imagination/vulkan/pvr_csb.h
@@ -68,6 +68,16 @@
  */
 #define PVR_CMD_BUFFER_CSB_BO_SIZE 4096
 
+/* LOCAL: a device-level cache of PVR_CMD_BUFFER_CSB_BO_SIZE control-stream
+ * buffers. A command buffer used to create (GEM create, VM map) and free
+ * (VM unmap, GEM close) its stream buffers on every record and reset, each
+ * VM change costing a firmware MMU flush; zink records new ones every frame.
+ */
+struct pvr_bo;
+VkResult pvr_csb_bo_get(struct pvr_device *device, struct pvr_bo **pvr_bo_out);
+void pvr_csb_bo_put(struct pvr_device *device, struct pvr_bo *pvr_bo);
+void pvr_csb_bo_cache_finish(struct pvr_device *device);
+
 struct pvr_device;
 
 enum pvr_cmd_stream_type {
diff --git a/src/imagination/vulkan/pvr_device.h b/src/imagination/vulkan/pvr_device.h
index fce2f226160..39e5c926c7a 100644
--- a/src/imagination/vulkan/pvr_device.h
+++ b/src/imagination/vulkan/pvr_device.h
@@ -170,6 +170,11 @@ struct pvr_device {
    simple_mtx_t rs_mtx;
    struct list_head render_states;
 
+   /* LOCAL: freed 4 KiB control-stream buffers for reuse (pvr_csb). */
+   simple_mtx_t csb_bo_mtx;
+   struct list_head csb_bo_cache;
+   uint32_t csb_bo_count;
+
    /* LOCAL: unused RT datasets for reuse (pvr_rt_dataset_pool_get()). */
    simple_mtx_t rt_pool_mtx;
    struct list_head rt_pool;
-- 
2.56.0


