 G_END_DECLS
 
diff --git a/sys/v4l2/meson.build b/sys/v4l2/meson.build
index 2d6cbb3451..c9384ac5e3 100644
--- a/sys/v4l2/meson.build
+++ b/sys/v4l2/meson.build
@@ -12,6 +12,7 @@ v4l2_sources = [
   'gstv4l2radio.c',
   'gstv4l2tuner.c',
   'gstv4l2transform.c',
+  'gstv4l2convdec.c',
   'gstv4l2videodec.c',
